@page "/clientes-refatorado"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Models.DTOs
@using GestaoPiscina.Client.Shared
@implements IDisposable
@inject ApiService ApiService
@inject ClienteStateService StateService
@inject IJSRuntime JSRuntime
@inherits ComponentBase

<section class="p-4 space-y-6">
    <!-- Tela: Lista de Clientes -->
    <div class="space-y-4">
        <div class="mb-4">
            <button @onclick="ShowCreateView" class="bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas fa-plus mr-2"></i>Novo Cliente
            </button>
        </div>

        <div class="flex justify-between items-center mb-4">
            <div class="flex space-x-2">
                <input type="text" @bind="StateService.SearchTerm" @bind:event="oninput" placeholder="Buscar clientes..." class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                <select @bind="StateService.SelectedType" class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                    <option value="">Todos os Tipos</option>
                    <option value="Residencial Privativa">Residencial Privativa</option>
                    <option value="Uso Coletivo">Uso Coletivo</option>
                </select>
            </div>
            
            <div class="flex space-x-2">
                <button @onclick="SetListView" 
                        class="@GetListViewButtonClass()"
                        title="Lista">
                    <i class="fas fa-list"></i>
                </button>
                <button @onclick="SetCardsView" 
                        class="@GetCardsViewButtonClass()"
                        title="Cards">
                    <i class="fas fa-th-large"></i>
                </button>
            </div>
        </div>

        @if (clientes == null)
        {
            <div class="flex justify-center items-center h-32">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-cyan-500"></div>
            </div>
        }
        else
        {
            @if (StateService.ViewMode == "lista")
            {
                <ClienteLista Clientes="filteredClientes.ToList()" OnEdit="ShowEditView" OnDelete="DeleteCliente" />
            }
            else if (StateService.ViewMode == "cards")
            {
                <ClienteCards Clientes="filteredClientes.ToList()" OnEdit="ShowEditView" OnDelete="DeleteCliente" />
            }
        }
    </div>

    <!-- Modal de Cadastro de Cliente -->
    <ClienteCadastroModal 
        @bind-IsVisible="showCadastroModal"
        OnClose="HandleModalClose"
        OnSave="HandleModalSave" />

    <LoadingSpinner IsVisible="isLoading" Message="Salvando..." />
    <ConfirmDialog @bind-IsVisible="showConfirmDialog" 
                   Title="Confirmar Exclusão" 
                   Message="Tem certeza que deseja excluir este item?"
                   OnConfirm="@(async () => await ConfirmDeleteAsync())" />
</section>

@code {
    [CascadingParameter] public MainLayout? MainLayout { get; set; }
    private List<Cliente>? clientes;
    private bool isLoading = false;
    private bool showConfirmDialog = false;
    private bool showCadastroModal = false;
    private object? itemToDelete = null;

    private IEnumerable<Cliente> filteredClientes => clientes?.Where(c => 
        (string.IsNullOrEmpty(StateService.SearchTerm) || c.Nome.ToLower().Contains(StateService.SearchTerm.ToLower())) &&
        (string.IsNullOrEmpty(StateService.SelectedType) || c.Tipo == StateService.SelectedType)
    ) ?? new List<Cliente>();

    protected override async Task OnInitializedAsync()
    {
        await LoadClientes();
        StateService.StateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        StateService.StateChanged -= StateHasChanged;
    }

    // Métodos de carregamento de dados
    private async Task LoadClientes()
    {
        try
        {
            clientes = await ApiService.GetClientesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar clientes: {ex.Message}");
            clientes = new List<Cliente>();
        }
    }





    // Métodos de navegação
    private void ShowCreateView()
    {
        StateService.ClearState();
        showCadastroModal = true;
    }

    private void ShowEditView(Cliente cliente)
    {
        StateService.CurrentCliente = new Cliente
        {
            IDCliente = cliente.IDCliente,
            Nome = cliente.Nome,
            Tipo = cliente.Tipo,
            Telefone = cliente.Telefone,
            Email = cliente.Email,
            Endereco = cliente.Endereco,
            Observacoes = cliente.Observacoes
        };
        StateService.ActiveTab = "dados";
        
        showCadastroModal = true;
    }

    private void HandleModalClose()
    {
        showCadastroModal = false;
        StateService.ClearState();
    }

    private async Task HandleModalSave()
    {
        await LoadClientes();
        showCadastroModal = false;
        StateService.ClearState();
    }

    private void ClearForm()
    {
        StateService.ClearState();
    }

    // Métodos de controle de visualização
    private void SetListView() => StateService.ViewMode = "lista";
    private void SetCardsView() => StateService.ViewMode = "cards";

    private string GetListViewButtonClass() =>
        StateService.ViewMode == "lista" 
            ? "px-3 py-2 rounded-lg transition-colors bg-cyan-600 text-white" 
            : "px-3 py-2 rounded-lg transition-colors bg-slate-700 text-slate-300 hover:bg-slate-600";

    private string GetCardsViewButtonClass() =>
        StateService.ViewMode == "cards" 
            ? "px-3 py-2 rounded-lg transition-colors bg-cyan-600 text-white" 
            : "px-3 py-2 rounded-lg transition-colors bg-slate-700 text-slate-300 hover:bg-slate-600";





    // Métodos gerais
    private void DeleteCliente(Cliente cliente)
    {
        itemToDelete = cliente;
        showConfirmDialog = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (itemToDelete != null)
        {
            isLoading = true;
            try
            {
                if (itemToDelete is Cliente cliente)
                {
                    await ApiService.DeleteClienteAsync(cliente.IDCliente);
                    await LoadClientes();
                    ShowToast("Sucesso", "Cliente excluído com sucesso!", "success");
                }
            }
            catch (Exception ex)
            {
                ShowToast("Erro", $"Erro ao excluir item: {ex.Message}", "error");
            }
            finally
            {
                isLoading = false;
                itemToDelete = null;
            }
        }
    }

    private void ShowToast(string title, string message, string type)
    {
        if (MainLayout != null)
        {
            MainLayout.ShowToast(title, message, type);
        }
    }
}