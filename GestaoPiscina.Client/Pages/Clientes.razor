    private async Task HandleSaveCompleto()
    {
        isLoading = true;
        try
        {
            // Validar dados do cliente
            if (string.IsNullOrWhiteSpace(currentCliente.Nome))
            {
                ShowToast("Erro", "Nome do cliente é obrigatório", "error");
                return;
            }

            if (string.IsNullOrWhiteSpace(currentCliente.Tipo))
            {
                ShowToast("Erro", "Tipo do cliente é obrigatório", "error");
                return;
            }

            if (string.IsNullOrWhiteSpace(currentCliente.Endereco))
            {
                ShowToast("Erro", "Endereço do cliente é obrigatório", "error");
                return;
            }

            // Criar DTO com todos os dados
            var clienteCompleto = new ClienteCompletoDTO
            {
                IDCliente = currentCliente.IDCliente,
                Nome = currentCliente.Nome,
                Tipo = currentCliente.Tipo,
                Telefone = currentCliente.Telefone,
                Email = currentCliente.Email,
                Endereco = currentCliente.Endereco,
                DiasDeVisita = currentCliente.DiasDeVisita,
                Observacoes = currentCliente.Observacoes,
                Piscinas = new List<PiscinaDTO>(),
                Equipamentos = new List<EquipamentoDTO>(),
                Estoques = new List<EstoqueClienteDTO>()
            };

            // Adicionar piscinas (incluindo temporárias)
            if (piscinas != null)
            {
                foreach (var piscina in piscinas)
                {
                    clienteCompleto.Piscinas.Add(new PiscinaDTO
                    {
                        IDPiscina = piscina.IDPiscina,
                        IDCliente = piscina.IDCliente,
                        Tipo = piscina.Tipo,
                        VolumeLitros = piscina.VolumeLitros,
                        Localizacao = piscina.Localizacao
                    });
                }
            }
            
            // Adicionar piscinas temporárias
            foreach (var piscina in piscinasTemporarias)
            {
                clienteCompleto.Piscinas.Add(new PiscinaDTO
                {
                    IDPiscina = 0, // Nova piscina
                    IDCliente = 0, // Será definido pelo servidor
                    Tipo = piscina.Tipo,
                    VolumeLitros = piscina.VolumeLitros,
                    Localizacao = piscina.Localizacao
                });
            }

            // Adicionar equipamentos (incluindo temporários)
            if (equipamentos != null)
            {
                foreach (var equipamento in equipamentos)
                {
                    clienteCompleto.Equipamentos.Add(new EquipamentoDTO
                    {
                        IDEquipamento = equipamento.IDEquipamento,
                        IDCliente = equipamento.IDCliente,
                        Tipo = equipamento.Tipo,
                        NumeroSerie = equipamento.NumeroSerie,
                        UltimaCalibragem = equipamento.UltimaCalibragem,
                        Observacao = equipamento.Observacao
                    });
                }
            }
            
            // Adicionar equipamentos temporários
            foreach (var equipamento in equipamentosTemporarios)
            {
                clienteCompleto.Equipamentos.Add(new EquipamentoDTO
                {
                    IDEquipamento = 0, // Novo equipamento
                    IDCliente = 0, // Será definido pelo servidor
                    Tipo = equipamento.Tipo,
                    NumeroSerie = equipamento.NumeroSerie,
                    UltimaCalibragem = equipamento.UltimaCalibragem,
                    Observacao = equipamento.Observacao
                });
            }

            // Adicionar estoques (incluindo temporários)
            if (estoques != null)
            {
                foreach (var estoque in estoques)
                {
                    clienteCompleto.Estoques.Add(new EstoqueClienteDTO
                    {
                        IDEstoque = estoque.IDEstoque,
                        IDCliente = estoque.IDCliente,
                        IDProduto = estoque.IDProduto,
                        QuantidadeAtual = estoque.QuantidadeAtual,
                        QuantidadeMinima = estoque.QuantidadeMinima,
                        NomeProduto = estoque.Produto.Nome,
                        ConcentracaoProduto = estoque.Produto.Concentracao,
                        UnidadeProduto = estoque.Produto.Unidade
                    });
                }
            }
            
            // Adicionar estoques temporários
            foreach (var estoque in estoquesTemporarios)
            {
                // Validações para garantir que os dados estão corretos
                if (string.IsNullOrWhiteSpace(estoque.Produto?.Nome))
                {
                    ShowToast("Erro", "Nome do produto é obrigatório", "error");
                    return;
                }

                if (string.IsNullOrWhiteSpace(estoque.Produto?.Unidade))
                {
                    ShowToast("Erro", "Unidade do produto é obrigatória", "error");
                    return;
                }

                clienteCompleto.Estoques.Add(new EstoqueClienteDTO
                {
                    IDEstoque = 0, // Novo estoque
                    IDCliente = 0, // Será definido pelo servidor
                    IDProduto = 0, // Novo produto
                    QuantidadeAtual = estoque.QuantidadeAtual,
                    QuantidadeMinima = estoque.QuantidadeMinima,
                    NomeProduto = estoque.Produto.Nome.Trim(),
                    ConcentracaoProduto = !string.IsNullOrWhiteSpace(estoque.Produto.Concentracao) 
                        ? estoque.Produto.Concentracao.Trim() 
                        : null,
                    UnidadeProduto = estoque.Produto.Unidade.Trim()
                });
            }

            // Validações finais antes de enviar
            if (string.IsNullOrWhiteSpace(clienteCompleto.Nome))
            {
                ShowToast("Erro", "Nome do cliente é obrigatório", "error");
                return;
            }

            if (string.IsNullOrWhiteSpace(clienteCompleto.Tipo))
            {
                ShowToast("Erro", "Tipo do cliente é obrigatório", "error");
                return;
            }

            if (string.IsNullOrWhiteSpace(clienteCompleto.Endereco))
            {
                ShowToast("Erro", "Endereço do cliente é obrigatório", "error");
                return;
            }

            // Salvar tudo em uma transação
            var clienteSalvo = await ApiService.CreateClienteCompletoAsync(clienteCompleto);
            
            ShowToast("Sucesso", "Cliente e todos os dados relacionados foram salvos com sucesso em uma única transação!", "success");
            
            // Atualizar o cliente atual com os dados retornados
            currentCliente = clienteSalvo;
            
            // Recarregar dados
            await LoadClientes();
            await LoadRelatedData();
            
            // Limpar listas temporárias
            piscinasTemporarias.Clear();
            equipamentosTemporarios.Clear();
            estoquesTemporarios.Clear();
            
            // Voltar para a lista
            ShowListView();
        }
        catch (Exception ex)
        {
            // Log detalhado do erro para debug
            Console.WriteLine($"Erro ao salvar dados completos: {ex.Message}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"Inner Exception: {ex.InnerException.Message}");
            }
            
            ShowToast("Erro", $"Erro ao salvar dados completos: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadProdutos()
    {
        try
        {
            produtos = await ApiService.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar produtos: {ex.Message}");
            produtos = new List<Produto>();
        }
    }

    private void OnProdutoSelected(ChangeEventArgs e)
    {
        try
        {
            if (e.Value != null && int.TryParse(e.Value.ToString(), out int produtoId))
            {
                if (produtoId > 0)
                {
                    selectedProdutoId = produtoId;
                    var produtoSelecionado = produtos?.FirstOrDefault(p => p.IDProduto == produtoId);
                    if (produtoSelecionado != null)
                    {
                        currentEstoque.Produto = new Produto
                        {
                            IDProduto = produtoSelecionado.IDProduto,
                            Nome = produtoSelecionado.Nome,
                            Concentracao = produtoSelecionado.Concentracao,
                            Unidade = produtoSelecionado.Unidade
                        };
                        currentEstoque.IDProduto = produtoSelecionado.IDProduto;
                    }
                }
                else
                {
                    selectedProdutoId = 0;
                    currentEstoque.Produto = new Produto();
                    currentEstoque.IDProduto = 0;
                }
            }
            else
            {
                selectedProdutoId = 0;
                currentEstoque.Produto = new Produto();
                currentEstoque.IDProduto = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao selecionar produto: {ex.Message}");
            selectedProdutoId = 0;
            currentEstoque.Produto = new Produto();
            currentEstoque.IDProduto = 0;
        }
        
        StateHasChanged();
    }
} 