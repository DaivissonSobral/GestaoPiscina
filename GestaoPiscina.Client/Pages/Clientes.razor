    private async Task HandleSaveEstoque()
    {
        isLoading = true;
        try
        {
            // Validações básicas
            if (currentEstoque.IDCliente <= 0)
            {
                currentEstoque.IDCliente = currentCliente.IDCliente;
            }

            // Validações adicionais
            if (selectedProdutoId <= 0)
            {
                ShowToast("Erro", "Selecione um produto", "error");
                return;
            }

            if (currentEstoque.QuantidadeAtual < 0)
            {
                ShowToast("Erro", "Quantidade atual deve ser maior ou igual a zero", "error");
                return;
            }

            // Garantir que o produto está correto
            var produtoSelecionado = produtos?.FirstOrDefault(p => p.IDProduto == selectedProdutoId);
            if (produtoSelecionado != null)
            {
                currentEstoque.Produto = new Produto
                {
                    IDProduto = produtoSelecionado.IDProduto,
                    Nome = produtoSelecionado.Nome,
                    Concentracao = produtoSelecionado.Concentracao,
                    Unidade = produtoSelecionado.Unidade
                };
                currentEstoque.IDProduto = produtoSelecionado.IDProduto;
            }
            else
            {
                ShowToast("Erro", "Produto selecionado não encontrado", "error");
                return;
            }

            // Validações adicionais para o produto
            if (string.IsNullOrWhiteSpace(currentEstoque.Produto?.Nome))
            {
                ShowToast("Erro", "Nome do produto é obrigatório", "error");
                return;
            }

            if (string.IsNullOrWhiteSpace(currentEstoque.Produto?.Unidade))
            {
                ShowToast("Erro", "Unidade do produto é obrigatória", "error");
                return;
            }

            // SEMPRE adicionar à lista temporária se o cliente não foi salvo via "Salvar Tudo"
            // ou se há estoques temporários (indicando que estamos no modo transação única)
            if (currentCliente.IDCliente <= 0 || estoquesTemporarios.Any())
            {
                estoquesTemporarios.Add(new EstoqueCliente
                {
                    IDEstoque = -(estoquesTemporarios.Count + 1), // ID negativo para identificar como temporário
                    IDCliente = 0,
                    IDProduto = currentEstoque.IDProduto,
                    QuantidadeAtual = currentEstoque.QuantidadeAtual,
                    QuantidadeMinima = currentEstoque.QuantidadeMinima,
                    Produto = new Produto
                    {
                        IDProduto = currentEstoque.IDProduto,
                        Nome = currentEstoque.Produto.Nome,
                        Concentracao = currentEstoque.Produto.Concentracao,
                        Unidade = currentEstoque.Produto.Unidade
                    }
                });
                
                ShowToast("Sucesso", "Item do estoque adicionado temporariamente. Use 'Salvar Tudo' para confirmar.", "success");
                CloseEstoqueForm();
                StateHasChanged();
                return;
            }

            // Se o cliente já foi salvo E não há estoques temporários, salvar normalmente
            if (currentEstoque.IDEstoque > 0)
            {
                await ApiService.UpdateEstoqueAsync(currentEstoque);
                ShowToast("Sucesso", "Item do estoque atualizado com sucesso!", "success");
            }
            else
            {
                await ApiService.CreateEstoqueAsync(currentEstoque);
                ShowToast("Sucesso", "Item do estoque criado com sucesso!", "success");
            }
            
            // Recarregar dados relacionados
            await LoadRelatedData();
            CloseEstoqueForm();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao salvar item do estoque: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

