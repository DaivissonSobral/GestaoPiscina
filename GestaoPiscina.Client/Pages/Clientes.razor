    private async Task LoadClientes()
    {
        try
        {
            clientes = await ApiService.GetClientesAsync();
            
            // Debug: verificar se as piscinas estão sendo carregadas
            if (clientes != null)
            {
                foreach (var cliente in clientes)
                {
                    Console.WriteLine($"Cliente: {cliente.Nome}, Piscinas: {cliente.Piscinas?.Count ?? 0}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar clientes: {ex.Message}");
            clientes = new List<Cliente>();
        }
    }

    private async Task LoadRelatedData()
    {
        if (currentCliente.IDCliente > 0)
        {
            try
            {
                // Carregar dados em paralelo para melhor performance
                var piscinasTask = ApiService.GetPiscinasByClienteAsync(currentCliente.IDCliente);
                var equipamentosTask = ApiService.GetEquipamentosByClienteAsync(currentCliente.IDCliente);
                var estoquesTask = ApiService.GetEstoqueByClienteAsync(currentCliente.IDCliente);

                await Task.WhenAll(piscinasTask, equipamentosTask, estoquesTask);

                piscinas = await piscinasTask;
                equipamentos = await equipamentosTask;
                estoques = await estoquesTask;
                
                // Forçar atualização da UI
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao carregar dados relacionados: {ex.Message}");
                piscinas = new List<Piscina>();
                equipamentos = new List<Equipamento>();
                estoques = new List<EstoqueCliente>();
            }
        }
        else
        {
            // Limpar dados se não há cliente selecionado
            piscinas = new List<Piscina>();
            equipamentos = new List<Equipamento>();
            estoques = new List<EstoqueCliente>();
        }
    }

