    private async Task HandleSavePiscina()
    {
        isLoading = true;
        try
        {
            // Validações básicas
            if (currentPiscina.IDCliente <= 0)
            {
                currentPiscina.IDCliente = currentCliente.IDCliente;
            }

            // Validações adicionais
            if (string.IsNullOrWhiteSpace(currentPiscina.Tipo))
            {
                ShowToast("Erro", "Tipo de piscina é obrigatório", "error");
                return;
            }

            if (currentPiscina.VolumeLitros <= 0)
            {
                ShowToast("Erro", "Volume deve ser maior que zero", "error");
                return;
            }

            // SEMPRE adicionar à lista temporária se o cliente não foi salvo via "Salvar Tudo"
            // ou se há piscinas temporárias (indicando que estamos no modo transação única)
            if (currentCliente.IDCliente <= 0 || piscinasTemporarias.Any())
            {
                piscinasTemporarias.Add(new Piscina
                {
                    IDPiscina = -(piscinasTemporarias.Count + 1), // ID negativo para identificar como temporário
                    IDCliente = 0,
                    Tipo = currentPiscina.Tipo,
                    VolumeLitros = currentPiscina.VolumeLitros,
                    Localizacao = currentPiscina.Localizacao
                });
                
                ShowToast("Sucesso", "Piscina adicionada temporariamente. Use 'Salvar Tudo' para confirmar.", "success");
                ClosePiscinaForm();
                StateHasChanged();
                return;
            }

            // Se o cliente já foi salvo E não há piscinas temporárias, salvar normalmente
            if (currentPiscina.IDPiscina > 0)
            {
                await ApiService.UpdatePiscinaAsync(currentPiscina);
                ShowToast("Sucesso", "Piscina atualizada com sucesso!", "success");
            }
            else
            {
                await ApiService.CreatePiscinaAsync(currentPiscina);
                ShowToast("Sucesso", "Piscina criada com sucesso!", "success");
            }
            
            // Recarregar dados relacionados
            await LoadRelatedData();
            ClosePiscinaForm();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao salvar piscina: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

