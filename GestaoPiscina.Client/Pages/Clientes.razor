    private IEnumerable<Cliente> filteredClientes => clientes?.Where(c => 
        (string.IsNullOrEmpty(searchTerm) || c.Nome.ToLower().Contains(searchTerm.ToLower())) &&
        (string.IsNullOrEmpty(selectedType) || c.Tipo == selectedType)
    ) ?? new List<Cliente>();

