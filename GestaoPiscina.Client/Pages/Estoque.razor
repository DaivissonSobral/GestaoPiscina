@page "/estoque"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@inject ApiService ApiService

<section class="p-4 space-y-6">
    <div class="bg-slate-800 rounded-xl p-4 space-y-4">
        @if (clienteSelecionadoId > 0)
        {
            <button @onclick="() => AbrirNovaMovimentacao(null)" class="sm:hidden w-full bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors whitespace-nowrap">
                <i class="fas fa-plus mr-2"></i>Nova Movimentação
            </button>
        }

        <!-- Celular: só 2 linhas — Cliente + Nível na primeira; Buscar (flexível) + as duas
             datas (largura mínima, lado a lado) na segunda -->
        <div class="sm:hidden space-y-2">
            <div class="grid grid-cols-2 gap-2">
                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-300">Cliente</label>
                    <select @bind="clienteSelecionadoId" @bind:after="CarregarEstoque" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-2 py-2 text-slate-100">
                        <option value="0">Todos os clientes</option>
                        @if (clientes != null)
                        {
                            @foreach (var cliente in clientes)
                            {
                                <option value="@cliente.IDCliente">@cliente.Nome</option>
                            }
                        }
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="block text-sm font-medium text-slate-300">Nível de estoque</label>
                    <select @bind="filtroNivel" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-2 py-2 text-slate-100">
                        <option value="">Todos os níveis</option>
                        <option value="baixo">Abaixo do mínimo</option>
                        <option value="ok">Acima do mínimo</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-2">
                <input type="text" @bind="termoBusca" @bind:event="oninput" placeholder="Buscar produto ou cliente..." class="flex-1 min-w-0 bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                <input type="date" @bind="filtroDataDe" title="Última movimentação de" class="w-36 shrink-0 bg-slate-700 border border-slate-600 rounded-lg px-2 py-2 text-slate-100" />
                <input type="date" @bind="filtroDataAte" title="Última movimentação até" class="w-36 shrink-0 bg-slate-700 border border-slate-600 rounded-lg px-2 py-2 text-slate-100" />
            </div>
        </div>

        <!-- Tablet/desktop: layout original, com os campos se redistribuindo em 1/2/4
             colunas conforme a largura disponível -->
        <div class="hidden sm:grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="space-y-1">
                <label class="block text-sm font-medium text-slate-300">Cliente</label>
                <select @bind="clienteSelecionadoId" @bind:after="CarregarEstoque" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                    <option value="0">Todos os clientes</option>
                    @if (clientes != null)
                    {
                        @foreach (var cliente in clientes)
                        {
                            <option value="@cliente.IDCliente">@cliente.Nome</option>
                        }
                    }
                </select>
            </div>

            <div class="space-y-1">
                <label class="block text-sm font-medium text-slate-300">Nível de estoque</label>
                <select @bind="filtroNivel" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                    <option value="">Todos os níveis</option>
                    <option value="baixo">Abaixo do mínimo</option>
                    <option value="ok">Acima do mínimo</option>
                </select>
            </div>

            <div class="space-y-1">
                <label class="block text-sm font-medium text-slate-300">Última movimentação de</label>
                <input type="date" @bind="filtroDataDe" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
            </div>

            <div class="space-y-1">
                <label class="block text-sm font-medium text-slate-300">até</label>
                <input type="date" @bind="filtroDataAte" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
            </div>
        </div>

        <div class="hidden sm:flex items-center gap-4">
            @if (clienteSelecionadoId > 0)
            {
                <button @onclick="() => AbrirNovaMovimentacao(null)" class="bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors whitespace-nowrap">
                    <i class="fas fa-plus mr-2"></i>Nova Movimentação
                </button>
            }
            <input type="text" @bind="termoBusca" @bind:event="oninput" placeholder="Buscar produto ou cliente..." class="flex-1 max-w-sm bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
        </div>
    </div>

    @if (carregando)
    {
        <LoadingSpinner IsVisible="true" Message="Carregando estoque..." />
    }
    else if (estoqueFiltrado.Any())
    {
        <div class="bg-slate-800 rounded-xl overflow-hidden">
            <!-- Desktop: tabela tradicional (>= sm) -->
            <div class="hidden sm:block overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Cliente</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Produto</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Saldo Atual</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Qtd. Mínima</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Diferença</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Última Movimentação</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        @foreach (var item in estoqueFiltrado)
                        {
                            <tr class="hover:bg-slate-700">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-100">@NomeCliente(item)</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@item.Produto?.Nome</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@item.QuantidadeAtual.ToString("0.##") @item.Produto?.Unidade</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@(item.QuantidadeMinima?.ToString("0.##") ?? "-")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium @ClasseDiferenca(item)">@TextoDiferenca(item)</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@(item.UltimaMovimentacao?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="@ClasseStatus(item) px-2 py-1 text-xs font-semibold rounded-full">
                                        @(EstoqueBaixo(item) ? "Baixo" : "OK")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <button @onclick="() => AbrirNovaMovimentacao(item)" class="text-cyan-400 hover:text-cyan-300 mr-3" title="Nova Movimentação">
                                        <i class="fas fa-exchange-alt"></i>
                                    </button>
                                    <button @onclick="() => AbrirHistorico(item)" class="text-blue-400 hover:text-blue-300 mr-3" title="Histórico">
                                        <i class="fas fa-history"></i>
                                    </button>
                                    <button @onclick="() => AbrirLimite(item)" class="text-amber-400 hover:text-amber-300 mr-3" title="Quantidade Mínima">
                                        <i class="fas fa-sliders-h"></i>
                                    </button>
                                    <button @onclick="() => ExcluirVinculo(item)" class="text-red-400 hover:text-red-300" title="Remover do estoque">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Celular: cards com a coluna de ações sempre visível à direita, separada do
                 conteúdo por espaçamento e uma borda. Sem clique no card (aqui não há uma
                 "edição" única — são 4 ações de peso equivalente). -->
            <div class="sm:hidden divide-y divide-slate-700">
                @foreach (var item in estoqueFiltrado)
                {
                    <div class="flex gap-4 p-4">
                        <div class="flex-1 min-w-0 space-y-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="text-sm font-medium text-slate-100 truncate">@NomeCliente(item)</div>
                                    <div class="text-xs text-slate-400 truncate">@item.Produto?.Nome</div>
                                </div>
                                <span class="@ClasseStatus(item) px-2 py-0.5 text-xs font-semibold rounded-full shrink-0">
                                    @(EstoqueBaixo(item) ? "Baixo" : "OK")
                                </span>
                            </div>
                            <div class="grid grid-cols-2 gap-x-3 text-sm text-slate-300">
                                <div>Saldo: @item.QuantidadeAtual.ToString("0.##") @item.Produto?.Unidade</div>
                                <div class="text-right text-slate-400">Mín: @(item.QuantidadeMinima?.ToString("0.##") ?? "-")</div>
                            </div>
                            <div class="grid grid-cols-2 gap-x-3 text-xs">
                                <div class="@ClasseDiferenca(item)">@TextoDiferenca(item)</div>
                                <div class="text-right text-slate-400">@(item.UltimaMovimentacao?.ToString("dd/MM/yyyy") ?? "-")</div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2 items-center shrink-0 pt-1 pl-3 border-l border-slate-700">
                            <button @onclick="() => AbrirNovaMovimentacao(item)" class="text-cyan-400 hover:text-cyan-300" title="Nova Movimentação">
                                <i class="fas fa-exchange-alt"></i>
                            </button>
                            <button @onclick="() => AbrirHistorico(item)" class="text-blue-400 hover:text-blue-300" title="Histórico">
                                <i class="fas fa-history"></i>
                            </button>
                            <button @onclick="() => AbrirLimite(item)" class="text-amber-400 hover:text-amber-300" title="Quantidade Mínima">
                                <i class="fas fa-sliders-h"></i>
                            </button>
                            <button @onclick="() => ExcluirVinculo(item)" class="text-red-400 hover:text-red-300" title="Remover do estoque">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="bg-slate-800 rounded-xl p-8 text-center">
            <i class="fas fa-box text-4xl text-slate-600 mb-4"></i>
            <h4 class="text-lg font-medium text-slate-300 mb-2">Nenhum produto encontrado</h4>
            <p class="text-slate-400">
                @(clienteSelecionadoId > 0
                    ? "Clique em \"Nova Movimentação\" e registre uma Entrada para começar."
                    : "Selecione um cliente e registre uma Entrada, ou ajuste os filtros acima.")
            </p>
        </div>
    }
</section>

<EstoqueMovimentacaoModal @bind-IsVisible="modalMovimentacaoVisible"
                          ClienteId="clienteIdAcao"
                          Produtos="produtosGlobais"
                          EstoqueDoCliente="EstoqueParaModal()"
                          ProdutoIdFixo="produtoIdFixoParaMovimentacao"
                          OnSave="RegistrarMovimentacao" />

<EstoqueLimiteModal @bind-IsVisible="modalLimiteVisible"
                     Estoque="estoqueParaLimite"
                     OnSave="SalvarLimite" />

<EstoqueHistoricoModal @bind-IsVisible="modalHistoricoVisible"
                        ClienteId="clienteIdAcao"
                        Produto="produtoParaHistorico"
                        OnChanged="CarregarEstoque" />

<ConfirmDialog @bind-IsVisible="confirmacaoExclusaoVisible"
               Title="Remover do Estoque"
               Message="Tem certeza que deseja parar de acompanhar este produto no estoque deste cliente?"
               ConfirmText="Remover"
               OnConfirm="ConfirmarExclusaoVinculo" />

<Toast @bind-IsVisible="toastVisible"
       Title="Notificação"
       Message="@mensagemToast"
       Type="@tipoToast" />

@code {
    private List<Cliente>? clientes;
    private List<Produto>? produtosGlobais;
    private List<EstoqueCliente>? estoqueLista;
    private int clienteSelecionadoId;
    private string termoBusca = "";
    private string filtroNivel = "";
    private DateTime? filtroDataDe;
    private DateTime? filtroDataAte;
    private bool carregando = false;

    [SupplyParameterFromQuery(Name = "nivel")]
    public string? NivelQuery { get; set; }

    private bool modalMovimentacaoVisible = false;
    private int clienteIdAcao;
    private int? produtoIdFixoParaMovimentacao;

    private bool modalLimiteVisible = false;
    private EstoqueCliente estoqueParaLimite = new EstoqueCliente();

    private bool modalHistoricoVisible = false;
    private Produto? produtoParaHistorico;

    private bool confirmacaoExclusaoVisible = false;
    private EstoqueCliente? estoqueParaExcluir;

    private bool toastVisible = false;
    private string mensagemToast = "";
    private string tipoToast = "success";

    private IEnumerable<EstoqueCliente> estoqueFiltrado => (estoqueLista ?? Enumerable.Empty<EstoqueCliente>())
        .Where(e =>
            string.IsNullOrEmpty(termoBusca) ||
            e.Produto?.Nome?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true ||
            NomeCliente(e).Contains(termoBusca, StringComparison.OrdinalIgnoreCase))
        .Where(e => filtroNivel switch
        {
            "baixo" => EstoqueBaixo(e),
            "ok" => !EstoqueBaixo(e),
            _ => true
        })
        .Where(e => !filtroDataDe.HasValue || (e.UltimaMovimentacao.HasValue && e.UltimaMovimentacao.Value.Date >= filtroDataDe.Value.Date))
        .Where(e => !filtroDataAte.HasValue || (e.UltimaMovimentacao.HasValue && e.UltimaMovimentacao.Value.Date <= filtroDataAte.Value.Date));

    protected override async Task OnInitializedAsync()
    {
        if (NivelQuery == "baixo" || NivelQuery == "ok")
        {
            filtroNivel = NivelQuery;
        }

        try
        {
            clientes = await ApiService.GetClientesAsync();
            produtosGlobais = await ApiService.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao carregar dados: {ex.Message}", "error");
            clientes = new List<Cliente>();
            produtosGlobais = new List<Produto>();
        }

        await CarregarEstoque();
    }

    private async Task CarregarEstoque()
    {
        try
        {
            carregando = true;
            estoqueLista = clienteSelecionadoId > 0
                ? await ApiService.GetEstoqueByClienteAsync(clienteSelecionadoId)
                : await ApiService.GetEstoqueAsync();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao carregar estoque: {ex.Message}", "error");
            estoqueLista = new List<EstoqueCliente>();
        }
        finally
        {
            carregando = false;
        }
    }

    private string NomeCliente(EstoqueCliente item) =>
        clientes?.FirstOrDefault(c => c.IDCliente == item.IDCliente)?.Nome ?? item.Cliente?.Nome ?? "";

    private List<EstoqueCliente> EstoqueParaModal() =>
        estoqueLista?.Where(e => e.IDCliente == clienteIdAcao).ToList() ?? new List<EstoqueCliente>();

    private void AbrirNovaMovimentacao(EstoqueCliente? item)
    {
        clienteIdAcao = item?.IDCliente ?? clienteSelecionadoId;
        produtoIdFixoParaMovimentacao = item?.IDProduto;
        modalMovimentacaoVisible = true;
    }

    private async Task RegistrarMovimentacao(MovimentacaoEstoque movimentacao)
    {
        await ApiService.CreateMovimentacaoEstoqueAsync(movimentacao);
        MostrarNotificacao("Sucesso", "Movimentação registrada com sucesso!", "success");
        await CarregarEstoque();
    }

    private void AbrirLimite(EstoqueCliente item)
    {
        estoqueParaLimite = new EstoqueCliente
        {
            IDEstoque = item.IDEstoque,
            IDCliente = item.IDCliente,
            IDProduto = item.IDProduto,
            QuantidadeMinima = item.QuantidadeMinima,
            Produto = item.Produto
        };
        modalLimiteVisible = true;
    }

    private async Task SalvarLimite(EstoqueCliente item)
    {
        try
        {
            await ApiService.UpdateEstoqueAsync(item);
            MostrarNotificacao("Sucesso", "Quantidade mínima atualizada!", "success");
            await CarregarEstoque();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao salvar: {ex.Message}", "error");
        }
    }

    private void AbrirHistorico(EstoqueCliente item)
    {
        clienteIdAcao = item.IDCliente;
        produtoParaHistorico = item.Produto;
        modalHistoricoVisible = true;
    }

    private void ExcluirVinculo(EstoqueCliente item)
    {
        estoqueParaExcluir = item;
        confirmacaoExclusaoVisible = true;
    }

    private async Task ConfirmarExclusaoVinculo()
    {
        if (estoqueParaExcluir == null)
        {
            return;
        }

        try
        {
            await ApiService.DeleteEstoqueAsync(estoqueParaExcluir.IDEstoque);
            MostrarNotificacao("Sucesso", "Produto removido do estoque do cliente!", "success");
            await CarregarEstoque();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao remover: {ex.Message}", "error");
        }
        finally
        {
            estoqueParaExcluir = null;
        }
    }

    private bool EstoqueBaixo(EstoqueCliente item) => item.QuantidadeMinima.HasValue && item.QuantidadeAtual <= item.QuantidadeMinima.Value;

    private string ClasseStatus(EstoqueCliente item) => EstoqueBaixo(item) ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800";

    private string TextoDiferenca(EstoqueCliente item)
    {
        if (!item.QuantidadeMinima.HasValue)
        {
            return "-";
        }

        var diferenca = item.QuantidadeAtual - item.QuantidadeMinima.Value;
        var sinal = diferenca > 0 ? "+" : "";
        return $"{sinal}{diferenca.ToString("0.##")} {item.Produto?.Unidade}".Trim();
    }

    private string ClasseDiferenca(EstoqueCliente item)
    {
        if (!item.QuantidadeMinima.HasValue)
        {
            return "text-slate-400";
        }

        return item.QuantidadeAtual - item.QuantidadeMinima.Value < 0 ? "text-red-400" : "text-green-400";
    }

    private void MostrarNotificacao(string titulo, string mensagem, string tipo)
    {
        mensagemToast = mensagem;
        tipoToast = tipo;
        toastVisible = true;
    }
}
