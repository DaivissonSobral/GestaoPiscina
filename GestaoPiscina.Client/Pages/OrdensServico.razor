@page "/ordens-servico"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@implements IAsyncDisposable
@inject ApiService ApiService
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<section class="p-4 pb-24 sm:pb-4 space-y-6">
    <div class="hidden sm:flex justify-between items-center">
        <div class="flex space-x-2">
            <button @onclick="AbrirModalGerarOS" class="bg-green-600 hover:bg-green-500 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas fa-magic mr-2"></i>Gerar OS
            </button>
            <button @onclick="AbrirModalNovaOS" class="bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas fa-plus mr-2"></i>Nova OS
            </button>
        </div>

    </div>

    <!-- No celular os botões saem do topo e viram uma barra fixa no rodapé da tela,
         acima da faixa de navegação inferior; no desktop continuam no fluxo normal. -->
    <div class="sm:hidden fixed bottom-0 left-0 right-0 z-20 bg-slate-800 border-t border-slate-700 p-3 flex gap-2">
        <button @onclick="AbrirModalGerarOS" class="flex-1 bg-green-600 hover:bg-green-500 px-4 py-2 rounded-lg text-white transition-colors">
            <i class="fas fa-magic mr-2"></i>Gerar OS
        </button>
        <button @onclick="AbrirModalNovaOS" class="flex-1 bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
            <i class="fas fa-plus mr-2"></i>Nova OS
        </button>
    </div>

    <div class="flex justify-between items-start gap-3 mb-4">
        <div class="grid grid-cols-2 gap-2 w-full sm:flex sm:flex-wrap sm:w-auto min-w-0">
            <input type="text" @bind="termoBusca" @bind:event="oninput" placeholder="Buscar OS..." class="w-full sm:w-auto sm:flex-1 sm:min-w-[160px] bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
            <select @bind="filtroData" @bind:event="onchange" class="w-full sm:flex-1 sm:min-w-[120px] bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                <option value="">Todas as Datas</option>
                <option value="hoje">Hoje</option>
                <option value="amanha">Amanhã</option>
                <option value="semana">Esta Semana</option>
                <option value="mes">Este Mês</option>
                <option value="atrasada">Atrasadas</option>
            </select>
            <select @bind="filtroStatus" @bind:event="onchange" class="w-full sm:flex-1 sm:min-w-[120px] bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                <option value="">Todos os Status</option>
                <option value="Em Aberto">Em Aberto</option>
                <option value="Em Andamento">Em Andamento</option>
                <option value="Finalizada">Finalizada</option>
                <option value="Ocorrência">Ocorrência</option>
                <option value="Reagendada">Reagendada</option>
                <option value="Cancelada">Cancelada</option>
            </select>
            @if (filtroStatus == "Ocorrência")
            {
                <select @bind="filtroOcorrenciaStatus" @bind:event="onchange" class="w-full sm:flex-1 sm:min-w-[120px] bg-purple-700 hover:bg-purple-600 border border-purple-600 rounded-lg px-3 py-2 text-white transition-colors">
                    <option value="">Todas as Ocorrências</option>
                    <option value="Pendente">Pendente</option>
                    <option value="Aprovado">Aprovado</option>
                </select>
            }
            <button @onclick="ToggleMinhasOS" class="@GetMinhasOSButtonClass()">
                <i class="fas fa-user mr-2"></i>Minhas OSs
            </button>
        </div>

        <div class="hidden sm:flex space-x-2 shrink-0">
            <button @onclick="SetListView"
                    class="@GetListViewButtonClass()"
                    title="Lista">
                <i class="fas fa-list"></i>
            </button>
            <button @onclick="SetCardsView"
                    class="@GetCardsViewButtonClass()"
                    title="Cards por Status">
                <i class="fas fa-columns"></i>
            </button>
        </div>

    </div>

    @if (carregando)
    {
        <LoadingSpinner IsVisible="true" Message="Carregando ordens de serviço..." />
    }
    else if (ordensFiltradas?.Any() == true)
    {
        @if (viewMode == "lista")
        {
            <!-- Tabela Responsiva -->
            <div class="bg-slate-800 rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-700">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">OS</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Cliente</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Piscina</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Data</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Checklist</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700">
                            @foreach (var os in ordensFiltradas)
                            {
                                <tr class="hover:bg-slate-700 cursor-pointer" @onclick="() => VerDetalhes(os)">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-slate-100">#@os.IDOS</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-slate-100">@os.Piscina?.Cliente?.Nome</div>
                                        <div class="text-sm text-slate-400">@os.Piscina?.Cliente?.Tipo</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-slate-300">@os.Piscina?.Tipo</div>
                                        <div class="text-sm text-slate-400">@os.Piscina?.VolumeM3 m³</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">
                                        @os.DataExecucao.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="@GetStatusClass(os.Status) px-2 py-1 text-xs font-semibold rounded-full">
                                            @os.Status
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="@(os.ChecklistConcluido ? "text-green-400" : "text-red-400") text-sm">
                                            @(os.ChecklistConcluido ? "✓" : "✗")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" @onclick:stopPropagation="true">
                                        <button @onclick="() => VerDetalhes(os)" class="text-blue-400 hover:text-blue-300 mr-3" title="Ver Detalhes">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button @onclick="() => EditarOS(os)" class="text-cyan-400 hover:text-cyan-300 mr-3" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button @onclick="() => ExcluirOS(os)" class="text-red-400 hover:text-red-300" title="Excluir">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (viewMode == "cards")
        {
            <!-- Visão em Cards por Status - Layout Kanban -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:flex gap-4">
                @foreach (var coluna in colunasKanban)
                {
                    var ordensColuna = GetOrdensPorStatus(coluna.Status).ToList();
                    <div class="bg-slate-800 rounded-lg p-3 border-2 border-slate-700 @(ordensColuna.Any() ? "lg:flex-1 lg:min-w-0" : "hidden lg:block lg:flex-none lg:w-12 lg:px-1")">
                        <h3 class="@coluna.CorTexto font-bold text-center mb-3 text-sm flex items-center justify-center gap-2 lg:whitespace-nowrap @(!ordensColuna.Any() ? "lg:flex-col" : "")">
                            <span class="@(!ordensColuna.Any() ? "lg:[writing-mode:vertical-rl] lg:[text-orientation:mixed]" : "")">@coluna.Label</span>
                            <span class="bg-slate-900 text-slate-300 text-xs font-semibold rounded-full px-2 py-0.5 @(!ordensColuna.Any() ? "lg:hidden" : "")">@ordensColuna.Count</span>
                        </h3>
                        <div class="space-y-2 max-h-[65vh] overflow-y-auto pr-1 scroll-tema">
                            @foreach (var os in ordensColuna)
                            {
                                <div @onclick="() => VerDetalhes(os)"
                                     class="relative bg-slate-700 rounded-lg p-3 text-xs hover:bg-slate-600 cursor-pointer transition-colors">
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="text-white font-bold">#@os.IDOS</span>
                                        @{ var tecnicoDaOS = Tecnico(os); }
                                        @if (tecnicoDaOS != null || (os.Status == "Ocorrência" && Aprovador(os) != null))
                                        {
                                            <div class="flex items-center -space-x-2 shrink-0">
                                                @if (os.Status == "Ocorrência")
                                                {
                                                    var aprovadorDaOS = Aprovador(os);
                                                    @if (aprovadorDaOS != null)
                                                    {
                                                        @if (!string.IsNullOrEmpty(aprovadorDaOS.FotoUrl))
                                                        {
                                                            <img src="@aprovadorDaOS.FotoUrl" alt="@aprovadorDaOS.Nome" title="Aprovador: @aprovadorDaOS.Nome" class="w-6 h-6 rounded-full object-cover ring-2 ring-purple-500" />
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-user-circle text-purple-400 text-xl ring-2 ring-purple-500 rounded-full" title="Aprovador: @aprovadorDaOS.Nome"></i>
                                                        }
                                                    }
                                                }
                                                @if (tecnicoDaOS != null)
                                                {
                                                    @if (!string.IsNullOrEmpty(tecnicoDaOS.FotoUrl))
                                                    {
                                                        <img src="@tecnicoDaOS.FotoUrl" alt="@tecnicoDaOS.Nome" title="Técnico: @tecnicoDaOS.Nome" class="w-6 h-6 rounded-full object-cover ring-2 ring-slate-700" />
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-user-circle text-slate-400 text-xl" title="Técnico: @tecnicoDaOS.Nome"></i>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="text-white font-medium truncate mt-1">@os.Piscina?.Cliente?.Nome</div>
                                    <div class="text-slate-400 truncate">@os.Piscina?.Tipo · @os.Piscina?.Cliente?.Tipo</div>
                                    @if (!string.IsNullOrEmpty(NomeTecnico(os)))
                                    {
                                        <div class="text-slate-400 truncate mt-1">
                                            <i class="fas fa-user-hard-hat mr-1"></i>@NomeTecnico(os)
                                        </div>
                                    }
                                    <div class="flex items-center justify-between gap-2 mt-2 pt-2 border-t border-slate-600">
                                        <span class="@(EstaAtrasada(os) ? "text-red-400 font-semibold" : "text-slate-400")">
                                            <i class="fas fa-calendar-alt mr-1"></i>@os.DataExecucao.ToString("dd/MM/yyyy")
                                        </span>
                                        @if (os.Status == "Em Andamento" && (os.InicioPercurso.HasValue || os.HoraInicio == default))
                                        {
                                            <span class="ml-auto text-blue-400 font-semibold" title="A caminho">A caminho</span>
                                        }
                                        @if (EstaAtrasada(os))
                                        {
                                            <div class="ml-auto text-red-400 font-semibold mt-1">
                                                <i class="fas fa-exclamation-triangle ml-1 mr-1"></i>
                                            </div>
                                        }
                                        else if (os.Status != "Em Andamento" || (!os.InicioPercurso.HasValue && os.HoraInicio != default))
                                        {
                                            <span class="ml-auto @GetStatusIconColor(os.Status)" title="@(os.ChecklistConcluido ? "Checklist concluído" : "Checklist pendente") · @os.Status">
                                                <i class="fas @(os.ChecklistConcluido ? "fa-check-circle" : "fa-circle")"></i>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="bg-slate-800 rounded-xl p-8 text-center">
            <i class="fas fa-clipboard-list text-4xl text-slate-600 mb-4"></i>
            <h4 class="text-lg font-medium text-slate-300 mb-2">Nenhuma Ordem de Serviço encontrada</h4>
            <p class="text-slate-400">Crie uma nova OS ou gere automaticamente baseado nos agendamentos.</p>
        </div>
    }
</section>

<OrdemServicoModal @bind-IsVisible="modalOSVisible"
                   OrdemDeServico="osSelecionada"
                   Piscinas="piscinas"
                   Tecnicos="tecnicos"
                   Aprovadores="quimicos"
                   ChecklistItensDisponiveis="checklistItens"
                   OnSave="SalvarOS"
                   OnSalvo="AbrirDetalhesAposSalvar"
                   OnVoltar="VoltarParaDetalhes" />

<OrdemServicoDetalhes @bind-IsVisible="modalDetalhesVisible"
                      OrdemDeServico="osSelecionada"
                      MostrarInicioPercurso="EhPrimeiraOsDoDia(osSelecionada)"
                      Tecnicos="tecnicos"
                      ChecklistItensDisponiveis="checklistItens"
                      OnEdit="EditarOS" />

<GerarOSModal @bind-IsVisible="modalGerarOSVisible"
              OnConfirm="ConfirmarGerarOS" />

<ConfirmDialog @bind-IsVisible="confirmacaoExclusaoVisible"
               Title="Confirmar Exclusão"
               Message="Tem certeza que deseja excluir esta ordem de serviço?"
               ConfirmText="Excluir"
               OnConfirm="ConfirmarExclusao" />

<Toast @bind-IsVisible="toastVisible"
       Title="Notificação"
       Message="@mensagemToast"
       Type="@tipoToast" />

@code {
    private List<OrdemDeServico>? ordensDeServico;
    private List<OrdemDeServico>? ordensFiltradas;
    private List<Piscina>? piscinas;
    private List<Usuario>? tecnicos;
    private List<Usuario>? quimicos;
    private List<ChecklistItemDefinicao>? checklistItens;
    private OrdemDeServico osSelecionada = new OrdemDeServico();
    private bool modalOSVisible = false;
    private bool modalDetalhesVisible = false;
    private bool confirmacaoExclusaoVisible = false;
    private bool modalGerarOSVisible = false;
    private bool carregando = true;
    private string _termoBusca = "";
    private string _filtroStatus = "";
    private string _filtroData = "";
    private string _filtroOcorrenciaStatus = "";
    private bool filtroMinhasOS = false;
    private int? currentUserId;
    private string viewMode = "cards"; // "lista" ou "cards" — abre em Kanban por padrão

    // Propriedades para detectar mudanças nos filtros
    public string termoBusca
    {
        get => _termoBusca;
        set
        {
            if (_termoBusca != value)
            {
                _termoBusca = value;
                FiltrarOS();
            }
        }
    }

    public string filtroStatus
    {
        get => _filtroStatus;
        set
        {
            if (_filtroStatus != value)
            {
                _filtroStatus = value;
                // O sub-filtro Pendente/Aprovado só faz sentido com Status == "Ocorrência" —
                // limpa aqui pra não ficar um filtro escondido aplicado quando o usuário volta
                // pra esse status depois de já ter trocado pra outro.
                _filtroOcorrenciaStatus = "";
                FiltrarOS();
            }
        }
    }

    public string filtroData
    {
        get => _filtroData;
        set
        {
            if (_filtroData != value)
            {
                _filtroData = value;
                FiltrarOS();
            }
        }
    }

    public string filtroOcorrenciaStatus
    {
        get => _filtroOcorrenciaStatus;
        set
        {
            if (_filtroOcorrenciaStatus != value)
            {
                _filtroOcorrenciaStatus = value;
                FiltrarOS();
            }
        }
    }
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "data")]
    public string? DataQuery { get; set; }

    // Usado pelo clique numa notificação push de ocorrência (?os={id}) para abrir a OS
    // correspondente direto nos Detalhes, sem o usuário precisar procurá-la na lista.
    [SupplyParameterFromQuery(Name = "os")]
    public int? OsQuery { get; set; }

    private OrdemDeServico? osParaExcluir;
    private bool toastVisible = false;
    private string mensagemToast = "";
    private string tipoToast = "success";

    private record ColunaKanban(string Status, string Label, string CorTexto);

    private readonly List<ColunaKanban> colunasKanban = new()
    {
        new("Em Aberto", "Em Aberto", "text-yellow-400"),
        new("Em Andamento", "Em Andamento", "text-blue-400"),
        new("Finalizada", "Finalizada", "text-green-400"),
        new("Ocorrência", "Ocorrência", "text-purple-400"),
        new("Reagendada", "Reagendada", "text-orange-400"),
        new("Cancelada", "Cancelada", "text-red-400"),
    };

    private Usuario? Tecnico(OrdemDeServico os) => tecnicos?.FirstOrDefault(u => u.IDUsuario == os.IDUsuario);
    private Usuario? Aprovador(OrdemDeServico os) => quimicos?.FirstOrDefault(u => u.IDUsuario == os.Aprovador);
    private string? NomeTecnico(OrdemDeServico os) => Tecnico(os)?.Nome;

    // Cor do indicador de checklist no card do Kanban — antes era só verde/cinza (concluído
    // ou não); agora acompanha a cor do status da própria OS, igual às colunas do quadro.
    private string GetStatusIconColor(string status) => status switch
    {
        "Em Aberto" => "text-yellow-400",
        "Em Andamento" => "text-blue-400",
        "Finalizada" => "text-green-400",
        "Ocorrência" => "text-purple-400",
        "Reagendada" => "text-orange-400",
        "Cancelada" => "text-red-400",
        _ => "text-slate-500"
    };

    private bool EstaAtrasada(OrdemDeServico os) => os.Status == "Em Aberto" && os.DataExecucao.Date < DateTime.Today;

    private bool EhPrimeiraOsDoDia(OrdemDeServico os)
    {
        if (os.IDUsuario is null or <= 0 || ordensDeServico == null)
        {
            return false;
        }

        var mesmaData = os.DataExecucao.Date;
        return !ordensDeServico.Any(outro =>
            outro.IDOS != os.IDOS &&
            outro.IDUsuario == os.IDUsuario &&
            outro.DataExecucao.Date == mesmaData &&
            outro.Status != "Cancelada");
    }

    private static readonly HashSet<string> StatusValidos = new()
    {
        "Em Aberto", "Em Andamento", "Finalizada", "Ocorrência", "Reagendada", "Cancelada"
    };

    private static readonly HashSet<string> DatasValidas = new() { "hoje", "amanha", "semana", "mes", "atrasada" };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(StatusQuery) && StatusValidos.Contains(StatusQuery))
        {
            _filtroStatus = StatusQuery;
        }

        if (!string.IsNullOrEmpty(DataQuery) && DatasValidas.Contains(DataQuery))
        {
            _filtroData = DataQuery;
        }

        var usuarioLogado = await AuthService.GetCurrentUserAsync();
        currentUserId = usuarioLogado?.IDUsuario;

        await CarregarDados();

        if (OsQuery.HasValue)
        {
            var os = ordensDeServico?.FirstOrDefault(o => o.IDOS == OsQuery.Value)
                ?? await ApiService.GetOrdemDeServicoAsync(OsQuery.Value);
            if (os != null)
            {
                VerDetalhes(os);
            }
        }
    }

    private async Task CarregarDados()
    {
        try
        {
            carregando = true;
            StateHasChanged();

            var tasks = new Task[]
            {
                ApiService.GetOrdensDeServicoAsync(),
                ApiService.GetPiscinasAsync(),
                ApiService.GetUsuariosAsync("Técnico,Supervisor"),
                ApiService.GetUsuariosAsync("Química"),
                ApiService.GetChecklistItensAsync()
            };

            await Task.WhenAll(tasks);

            ordensDeServico = ((Task<List<OrdemDeServico>>)tasks[0]).Result;
            piscinas = ((Task<List<Piscina>>)tasks[1]).Result;
            tecnicos = ((Task<List<Usuario>>)tasks[2]).Result;
            quimicos = ((Task<List<Usuario>>)tasks[3]).Result;
            checklistItens = ((Task<List<ChecklistItemDefinicao>>)tasks[4]).Result;
            // Reaplica os filtros ativos em vez de simplesmente mostrar a lista inteira —
            // sem isso, qualquer recarga (salvar/excluir uma OS, por exemplo) descartava
            // silenciosamente os filtros que o usuário tinha escolhido.
            FiltrarOS();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Erro ao carregar dados: {ex.Message}");
            ordensDeServico = new List<OrdemDeServico>();
            piscinas = new List<Piscina>();
            tecnicos = new List<Usuario>();
            quimicos = new List<Usuario>();
            checklistItens = new List<ChecklistItemDefinicao>();
            ordensFiltradas = new List<OrdemDeServico>();
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private void FiltrarOS()
    {
        if (ordensDeServico == null) return;

        ordensFiltradas = ordensDeServico.ToList();

        if (!string.IsNullOrEmpty(termoBusca))
        {
            ordensFiltradas = ordensFiltradas.Where(os => 
                os.IDOS.ToString().Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                os.Piscina?.Cliente?.Nome?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true ||
                os.Piscina?.Tipo?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true ||
                os.Observacoes?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true
            ).ToList();
        }

        if (!string.IsNullOrEmpty(filtroStatus))
        {
            ordensFiltradas = ordensFiltradas.Where(os => os.Status == filtroStatus).ToList();
        }

        if (filtroStatus == "Ocorrência" && !string.IsNullOrEmpty(filtroOcorrenciaStatus))
        {
            var aprovada = filtroOcorrenciaStatus == "Aprovado";
            ordensFiltradas = ordensFiltradas.Where(os => os.OcorrenciaAprovada == aprovada).ToList();
        }

        if (filtroMinhasOS && currentUserId.HasValue)
        {
            ordensFiltradas = ordensFiltradas.Where(os => os.IDUsuario == currentUserId || os.Aprovador == currentUserId).ToList();
        }

        if (!string.IsNullOrEmpty(filtroData))
        {
            var hoje = DateTime.Today;
            // Semana civil (segunda a domingo) que contém "hoje" — não os próximos 7 dias.
            var diasDesdeSegunda = ((int)hoje.DayOfWeek + 6) % 7;
            var inicioSemana = hoje.AddDays(-diasDesdeSegunda);
            var fimSemana = inicioSemana.AddDays(6);

            ordensFiltradas = filtroData switch
            {
                "hoje" => ordensFiltradas.Where(os => os.DataExecucao.Date == hoje).ToList(),
                "amanha" => ordensFiltradas.Where(os => os.DataExecucao.Date == hoje.AddDays(1)).ToList(),
                "semana" => ordensFiltradas.Where(os => os.DataExecucao.Date >= inicioSemana && os.DataExecucao.Date <= fimSemana).ToList(),
                "mes" => ordensFiltradas.Where(os => os.DataExecucao.Month == hoje.Month && os.DataExecucao.Year == hoje.Year).ToList(),
                "atrasada" => ordensFiltradas.Where(os => os.Status == "Em Aberto" && os.DataExecucao.Date < hoje).ToList(),
                _ => ordensFiltradas
            };
        }

        StateHasChanged();
    }

    private IEnumerable<OrdemDeServico> GetOrdensPorStatus(string status)
    {
        return ordensFiltradas?.Where(os => os.Status == status) ?? new List<OrdemDeServico>();
    }

