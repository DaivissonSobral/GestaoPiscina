@page "/ordens-servico"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@inject ApiService ApiService
@inject IJSRuntime JSRuntime

<section class="p-4 space-y-6">
    <div class="flex justify-between items-center">
        <div class="flex space-x-2">
            <button @onclick="AbrirModalGerarOS" class="bg-green-600 hover:bg-green-500 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas fa-magic mr-2"></i>Gerar OS Automáticas
            </button>
            <button @onclick="AbrirModalNovaOS" class="bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas fa-plus mr-2"></i>Nova OS
            </button>
        </div>
        
    </div>

    <div class="flex justify-between items-center mb-4">
        <div class="flex space-x-2">
            <input type="text" @bind="termoBusca" @bind:event="oninput" placeholder="Buscar OS..." class="flex bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
            <select @bind="filtroStatus" @bind:event="onchange" class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                <option value="">Todos os Status</option>
                <option value="Em Aberto">Em Aberto</option>
                <option value="Em Andamento">Em Andamento</option>
                <option value="Finalizada">Finalizada</option>
                <option value="Ocorrência">Ocorrência</option>
                <option value="Reagendada">Reagendada</option>
                <option value="Cancelada">Cancelada</option>
            </select>
            <select @bind="filtroData" @bind:event="onchange" class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                <option value="">Todas as Datas</option>
                <option value="hoje">Hoje</option>
                <option value="semana">Esta Semana</option>
                <option value="mes">Este Mês</option>
                <option value="atrasada">Atrasadas</option>
            </select>
            <button type="button" @onclick="FiltrarOS" class="bg-slate-700 hover:bg-slate-600 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 transition-colors" title="Buscar">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <div class="flex space-x-2">
            <button @onclick="SetListView" 
                    class="@GetListViewButtonClass()"
                    title="Lista">
                <i class="fas fa-list"></i>
            </button>
            <button @onclick="SetCardsView" 
                    class="@GetCardsViewButtonClass()"
                    title="Cards por Status">
                <i class="fas fa-columns"></i>
            </button>
        </div>

    </div>

    @if (carregando)
    {
        <LoadingSpinner IsVisible="true" Message="Carregando ordens de serviço..." />
    }
    else if (ordensFiltradas?.Any() == true)
    {
        @if (viewMode == "lista")
        {
            <!-- Tabela Responsiva -->
            <div class="bg-slate-800 rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-700">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">OS</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Cliente</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Piscina</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Data</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Checklist</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700">
                            @foreach (var os in ordensFiltradas)
                            {
                                <tr class="hover:bg-slate-700 cursor-pointer" @onclick="() => VerDetalhes(os)">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-slate-100">#@os.IDOS</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-slate-100">@os.Piscina?.Cliente?.Nome</div>
                                        <div class="text-sm text-slate-400">@os.Piscina?.Cliente?.Tipo</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-slate-300">@os.Piscina?.Tipo</div>
                                        <div class="text-sm text-slate-400">@os.Piscina?.VolumeLitros L</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">
                                        @os.DataExecucao.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="@GetStatusClass(os.Status) px-2 py-1 text-xs font-semibold rounded-full">
                                            @os.Status
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="@(os.ChecklistConcluido ? "text-green-400" : "text-red-400") text-sm">
                                            @(os.ChecklistConcluido ? "✓" : "✗")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" @onclick:stopPropagation="true">
                                        <button @onclick="() => VerDetalhes(os)" class="text-blue-400 hover:text-blue-300 mr-3" title="Ver Detalhes">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button @onclick="() => EditarOS(os)" class="text-cyan-400 hover:text-cyan-300 mr-3" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button @onclick="() => ExcluirOS(os)" class="text-red-400 hover:text-red-300" title="Excluir">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (viewMode == "cards")
        {
            <!-- Visão em Cards por Status - Layout Kanban -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                @foreach (var coluna in colunasKanban)
                {
                    var ordensColuna = GetOrdensPorStatus(coluna.Status).ToList();
                    <div class="bg-slate-800 rounded-lg p-3 border-2 @coluna.CorBorda">
                        <h3 class="@coluna.CorTexto font-bold text-center mb-3 text-sm flex items-center justify-center gap-2">
                            @coluna.Label
                            <span class="bg-slate-900 text-slate-300 text-xs font-semibold rounded-full px-2 py-0.5">@ordensColuna.Count</span>
                        </h3>
                        <div class="space-y-2 max-h-[65vh] overflow-y-auto pr-1">
                            @foreach (var os in ordensColuna)
                            {
                                <div @onclick="() => VerDetalhes(os)"
                                     class="group relative bg-slate-700 rounded-lg p-3 text-xs hover:bg-slate-600 cursor-pointer transition-colors @(EstaAtrasada(os) ? "ring-2 ring-red-500" : "")">
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="text-white font-bold">#@os.IDOS</span>
                                        <div class="flex space-x-2 opacity-0 group-hover:opacity-100 transition-opacity" @onclick:stopPropagation="true">
                                            <button @onclick="() => EditarOS(os)" class="text-cyan-400 hover:text-cyan-300" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button @onclick="() => ExcluirOS(os)" class="text-red-400 hover:text-red-300" title="Excluir">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="text-white font-medium truncate mt-1">@os.Piscina?.Cliente?.Nome</div>
                                    <div class="text-slate-400 truncate">@os.Piscina?.Tipo · @os.Piscina?.Cliente?.Tipo</div>
                                    @if (!string.IsNullOrEmpty(NomeTecnico(os)))
                                    {
                                        <div class="text-slate-400 truncate mt-1">
                                            <i class="fas fa-user-hard-hat mr-1"></i>@NomeTecnico(os)
                                        </div>
                                    }
                                    <div class="flex items-center justify-between mt-2 pt-2 border-t border-slate-600">
                                        <span class="@(EstaAtrasada(os) ? "text-red-400 font-semibold" : "text-slate-400")">
                                            <i class="fas fa-calendar-alt mr-1"></i>@os.DataExecucao.ToString("dd/MM/yyyy")
                                        </span>
                                        <span class="@(os.ChecklistConcluido ? "text-green-400" : "text-slate-500")" title="@(os.ChecklistConcluido ? "Checklist concluído" : "Checklist pendente")">
                                            <i class="fas @(os.ChecklistConcluido ? "fa-check-circle" : "fa-circle")"></i>
                                        </span>
                                    </div>
                                    @if (EstaAtrasada(os))
                                    {
                                        <div class="text-red-400 font-semibold mt-1">
                                            <i class="fas fa-exclamation-triangle mr-1"></i>Atrasada
                                        </div>
                                    }
                                </div>
                            }
                            @if (!ordensColuna.Any())
                            {
                                <div class="text-slate-500 text-center text-xs py-6">Nenhuma OS</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="bg-slate-800 rounded-xl p-8 text-center">
            <i class="fas fa-clipboard-list text-4xl text-slate-600 mb-4"></i>
            <h4 class="text-lg font-medium text-slate-300 mb-2">Nenhuma Ordem de Serviço encontrada</h4>
            <p class="text-slate-400">Crie uma nova OS ou gere automaticamente baseado nos agendamentos.</p>
        </div>
    }
</section>

<OrdemServicoModal @bind-IsVisible="modalOSVisible"
                   OrdemDeServico="osSelecionada"
                   Piscinas="piscinas"
                   Tecnicos="tecnicos"
                   Usuarios="usuarios"
                   OnSave="SalvarOS" />

<OrdemServicoDetalhes @bind-IsVisible="modalDetalhesVisible" 
                      OrdemDeServico="osSelecionada"
                      OnEdit="EditarOS" />

<GerarOSModal @bind-IsVisible="modalGerarOSVisible"
              OnConfirm="ConfirmarGerarOS" />

<ConfirmDialog @bind-IsVisible="confirmacaoExclusaoVisible"
               Title="Confirmar Exclusão"
               Message="Tem certeza que deseja excluir esta ordem de serviço?"
               ConfirmText="Excluir"
               OnConfirm="ConfirmarExclusao" />

<Toast @bind-IsVisible="toastVisible"
       Title="Notificação"
       Message="@mensagemToast"
       Type="@tipoToast" />

@code {
    private List<OrdemDeServico>? ordensDeServico;
    private List<OrdemDeServico>? ordensFiltradas;
    private List<Piscina>? piscinas;
    private List<Usuario>? tecnicos;
    private List<Usuario>? usuarios;
    private OrdemDeServico osSelecionada = new OrdemDeServico();
    private bool modalOSVisible = false;
    private bool modalDetalhesVisible = false;
    private bool confirmacaoExclusaoVisible = false;
    private bool modalGerarOSVisible = false;
    private bool carregando = true;
    private string _termoBusca = "";
    private string _filtroStatus = "";
    private string _filtroData = "";
    private string viewMode = "cards"; // "lista" ou "cards" — abre em Kanban por padrão

    // Propriedades para detectar mudanças nos filtros
    public string termoBusca
    {
        get => _termoBusca;
        set
        {
            if (_termoBusca != value)
            {
                _termoBusca = value;
                FiltrarOS();
            }
        }
    }

    public string filtroStatus
    {
        get => _filtroStatus;
        set
        {
            if (_filtroStatus != value)
            {
                _filtroStatus = value;
                FiltrarOS();
            }
        }
    }

    public string filtroData
    {
        get => _filtroData;
        set
        {
            if (_filtroData != value)
            {
                _filtroData = value;
                FiltrarOS();
            }
        }
    }
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "data")]
    public string? DataQuery { get; set; }

    private OrdemDeServico? osParaExcluir;
    private bool toastVisible = false;
    private string mensagemToast = "";
    private string tipoToast = "success";

    private record ColunaKanban(string Status, string Label, string CorBorda, string CorTexto);

    private readonly List<ColunaKanban> colunasKanban = new()
    {
        new("Em Aberto", "Em Aberto", "border-yellow-500", "text-yellow-400"),
        new("Em Andamento", "Em Andamento", "border-blue-500", "text-blue-400"),
        new("Finalizada", "Finalizada", "border-green-500", "text-green-400"),
        new("Ocorrência", "Ocorrência", "border-purple-500", "text-purple-400"),
        new("Reagendada", "Reagendada", "border-orange-500", "text-orange-400"),
        new("Cancelada", "Cancelada", "border-red-500", "text-red-400"),
    };

    private string? NomeTecnico(OrdemDeServico os) => usuarios?.FirstOrDefault(u => u.IDUsuario == os.IDUsuario)?.Nome;

    private bool EstaAtrasada(OrdemDeServico os) => os.Status == "Em Aberto" && os.DataExecucao.Date < DateTime.Today;

    private static readonly HashSet<string> StatusValidos = new()
    {
        "Em Aberto", "Em Andamento", "Finalizada", "Ocorrência", "Reagendada", "Cancelada"
    };

    private static readonly HashSet<string> DatasValidas = new() { "hoje", "semana", "mes", "atrasada" };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(StatusQuery) && StatusValidos.Contains(StatusQuery))
        {
            _filtroStatus = StatusQuery;
        }

        if (!string.IsNullOrEmpty(DataQuery) && DatasValidas.Contains(DataQuery))
        {
            _filtroData = DataQuery;
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            carregando = true;
            StateHasChanged();

            var tasks = new Task[]
            {
                ApiService.GetOrdensDeServicoAsync(),
                ApiService.GetPiscinasAsync(),
                ApiService.GetUsuariosAsync("Técnico"),
                ApiService.GetUsuariosAsync()
            };

            await Task.WhenAll(tasks);

            ordensDeServico = ((Task<List<OrdemDeServico>>)tasks[0]).Result;
            piscinas = ((Task<List<Piscina>>)tasks[1]).Result;
            tecnicos = ((Task<List<Usuario>>)tasks[2]).Result;
            usuarios = ((Task<List<Usuario>>)tasks[3]).Result;
            // Reaplica os filtros ativos em vez de simplesmente mostrar a lista inteira —
            // sem isso, qualquer recarga (salvar/excluir uma OS, por exemplo) descartava
            // silenciosamente os filtros que o usuário tinha escolhido.
            FiltrarOS();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Erro ao carregar dados: {ex.Message}");
            ordensDeServico = new List<OrdemDeServico>();
            piscinas = new List<Piscina>();
            tecnicos = new List<Usuario>();
            usuarios = new List<Usuario>();
            ordensFiltradas = new List<OrdemDeServico>();
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private void FiltrarOS()
    {
        if (ordensDeServico == null) return;

        ordensFiltradas = ordensDeServico.ToList();

        if (!string.IsNullOrEmpty(termoBusca))
        {
            ordensFiltradas = ordensFiltradas.Where(os => 
                os.IDOS.ToString().Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
                os.Piscina?.Cliente?.Nome?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true ||
                os.Piscina?.Tipo?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true ||
                os.Observacoes?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true
            ).ToList();
        }

        if (!string.IsNullOrEmpty(filtroStatus))
        {
            ordensFiltradas = ordensFiltradas.Where(os => os.Status == filtroStatus).ToList();
        }

        if (!string.IsNullOrEmpty(filtroData))
        {
            var hoje = DateTime.Today;
            // Semana civil (segunda a domingo) que contém "hoje" — não os próximos 7 dias.
            var diasDesdeSegunda = ((int)hoje.DayOfWeek + 6) % 7;
            var inicioSemana = hoje.AddDays(-diasDesdeSegunda);
            var fimSemana = inicioSemana.AddDays(6);

            ordensFiltradas = filtroData switch
            {
                "hoje" => ordensFiltradas.Where(os => os.DataExecucao.Date == hoje).ToList(),
                "semana" => ordensFiltradas.Where(os => os.DataExecucao.Date >= inicioSemana && os.DataExecucao.Date <= fimSemana).ToList(),
                "mes" => ordensFiltradas.Where(os => os.DataExecucao.Month == hoje.Month && os.DataExecucao.Year == hoje.Year).ToList(),
                "atrasada" => ordensFiltradas.Where(os => os.Status == "Em Aberto" && os.DataExecucao.Date < hoje).ToList(),
                _ => ordensFiltradas
            };
        }

        StateHasChanged();
    }

    private IEnumerable<OrdemDeServico> GetOrdensPorStatus(string status)
    {
        return ordensFiltradas?.Where(os => os.Status == status) ?? new List<OrdemDeServico>();
    }

    private void SetListView()
    {
        viewMode = "lista";
        StateHasChanged();
    }

    private void SetCardsView()
    {
        viewMode = "cards";
        StateHasChanged();
    }

    private string GetListViewButtonClass()
    {
        return viewMode == "lista" 
            ? "px-3 py-2 rounded-lg transition-colors bg-cyan-600 text-white" 
            : "px-3 py-2 rounded-lg transition-colors bg-slate-700 text-slate-300 hover:bg-slate-600";
    }

    private string GetCardsViewButtonClass()
    {
        return viewMode == "cards" 
            ? "px-3 py-2 rounded-lg transition-colors bg-cyan-600 text-white" 
            : "px-3 py-2 rounded-lg transition-colors bg-slate-700 text-slate-300 hover:bg-slate-600";
    }

    private void AbrirModalNovaOS()
    {
        osSelecionada = new OrdemDeServico
        {
            DataExecucao = DateTime.Today,
            Status = "Em Aberto",
            HoraInicio = DateTime.Now,
            HoraTermino = DateTime.Now
        };
        modalOSVisible = true;
    }

    private void EditarOS(OrdemDeServico os)
    {
        osSelecionada = new OrdemDeServico
        {
            IDOS = os.IDOS,
            IDPiscina = os.IDPiscina,
            DataExecucao = os.DataExecucao,
            Status = os.Status,
            ChecklistConcluido = os.ChecklistConcluido,
            Observacoes = os.Observacoes,
            FotosAntes = os.FotosAntes,
            FotosDepois = os.FotosDepois,
            FotosOcorrencias = os.FotosOcorrencias,
            RelatorioGerado = os.RelatorioGerado,
            IDUsuario = os.IDUsuario,
            Aprovador = os.Aprovador,
            pH = os.pH,
            Alcalinidade = os.Alcalinidade,
            CloroLivre = os.CloroLivre,
            DurezaCalcica = os.DurezaCalcica,
            HoraInicio = os.HoraInicio,
            HoraTermino = os.HoraTermino,
            Piscina = os.Piscina
        };
        modalDetalhesVisible = false;
        modalOSVisible = true;
    }

    private void VerDetalhes(OrdemDeServico os)
    {
        osSelecionada = os;
        modalDetalhesVisible = true;
    }

    private async Task SalvarOS(OrdemDeServico os)
    {
        try
        {
            if (os.IDOS == 0)
            {
                await ApiService.CreateOrdemDeServicoAsync(os);
                MostrarNotificacao("Sucesso", "Ordem de Serviço criada com sucesso!", "success");
            }
            else
            {
                await ApiService.UpdateOrdemDeServicoAsync(os);
                MostrarNotificacao("Sucesso", "Ordem de Serviço atualizada com sucesso!", "success");
            }

            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao salvar OS: {ex.Message}", "error");
        }
    }

    private void MostrarNotificacao(string titulo, string mensagem, string tipo)
    {
        mensagemToast = mensagem;
        tipoToast = tipo;
        toastVisible = true;
    }

    private void ExcluirOS(OrdemDeServico os)
    {
        osParaExcluir = os;
        confirmacaoExclusaoVisible = true;
    }

    private async Task ConfirmarExclusao()
    {
        if (osParaExcluir != null)
        {
            try
            {
                await ApiService.DeleteOrdemDeServicoAsync(osParaExcluir.IDOS);
                MostrarNotificacao("Sucesso", "Ordem de Serviço excluída com sucesso!", "success");
                await CarregarDados();
            }
            catch (Exception ex)
            {
                MostrarNotificacao("Erro", $"Erro ao excluir OS: {ex.Message}", "error");
            }
            finally
            {
                osParaExcluir = null;
            }
        }
    }

    private void AbrirModalGerarOS()
    {
        modalGerarOSVisible = true;
    }

    private async Task ConfirmarGerarOS((DateTime DataInicio, DateTime DataFim) periodo)
    {
        try
        {
            var osCriadas = await ApiService.GerarOSAutomaticasAsync(periodo.DataInicio, periodo.DataFim);
            MostrarNotificacao("Sucesso", $"Foram criadas {osCriadas.Count} ordens de serviço automáticas!", "success");
            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao gerar OS automáticas: {ex.Message}", "error");
        }
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Em Aberto" => "bg-yellow-100 text-yellow-800",
            "Em Andamento" => "bg-blue-100 text-blue-800",
            "Finalizada" => "bg-green-100 text-green-800",
            "Ocorrência" => "bg-purple-100 text-purple-800",
            "Reagendada" => "bg-orange-100 text-orange-800",
            "Cancelada" => "bg-red-100 text-red-800",
            _ => "bg-slate-100 text-slate-800"
        };
    }
} 