    // No celular os botões Lista/Kanban ficam escondidos (ver classe "hidden sm:flex" no
    // cabeçalho), então força a visualização em Kanban nessa faixa — sem isso o usuário podia
    // ficar preso na tabela (modo Lista) sem nenhum jeito de trocar de volta pela UI.
    private DotNetObjectReference<OrdensServico>? viewportRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            viewportRef = DotNetObjectReference.Create(this);
            var isMobile = await JSRuntime.InvokeAsync<bool>("gestaoPiscinaViewport.isMobile");
            if (isMobile && viewMode != "cards")
            {
                viewMode = "cards";
                StateHasChanged();
            }

            await JSRuntime.InvokeVoidAsync("gestaoPiscinaViewport.registerMobileChange", viewportRef);
        }
    }

    [JSInvokable]
    public void OnMobileViewportChanged(bool isMobile)
    {
        if (isMobile && viewMode != "cards")
        {
            viewMode = "cards";
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        viewportRef?.Dispose();
        await Task.CompletedTask;
    }

    private void AbrirModalNovaOS()
    {
        osSelecionada = new OrdemDeServico
        {
            DataExecucao = DateTime.Today,
            Status = "Em Aberto",
            HoraInicio = DateTime.Now,
            HoraTermino = DateTime.Now
        };
        modalOSVisible = true;
    }

    private void EditarOS(OrdemDeServico os)
    {
        var copia = new OrdemDeServico
        {
            IDOS = os.IDOS,
            IDPiscina = os.IDPiscina,
            DataExecucao = os.DataExecucao,
            Status = os.Status,
            ChecklistConcluido = os.ChecklistConcluido,
            ChecklistItens = os.ChecklistItens,
            Observacoes = os.Observacoes,
            FotosAntes = os.FotosAntes,
            FotosDepois = os.FotosDepois,
            FotosOcorrencias = os.FotosOcorrencias,
            RelatorioGerado = os.RelatorioGerado,
            IDUsuario = os.IDUsuario,
            LatitudeInicio = os.LatitudeInicio,
            LongitudeInicio = os.LongitudeInicio,
            FotoHodometro = os.FotoHodometro,
            InicioPercurso = os.InicioPercurso,
            Aprovador = os.Aprovador,
            pH = os.pH,
            Alcalinidade = os.Alcalinidade,
            CloroLivre = os.CloroLivre,
            DurezaCalcica = os.DurezaCalcica,
            pHDepois = os.pHDepois,
            AlcalinidadeDepois = os.AlcalinidadeDepois,
            CloroLivreDepois = os.CloroLivreDepois,
            DurezaCalcicaDepois = os.DurezaCalcicaDepois,
            HoraInicio = os.HoraInicio,
            HoraTermino = os.HoraTermino,
            Piscina = os.Piscina
        };

        // Abrir uma OS "Em Aberto" para edição (botão Iniciar/Continuar) marca o começo do
        // atendimento. Fica aqui — disparado só por essa ação explícita do usuário — e não
        // dentro do modal, porque o modal (mesmo escondido) também recebe osSelecionada
        // quando o usuário só abre a Visualização, e não deve reagir a isso.
        if (copia.Status == "Em Aberto")
        {
            copia.Status = "Em Andamento";
            copia.HoraInicio = copia.DataExecucao.Date + DateTime.Now.TimeOfDay;
        }

        osSelecionada = copia;
        modalDetalhesVisible = false;
        modalOSVisible = true;
    }

    private void VerDetalhes(OrdemDeServico os)
    {
        osSelecionada = os;
        modalDetalhesVisible = true;
    }

    // Ao salvar (ou finalizar) uma OS pelo modal de edição, volta para a Visualização dela
    // (osSelecionada já é a mesma instância recém-salva, não precisa recarregar).
    private void AbrirDetalhesAposSalvar(OrdemDeServico os)
    {
        modalDetalhesVisible = true;
    }

    // Botão de voltar do topo do Editar OS: só existe uma tela de Detalhes pra voltar se a
    // OS já tiver sido salva ao menos uma vez (IDOS > 0) — uma "Nova OS" abandonada antes
    // do primeiro Avançar não tem nada persistido pra mostrar, então cai direto na lista.
    private void VoltarParaDetalhes()
    {
        if (osSelecionada.IDOS > 0)
        {
            modalDetalhesVisible = true;
        }
    }

    // mostrarSucesso é false nos salvamentos automáticos de cada etapa do assistente (ao
    // clicar Avançar) — o feedback ali passou a ser o ícone verde no acordeão da própria
    // etapa, não um toast repetido a cada passo. O toast de sucesso continua no Salvar/
    // Finalizar (ação definitiva) e o de erro dispara sempre, em qualquer etapa. Pelo mesmo
    // motivo, só recarrega a lista (CarregarDados) nesse salvamento final — recarregar a
    // cada etapa refaz 5 chamadas à API e re-renderiza a tela de trás (Lista de OS) sem
    // necessidade, já que ela não está visível enquanto o assistente está aberto.
    private async Task<bool> SalvarOS(OrdemDeServico os, bool mostrarSucesso = true)
    {
        try
        {
            if (os.IDOS == 0)
            {
                var criada = await ApiService.CreateOrdemDeServicoAsync(os);
                // O modal precisa do ID real pra poder salvar a dosagem de produtos logo em
                // seguida, na mesma submissão — sem isso `os.IDOS` continuaria 0 depois de criar.
                os.IDOS = criada.IDOS;
                if (mostrarSucesso)
                {
                    MostrarNotificacao("Sucesso", "Ordem de Serviço criada com sucesso!", "success");
                }
            }
            else
            {
                await ApiService.UpdateOrdemDeServicoAsync(os);
                if (mostrarSucesso)
                {
                    MostrarNotificacao("Sucesso", "Ordem de Serviço atualizada com sucesso!", "success");
                }
            }

            if (mostrarSucesso)
            {
                await CarregarDados();
            }

            return true;
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao salvar OS: {ex.Message}", "error");
            return false;
        }
    }

    private void MostrarNotificacao(string titulo, string mensagem, string tipo)
    {
        mensagemToast = mensagem;
        tipoToast = tipo;
        toastVisible = true;
    }

    private void ExcluirOS(OrdemDeServico os)
    {
        osParaExcluir = os;
        confirmacaoExclusaoVisible = true;
    }

    private async Task ConfirmarExclusao()
    {
        if (osParaExcluir != null)
        {
            try
            {
                await ApiService.DeleteOrdemDeServicoAsync(osParaExcluir.IDOS);
                MostrarNotificacao("Sucesso", "Ordem de Serviço excluída com sucesso!", "success");
                await CarregarDados();
            }
            catch (Exception ex)
            {
                MostrarNotificacao("Erro", $"Erro ao excluir OS: {ex.Message}", "error");
            }
            finally
            {
                osParaExcluir = null;
            }
        }
    }

    private void AbrirModalGerarOS()
    {
        modalGerarOSVisible = true;
    }

    private async Task ConfirmarGerarOS((DateTime DataInicio, DateTime DataFim) periodo)
    {
        try
        {
            var osCriadas = await ApiService.GerarOSAutomaticasAsync(periodo.DataInicio, periodo.DataFim);

            if (osCriadas.Count == 0)
            {
                MostrarNotificacao("Nenhuma OS gerada", "Não há ordens de serviço para gerar no período selecionado.", "warning");
            }
            else
            {
                MostrarNotificacao("Sucesso", $"Foram geradas {osCriadas.Count} ordens de serviço no período selecionado", "success");
            }

            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao gerar OS automáticas: {ex.Message}", "error");
        }
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Em Aberto" => "bg-yellow-100 text-yellow-800",
            "Em Andamento" => "bg-blue-100 text-blue-800",
            "Finalizada" => "bg-green-100 text-green-800",
            "Ocorrência" => "bg-purple-100 text-purple-800",
            "Reagendada" => "bg-orange-100 text-orange-800",
            "Cancelada" => "bg-red-100 text-red-800",
            _ => "bg-slate-100 text-slate-800"
        };
    }
