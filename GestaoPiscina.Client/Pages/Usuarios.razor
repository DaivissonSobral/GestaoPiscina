@page "/usuarios"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@inject ApiService ApiService

<AuthorizeView Permission="PodeGerenciarUsuarios" NotAuthorized="Você não tem permissão para gerenciar usuários.">
    <section class="p-4 space-y-6">
        <div >
            <!-- No celular vira um botão flutuante (FAB) redondo, fixo no canto inferior
                direito da tela; no desktop continua um botão normal no fluxo da página. -->
            <button @onclick="AbrirModalNovo" class="fixed bottom-6 right-6 z-20 w-14 h-14 rounded-full shadow-lg flex items-center justify-center text-lg
                                                    sm:static sm:z-auto sm:w-auto sm:h-auto sm:rounded-lg sm:shadow-none sm:block sm:px-4 sm:py-2 sm:text-base
                                                    bg-cyan-600 hover:bg-cyan-500 text-white transition-colors">
                <i class="fas fa-plus sm:mr-2"></i><span class="hidden sm:inline">Novo Usuário</span>
            </button>
        </div>

        <div class="flex space-x-2">
            <input type="text" @bind="termoBusca" @bind:event="oninput" placeholder="Buscar por nome, login ou e-mail..." class="flex-1 bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
        </div>

        @if (carregando)
        {
            <LoadingSpinner IsVisible="true" Message="Carregando usuários..." />
        }
        else if (usuariosFiltrados.Any())
        {
            <!-- Desktop: tabela tradicional (>= sm) -->
                <div class="hidden sm:block bg-slate-800 rounded-xl overflow-hidden overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-700">
                            <tr>
                                <th colspan="2" class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Nome</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Login / E-mail</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Perfil</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Ações</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700">
                            @foreach (var usuario in usuariosFiltrados)
                            {
                                <tr @onclick="() => AbrirModalEditar(usuario)" class="hover:bg-slate-700 cursor-pointer">
                                    <td class="w-[1%] pl-6 py-4 whitespace-nowrap">
                                        @if (!string.IsNullOrEmpty(usuario.FotoUrl))
                                        {
                                            <img src="@usuario.FotoUrl" alt="@usuario.Nome" class="w-8 h-8 rounded-full object-cover" />
                                        }
                                        else
                                        {
                                            <i class="fas fa-user-circle text-slate-500 text-2xl"></i>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-100">@usuario.Nome</td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm text-slate-300">@usuario.Login</div>
                                        <div class="text-sm text-slate-400">@usuario.Email</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@usuario.Perfil</td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="@(usuario.Ativo ? "bg-green-100 text-green-800" : "bg-slate-600 text-slate-300") px-2 py-1 text-xs font-semibold rounded-full">
                                            @(usuario.Ativo ? "Ativo" : "Inativo")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" @onclick:stopPropagation="true">
                                        <button @onclick="() => AbrirModalEditar(usuario)" class="text-cyan-400 hover:text-cyan-300 mr-3" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button @onclick="() => AbrirModalSenha(usuario)" class="text-yellow-400 hover:text-yellow-300 mr-3" title="Resetar Senha">
                                            <i class="fas fa-key"></i>
                                        </button>
                                        @if (usuario.Ativo)
                                        {
                                            <button @onclick="() => PedirDesativacao(usuario)" class="text-red-400 hover:text-red-300" title="Desativar">
                                                <i class="fas fa-user-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => Reativar(usuario)" class="text-green-400 hover:text-green-300" title="Reativar">
                                                <i class="fas fa-user-check"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Celular: cards soltos na página (sem painel externo envolvendo, como em
                     Clientes), com a coluna de ações sempre visível à direita, separada do
                     conteúdo por espaçamento e uma borda -->
                <div class="sm:hidden space-y-2">
                    @foreach (var usuario in usuariosFiltrados)
                    {
                        <div @onclick="() => AbrirModalEditar(usuario)" class="flex gap-4 p-4 rounded-xl bg-slate-700/40 hover:bg-slate-700/60 transition-colors cursor-pointer">
                            <div class="flex-1 min-w-0 space-y-1">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="text-sm font-medium text-slate-100 truncate">@usuario.Nome</div>
                                    @if (!string.IsNullOrEmpty(usuario.FotoUrl))
                                    {
                                        <img src="@usuario.FotoUrl" alt="@usuario.Nome" class="w-8 h-8 rounded-full object-cover shrink-0" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-circle text-slate-500 text-2xl shrink-0"></i>
                                    }
                                </div>
                                <div class="text-xs text-slate-400 truncate">@usuario.Login</div>
                                <div class="text-xs text-slate-400 truncate">@usuario.Email</div>
                                <div class="flex items-center justify-between gap-2">
                                    <div class="text-xs text-slate-500 truncate">@usuario.Perfil</div>
                                    <span class="@(usuario.Ativo ? "bg-green-100 text-green-800" : "bg-slate-600 text-slate-300") shrink-0 px-2 py-0.5 text-xs font-semibold rounded-full">
                                        @(usuario.Ativo ? "Ativo" : "Inativo")
                                    </span>
                                </div>
                            </div>
                            <div class="flex flex-col gap-3 items-center shrink-0 pt-1 pl-3 border-l border-slate-700" @onclick:stopPropagation="true">
                                <button @onclick="() => AbrirModalEditar(usuario)" class="text-cyan-400 hover:text-cyan-300" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button @onclick="() => AbrirModalSenha(usuario)" class="text-yellow-400 hover:text-yellow-300" title="Resetar Senha">
                                    <i class="fas fa-key"></i>
                                </button>
                                @if (usuario.Ativo)
                                {
                                    <button @onclick="() => PedirDesativacao(usuario)" class="text-red-400 hover:text-red-300" title="Desativar">
                                        <i class="fas fa-user-slash"></i>
                                    </button>
                                }
                                else
                                {
                                    <button @onclick="() => Reativar(usuario)" class="text-green-400 hover:text-green-300" title="Reativar">
                                        <i class="fas fa-user-check"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
        }
        else
        {
            <div class="bg-slate-800 rounded-xl p-8 text-center">
                <i class="fas fa-users text-4xl text-slate-600 mb-4"></i>
                <h4 class="text-lg font-medium text-slate-300 mb-2">Nenhum usuário encontrado</h4>
                <p class="text-slate-400">Clique em "Novo Usuário" para adicionar.</p>
            </div>
        }
    </section>

    <UsuarioModal @bind-IsVisible="modalVisible"
                  Usuario="usuarioSelecionado"
                  Perfis="perfis"
                  OnSave="SalvarUsuario" />

    <ResetarSenhaModal @bind-IsVisible="modalSenhaVisible"
                        Usuario="usuarioSelecionado"
                        OnSave="SalvarNovaSenha" />

    <ConfirmDialog @bind-IsVisible="confirmacaoDesativarVisible"
                   Title="Desativar Usuário"
                   Message="Tem certeza que deseja desativar este usuário? Ele perde o acesso ao sistema, mas o histórico dele é mantido."
                   ConfirmText="Desativar"
                   OnConfirm="ConfirmarDesativacao" />

    <Toast @bind-IsVisible="toastVisible"
           Title="Notificação"
           Message="@mensagemToast"
           Type="@tipoToast" />
</AuthorizeView>

@code {
    private List<UsuarioAdmin>? usuarios;
    private List<Perfil>? perfis;
    private UsuarioAdmin usuarioSelecionado = new UsuarioAdmin();
    private UsuarioAdmin? usuarioParaDesativar;
    private bool modalVisible;
    private bool modalSenhaVisible;
    private bool confirmacaoDesativarVisible;
    private bool carregando = true;
    private string termoBusca = "";
    private bool toastVisible;
    private string mensagemToast = "";
    private string tipoToast = "success";

    private IEnumerable<UsuarioAdmin> usuariosFiltrados => usuarios?.Where(u =>
        string.IsNullOrEmpty(termoBusca)
        || u.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)
        || u.Login.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)
        || u.Email.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)
    ) ?? Enumerable.Empty<UsuarioAdmin>();

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            carregando = true;
            var tarefaUsuarios = ApiService.GetUsuariosAdminAsync();
            var tarefaPerfis = ApiService.GetPerfisAsync();
            await Task.WhenAll(tarefaUsuarios, tarefaPerfis);
            usuarios = await tarefaUsuarios;
            perfis = await tarefaPerfis;
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao carregar usuários: {ex.Message}", "error");
            usuarios = new List<UsuarioAdmin>();
            perfis = new List<Perfil>();
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirModalNovo()
    {
        usuarioSelecionado = new UsuarioAdmin();
        modalVisible = true;
    }

    private void AbrirModalEditar(UsuarioAdmin usuario)
    {
        usuarioSelecionado = new UsuarioAdmin
        {
            IDUsuario = usuario.IDUsuario,
            Nome = usuario.Nome,
            Email = usuario.Email,
            Login = usuario.Login,
            IDPerfil = usuario.IDPerfil,
            Ativo = usuario.Ativo,
            FotoUrl = usuario.FotoUrl,
            Endereco = usuario.Endereco
        };
        modalVisible = true;
    }

    private void AbrirModalSenha(UsuarioAdmin usuario)
    {
        usuarioSelecionado = usuario;
        modalSenhaVisible = true;
    }

    private async Task SalvarUsuario(UsuarioAdmin usuario)
    {
        try
        {
            if (usuario.IDUsuario == 0)
            {
                await ApiService.CreateUsuarioAsync(usuario);
                MostrarNotificacao("Sucesso", "Usuário criado com sucesso!", "success");
            }
            else
            {
                await ApiService.UpdateUsuarioAsync(usuario);
                MostrarNotificacao("Sucesso", "Usuário atualizado com sucesso!", "success");
            }

            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao salvar usuário: {ex.Message}", "error");
        }
    }

    private async Task SalvarNovaSenha((int IDUsuario, string NovaSenha) dados)
    {
        try
        {
            await ApiService.ResetarSenhaUsuarioAsync(dados.IDUsuario, dados.NovaSenha);
            MostrarNotificacao("Sucesso", "Senha redefinida com sucesso!", "success");
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao redefinir senha: {ex.Message}", "error");
        }
    }

    private void PedirDesativacao(UsuarioAdmin usuario)
    {
        usuarioParaDesativar = usuario;
        confirmacaoDesativarVisible = true;
    }

    private async Task ConfirmarDesativacao()
    {
        if (usuarioParaDesativar == null)
        {
            return;
        }

        try
        {
            usuarioParaDesativar.Ativo = false;
            await ApiService.UpdateUsuarioAsync(usuarioParaDesativar);
            MostrarNotificacao("Sucesso", "Usuário desativado com sucesso!", "success");
            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao desativar usuário: {ex.Message}", "error");
        }
        finally
        {
            usuarioParaDesativar = null;
        }
    }

    private async Task Reativar(UsuarioAdmin usuario)
    {
        try
        {
            usuario.Ativo = true;
            await ApiService.UpdateUsuarioAsync(usuario);
            MostrarNotificacao("Sucesso", "Usuário reativado com sucesso!", "success");
            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao reativar usuário: {ex.Message}", "error");
        }
    }

    private void MostrarNotificacao(string titulo, string mensagem, string tipo)
    {
        mensagemToast = mensagem;
        tipoToast = tipo;
        toastVisible = true;
    }
}
