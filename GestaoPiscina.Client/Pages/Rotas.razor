@page "/rotas"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@implements IAsyncDisposable
@inject ApiService ApiService
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<section class="p-4 space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
            <div class="flex items-stretch bg-slate-700 border border-slate-600 rounded-lg overflow-hidden">
                <button @onclick="() => DefinirDataAsync(DateTime.Today)" class="@BotaoDataClasse(DateTime.Today) px-3 py-1.5 text-sm transition-colors">Hoje</button>
                <button @onclick="() => DefinirDataAsync(DateTime.Today.AddDays(1))" class="@BotaoDataClasse(DateTime.Today.AddDays(1)) px-3 py-1.5 text-sm transition-colors border-l border-slate-600">Amanhã</button>
                <input type="date" value="@dataSelecionada.ToString("yyyy-MM-dd")" @onchange="OnDataInputChangedAsync"
                       class="bg-transparent text-slate-100 text-sm px-3 py-1.5 border-l border-slate-600 focus:outline-none" />
            </div>
            <div class="relative">
                <!-- Abaixo de "sm", esse ícone ocupa o lugar do campo (que ficaria enorme
                     com o nome do técnico e quebraria de linha) — o <select> de verdade
                     continua ali, só invisível e cobrindo o mesmo espaço (opacity-0 +
                     inset-0), então clicar no ícone clica nele e abre o menu nativo com as
                     mesmas opções de sempre, com o texto completo. -->
                <div class="sm:hidden w-9 h-9 rounded-lg bg-slate-700 border border-slate-600 text-slate-100 flex items-center justify-center">
                    <i class="fas fa-user text-sm"></i>
                </div>
                <select @onchange="OnTecnicoSelecionadoChangedAsync"
                        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer sm:static sm:opacity-100 sm:w-auto sm:h-auto bg-slate-700 border border-slate-600 text-slate-100 text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-cyan-500">
                    <option value="" selected="@(tecnicoSelecionadoId == null)">Todos (Visão Geral)</option>
                    @foreach (var t in tecnicos.Where(TemLocalizacao))
                    {
                        <option value="@t.IDUsuario" selected="@(tecnicoSelecionadoId == t.IDUsuario)">@t.Nome (@t.Perfil)</option>
                    }
                </select>
            </div>
        </div>
        @if (clientesSemLocalizacao > 0 || tecnicosSemLocalizacao > 0)
        {
            <span class="text-amber-400 text-sm">@(clientesSemLocalizacao + tecnicosSemLocalizacao) sem localização</span>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 bg-slate-800 rounded-xl overflow-hidden border border-slate-700 relative">
            <div id="mapa-rotas" style="height: 560px; width: 100%;"></div>
            <button @onclick="AtualizarLocalizacoesAsync" disabled="@atualizandoLocalizacoes"
                    class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-slate-100 hover:bg-white disabled:opacity-60 shadow-md flex items-center justify-center transition-colors"
                    title="Atualizar localizações">
                <i class="fas @(atualizandoLocalizacoes ? "fa-spinner fa-spin" : "fa-sync-alt") text-slate-600 text-sm"></i>
            </button>
            @if (carregando)
            {
                <div class="absolute inset-0 bg-slate-800 flex items-center justify-center">
                    <LoadingSpinner IsVisible="true" Message="Carregando ordens de serviço..." />
                </div>
            }
        </div>

        <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 space-y-3 max-h-[560px] overflow-y-auto scroll-tema">
            @if (ExibirListaOrdensServico)
            {
                <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider">Ordens de Serviço</h3>
                @if (!carregando && !ordensDoDia.Any())
                {
                    <p class="text-slate-500 text-sm">Nenhuma OS agendada para esta data.</p>
                }
                @foreach (var os in ordensDoDia)
                {
                    <div class="bg-slate-700 rounded-lg p-3 text-xs">
                        <div class="flex items-start justify-between gap-2">
                            <span class="text-white font-bold">#@os.IDOS</span>
                            <span class="@GetStatusClass(os.Status) px-2 py-0.5 text-[10px] font-semibold rounded-full">@os.Status</span>
                        </div>
                        <div class="text-white font-medium truncate mt-1">@os.Piscina?.Cliente?.Nome</div>
                        <div class="text-slate-400 truncate">@os.Piscina?.Tipo · @os.Piscina?.Cliente?.Tipo</div>
                        @if (!string.IsNullOrEmpty(NomeTecnico(os)))
                        {
                            <div class="text-slate-400 truncate mt-1"><i class="fas fa-user-hard-hat mr-1"></i>@NomeTecnico(os)</div>
                        }
                        @if (os.Piscina?.Cliente != null && !TemLocalizacao(os.Piscina.Cliente))
                        {
                            <div class="text-amber-400 mt-1"><i class="fas fa-map-marker-alt mr-1"></i>Sem localização</div>
                        }
                    </div>
                }
            }

            @if (tecnicos.Any())
            {
                <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider pt-2 border-t border-slate-700">Técnicos e Supervisores</h3>
                @foreach (var tecnico in TecnicosOrdenados())
                {
                    var expandido = tecnicoSelecionadoId == tecnico.IDUsuario;
                    var concluido = RotaConfirmada(tecnico.IDUsuario);
                    <div class="bg-slate-700 rounded-lg overflow-hidden">
                        <button @onclick="() => AlternarAccordionTecnicoAsync(tecnico.IDUsuario)" class="w-full flex items-center gap-2 px-3 py-2 text-left hover:bg-slate-600/50 transition-colors">
                            @if (!string.IsNullOrEmpty(tecnico.FotoUrl))
                            {
                                <img src="@tecnico.FotoUrl" alt="@tecnico.Nome" class="w-8 h-8 rounded-full object-cover shrink-0" />
                            }
                            else
                            {
                                <i class="fas fa-user-circle text-slate-500 text-2xl shrink-0"></i>
                            }
                            <div class="min-w-0 flex-1">
                                <div class="text-white text-sm font-medium truncate">@tecnico.Nome</div>
                                <div class="text-slate-400 text-xs truncate">
                                    @tecnico.Perfil
                                    @if (concluido)
                                    {
                                        <span class="text-green-400">· Concluído</span>
                                    }
                                </div>
                            </div>
                            @if (!TemLocalizacao(tecnico))
                            {
                                <i class="fas fa-map-marker-alt text-amber-400 shrink-0" title="Sem localização"></i>
                            }
                            <i class="fas @(expandido ? "fa-chevron-up" : "fa-chevron-down") text-slate-400 text-xs shrink-0"></i>
                        </button>

                        @if (expandido && concluido)
                        {
                            var visitasConfirmadas = rotasConfirmadas[tecnico.IDUsuario];
                            var feitas = visitasConfirmadas.Count(v => v.Concluida);
                            <div class="px-3 pb-3 pt-1 space-y-2 border-t border-slate-600">
                                <div class="text-slate-400 text-[11px]">@feitas de @visitasConfirmadas.Count visitas concluídas</div>
                                <div class="space-y-1">
                                    @foreach (var visita in visitasConfirmadas)
                                    {
                                        <div class="flex items-center gap-2 bg-slate-800 rounded-lg px-2 py-1.5">
                                            <span class="w-5 h-5 rounded-full bg-green-600 text-white text-[10px] font-bold flex items-center justify-center shrink-0">@visita.Ordem</span>
                                            <div class="min-w-0 flex-1">
                                                <span class="text-white text-xs font-medium truncate block">@visita.NomeCliente</span>
                                            </div>
                                            <i class="fas @(visita.Concluida ? "fa-check-circle text-green-400" : "fa-clock text-amber-400") text-xs shrink-0" title="@(visita.Concluida ? "Visita concluída" : "Visita pendente")"></i>
                                        </div>
                                    }
                                </div>
                                <div class="flex gap-2">
                                    <button @onclick="() => EditarRotaConfirmadaAsync(tecnico.IDUsuario)" disabled="@(refazendoRotaId == tecnico.IDUsuario)" class="flex-1 bg-slate-600 hover:bg-slate-500 disabled:opacity-50 text-white text-xs py-1.5 rounded-md transition-colors">
                                        <i class="fas fa-pen mr-1"></i>Editar
                                    </button>
                                    <button @onclick="() => RefazerRotaConfirmadaAsync(tecnico.IDUsuario)" disabled="@(refazendoRotaId == tecnico.IDUsuario)" class="flex-1 bg-red-600 hover:bg-red-500 disabled:opacity-50 text-white text-xs py-1.5 rounded-md transition-colors">
                                        <i class="fas @(refazendoRotaId == tecnico.IDUsuario ? "fa-spinner fa-spin" : "fa-undo") mr-1"></i>@(refazendoRotaId == tecnico.IDUsuario ? "Desfazendo..." : "Refazer")
                                    </button>
                                </div>
                            </div>
                        }
                        else if (expandido)
                        {
                            <div class="px-3 pb-3 pt-1 space-y-2 border-t border-slate-600">
                                <div class="flex gap-2">
                                    <button @onclick="() => DefinirModoAsync(true)" class="@BotaoModoClasse(true) flex-1 text-xs py-1.5 rounded-md transition-colors">
                                        <i class="fas fa-magic mr-1"></i>Automática
                                    </button>
                                    <button @onclick="() => DefinirModoAsync(false)" class="@BotaoModoClasse(false) flex-1 text-xs py-1.5 rounded-md transition-colors">
                                        <i class="fas fa-hand-pointer mr-1"></i>Manual
                                    </button>
                                </div>

                                @{ var candidatos = CandidatosOrdenados(); }
                                @if (!candidatos.Any())
                                {
                                    <p class="text-slate-500 text-xs">Nenhum cliente com localização nesta data.</p>
                                }
                                else
                                {
                                    <div class="space-y-1">
                                        @foreach (var cliente in candidatos)
                                        {
                                            var selecionado = clientesSelecionadosIds.Contains(cliente.IDCliente);
                                            var ordem = selecionado && rotaCalculada?.Sucesso == true ? clientesSelecionadosIds.IndexOf(cliente.IDCliente) + 1 : (int?)null;
                                            <label class="flex items-center justify-between gap-2 bg-slate-800 rounded-lg px-2 py-1.5 cursor-pointer hover:bg-slate-600/50 transition-colors">
                                                <div class="flex items-center gap-2 min-w-0 flex-1">
                                                    <span class="w-8 h-8 rounded-full @(selecionado ? "bg-orange-500" : "bg-cyan-700") text-white text-sm font-bold flex items-center justify-center shrink-0">@Iniciais(cliente.Nome)</span>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="text-white text-xs font-medium truncate">@cliente.Nome</div>
                                                        <div class="text-slate-400 text-[11px] truncate">@PiscinasDoDia(cliente)</div>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-2 shrink-0">
                                                    @if (ordem != null)
                                                    {
                                                        <span class="w-5 h-5 rounded-full bg-cyan-600 text-white text-[10px] font-bold flex items-center justify-center">@ordem</span>
                                                    }
                                                    <input type="checkbox" checked="@selecionado"
                                                           @onchange="@(e => DefinirSelecaoClienteAsync(cliente.IDCliente, Convert.ToBoolean(e.Value)))"
                                                           class="w-4 h-4 accent-orange-500 cursor-pointer" />
                                                </div>
                                            </label>
                                        }
                                    </div>

                                    @if (clientesSelecionadosIds.Any())
                                    {
                                        <button @onclick="MontarRotaAsync" disabled="@calculandoRota" class="w-full bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 text-white text-xs py-1.5 rounded-md transition-colors">
                                            <i class="fas @(calculandoRota ? "fa-spinner fa-spin" : "fa-route") mr-1"></i>
                                            @(calculandoRota ? "Calculando..." : "Montar rota")
                                        </button>

                                        @if (rotaCalculada != null)
                                        {
                                            @if (rotaCalculada.Sucesso)
                                            {
                                                <div class="text-slate-300 text-xs">
                                                    <i class="fas fa-road mr-1"></i>@FormatarDistancia(rotaCalculada.DistanciaMetros) · @FormatarDuracao(rotaCalculada.DuracaoSegundos)
                                                </div>
                                                <button @onclick="ConfirmarAtribuicaoAsync" disabled="@confirmandoAtribuicao" class="w-full bg-green-600 hover:bg-green-500 disabled:opacity-50 text-white text-xs py-1.5 rounded-md transition-colors">
                                                    @(confirmandoAtribuicao ? "Salvando..." : "Confirmar atribuição")
                                                </button>
                                            }
                                            else
                                            {
                                                <p class="text-red-400 text-xs">Não foi possível montar a rota (@rotaCalculada.Erro).</p>
                                            }
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    [CascadingParameter] public MainLayout? MainLayout { get; set; }

    private List<OrdemDeServico> ordensDoDia = new();
    private List<Usuario> tecnicos = new();
    private bool carregando = true;
    private bool mapaIniciado;
    private bool precisaAjustarZoom = true;
    private bool atualizandoLocalizacoes;
    private int clientesSemLocalizacao;
    private int tecnicosSemLocalizacao;
    private DateTime dataSelecionada = DateTime.Today;
    private const string MapaId = "mapa-rotas";

    // Escondido por pedido do usuário — a lista de acordeões por técnico cobre o mesmo caso
    // de uso de forma mais direta. Mantido como flag (não removido) pra ser fácil reativar.
    private readonly bool ExibirListaOrdensServico = false;

    // Montagem de rota manual/automática por técnico. Os dois modos usam exatamente a mesma
    // lista de candidatos e o mesmo card de seleção (ver CandidatosOrdenados/markup) — a
    // única diferença é só qual conjunto de clientes já vem marcado ao entrar no modo.
    private DotNetObjectReference<Rotas>? dotNetRef;
    private int? tecnicoSelecionadoId;
    private bool modoAutomatico;
    private List<int> clientesSelecionadosIds = new();
    private RotaResultado? rotaCalculada;
    private bool calculandoRota;
    private bool confirmandoAtribuicao;
    private const int MetaClientesPorRota = 7;

    // Cache local das rotas confirmadas (persistidas via RotasController/RotaVisita — ver
    // ApiService.GetRotasAsync/SalvarRotaAsync) pra data em exibição: idTecnico -> clientes,
    // na ordem confirmada. Recarregado do servidor em CarregarDadosAsync a cada troca de
    // data, então sobrevive a um F5. Um técnico aqui dentro conta como "concluído" pra
    // ordenação do acordeão, mostra a lista em modo resumo (com botão Editar) em vez do
    // seletor, e seus clientes somem da lista de candidatos dos outros técnicos + ficam
    // verdes no mapa permanentemente.
    private readonly Dictionary<int, List<VisitaRota>> rotasConfirmadas = new();

    private bool RotaConfirmada(int idTecnico) => rotasConfirmadas.ContainsKey(idTecnico);

    private HashSet<int> TodosClientesConfirmados() => rotasConfirmadas.Values.SelectMany(vs => vs.Select(v => v.IDCliente)).ToHashSet();

    // Centro padrão do mapa (Fortaleza-CE) usado quando ainda não há nenhum marcador
    // posicionável — só serve de ponto de partida, o mapa se ajusta aos marcadores depois.
    private const double CentroPadraoLat = -3.7319;
    private const double CentroPadraoLng = -38.5267;

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        await CarregarDadosAsync();
    }

    private async Task DefinirDataAsync(DateTime data)
    {
        dataSelecionada = data.Date;
        await CancelarSelecaoAsync();
        await CarregarDadosAsync();
    }

    private async Task OnDataInputChangedAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var data))
        {
            await DefinirDataAsync(data);
        }
    }

    private string BotaoDataClasse(DateTime data) => data.Date == dataSelecionada.Date
        ? "bg-cyan-600 text-white"
        : "bg-slate-700 text-slate-300 hover:bg-slate-600";

    private async Task CarregarDadosAsync()
    {
        carregando = true;
        precisaAjustarZoom = true;
        StateHasChanged();
        try
        {
            var ordensTask = ApiService.GetOrdensDeServicoAsync();
            var tecnicosTask = ApiService.GetUsuariosAsync("Técnico,Supervisor");
            var rotasTask = ApiService.GetRotasAsync(dataSelecionada);
            await Task.WhenAll(ordensTask, tecnicosTask, rotasTask);

            ordensDoDia = ordensTask.Result
                .Where(os => os.DataExecucao.Date == dataSelecionada.Date && os.Status != "Cancelada")
                .OrderBy(os => os.HoraInicio)
                .ToList();
            tecnicos = tecnicosTask.Result;

            // Fonte de verdade das rotas confirmadas é o servidor (ver RotasController) —
            // recarregado a cada troca de data/atualização, não só guardado em memória, pra
            // sobreviver a um F5 e poder ser consultado depois.
            rotasConfirmadas.Clear();
            foreach (var rota in rotasTask.Result)
            {
                rotasConfirmadas[rota.IDUsuario] = rota.Visitas.OrderBy(v => v.Ordem).ToList();
            }

            clientesSemLocalizacao = ClientesDoDia().Count(c => !TemLocalizacao(c));
            tecnicosSemLocalizacao = tecnicos.Count(t => !TemLocalizacao(t));
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private List<Cliente> ClientesDoDia() => ordensDoDia
        .Select(os => os.Piscina?.Cliente)
        .Where(c => c != null)
        .GroupBy(c => c!.IDCliente)
        .Select(g => g.First()!)
        .ToList();

    private Usuario? TecnicoSelecionado => tecnicos.FirstOrDefault(t => t.IDUsuario == tecnicoSelecionadoId);

    // Pendentes (rota ainda não confirmada hoje, mesmo que já tenha OS) ficam no topo do
    // acordeão; quem já teve a rota confirmada nesta sessão desce pro final.
    private List<Usuario> TecnicosOrdenados() => tecnicos
        .OrderBy(t => RotaConfirmada(t.IDUsuario) ? 1 : 0)
        .ThenBy(t => t.Nome)
        .ToList();

    // Candidatos do dia (com localização) que ainda não foram confirmados pra outro técnico,
    // ordenados do mais próximo pro mais distante do técnico em montagem — usado tanto pelo
    // modo manual (lista completa pra marcar) quanto pelo automático (mesma lista, só que
    // com os mais próximos já vindo marcados). Um cliente já confirmado só continua
    // aparecendo pro próprio técnico dele (fluxo de "Editar").
    private List<Cliente> CandidatosOrdenados()
    {
        var confirmados = TodosClientesConfirmados();
        var candidatos = ClientesDoDia()
            .Where(TemLocalizacao)
            .Where(c => !confirmados.Contains(c.IDCliente) || clientesSelecionadosIds.Contains(c.IDCliente))
            .ToList();
        var tecnico = TecnicoSelecionado;
        if (tecnico != null && TemLocalizacao(tecnico))
        {
            return candidatos
                .OrderBy(c => DistanciaKm(tecnico.Latitude!.Value, tecnico.Longitude!.Value, c.Latitude!.Value, c.Longitude!.Value))
                .ToList();
        }
        return candidatos.OrderBy(c => c.Nome).ToList();
    }

    // Tipos de piscina que esse cliente tem hoje (ex.: "infantil, adulto") — mostrado no
    // card de seleção da rota pra ajudar a decidir sem precisar abrir a lista de OS ao lado.
    private string PiscinasDoDia(Cliente cliente)
    {
        var tipos = ordensDoDia
            .Where(os => os.Piscina?.Cliente?.IDCliente == cliente.IDCliente)
            .Select(os => os.Piscina?.Tipo)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct()
            .ToList();
        return tipos.Any() ? string.Join(", ", tipos) : "—";
    }

    private bool TemLocalizacao(Cliente cliente) => cliente.Latitude.HasValue && cliente.Longitude.HasValue;
    private bool TemLocalizacao(Usuario usuario) => usuario.Latitude.HasValue && usuario.Longitude.HasValue;

    // O <div id="mapa-rotas"> fica sempre montado no DOM (o estado "carregando" só desenha
    // um overlay por cima, não substitui o próprio card) — de propósito, porque só existe
    // uma janela segura pra chamar isso: depois que o elemento já está no DOM real, não no
    // meio da mesma cadeia de OnInitializedAsync (StateHasChanged não é síncrono; se o mapa
    // fosse escondido/recriado condicionalmente, mapaIniciado ficaria dessincronizado do
    // elemento de verdade). Chamado depois de todo re-render enquanto não está carregando —
    // idempotente (redesenha os marcadores do zero a cada chamada), então repetir é seguro.
    // Evita duas execuções de DesenharMapaAsync em paralelo: cada clique de seleção dispara
    // StateHasChanged (novo render -> nova chamada daqui), e como DesenharMapaAsync faz vários
    // awaits de JS interop em sequência (clearMarkers, N addMarker, fitToMarkers), um clique
    // rápido demais podia iniciar uma segunda passada de redesenho antes da primeira terminar
    // — as duas mexendo na mesma lista de marcadores ao mesmo tempo, embaralhando qual
    // clique de fechamento correspondia a qual cliente. Se já tem um redesenho rolando, só
    // marca que precisa redesenhar de novo assim que o atual terminar (não perde estado).
    private bool desenhando;
    private bool redesenhoPendente;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (carregando)
        {
            return;
        }
        if (desenhando)
        {
            redesenhoPendente = true;
            return;
        }

        desenhando = true;
        try
        {
            do
            {
                redesenhoPendente = false;
                await DesenharMapaAsync();
            } while (redesenhoPendente);
        }
        finally
        {
            desenhando = false;
        }
    }

    private async Task DesenharMapaAsync()
    {
        var apiKey = Configuration["GoogleMapsApiKey"];
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            return;
        }

        try
        {
            if (!mapaIniciado)
            {
                await JSRuntime.InvokeVoidAsync("gestaoPiscinaMaps.initMap", MapaId, apiKey, CentroPadraoLat, CentroPadraoLng, 12);
                mapaIniciado = true;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("gestaoPiscinaMaps.clearMarkers", MapaId);
            }

            var confirmados = TodosClientesConfirmados();
            foreach (var cliente in ClientesDoDia().Where(TemLocalizacao))
            {
                // Verde = rota já confirmada (permanente); laranja = marcado na seleção em
                // andamento, ainda não confirmado; ciano = sem seleção nenhuma.
                var cor = confirmados.Contains(cliente.IDCliente) ? "#16a34a"
                    : clientesSelecionadosIds.Contains(cliente.IDCliente) ? "#f97316"
                    : "#0891b2";
                await JSRuntime.InvokeVoidAsync("gestaoPiscinaMaps.addSelectableInitialsMarker", MapaId,
                    cliente.Latitude!.Value, cliente.Longitude!.Value, Iniciais(cliente.Nome), cliente.Nome, cor, dotNetRef, cliente.IDCliente);
            }

            foreach (var tecnico in tecnicos.Where(TemLocalizacao))
            {
                // Mesmo recurso usado pros clientes (iniciais desenhadas via canvas) — a
                // foto do técnico direto no marcador (addPhotoMarker) dependia de baixar a
                // imagem de outra origem, o que se mostrou frágil (CORS, cache do
                // navegador colidindo com a mesma foto já carregada na lista ao lado).
                await JSRuntime.InvokeVoidAsync("gestaoPiscinaMaps.addInitialsMarker", MapaId,
                    tecnico.Latitude!.Value, tecnico.Longitude!.Value, Iniciais(tecnico.Nome), $"{tecnico.Nome} ({tecnico.Perfil})", "#7c3aed");
            }

            // Só reajusta o zoom/enquadramento em cargas estruturais (data trocada, dados
            // recarregados) — não a cada clique de seleção, senão o mapa "pula" o tempo todo
            // enquanto o usuário está escolhendo os clientes da rota.
            if (precisaAjustarZoom)
            {
                await JSRuntime.InvokeVoidAsync("gestaoPiscinaMaps.fitToMarkers", MapaId);
                precisaAjustarZoom = false;
            }
        }
        catch
        {
            // Se o Google Maps falhar em carregar (chave inválida, sem internet etc.), a
            // lista ao lado do mapa continua funcionando normalmente.
        }
    }

    // Duas primeiras iniciais do nome do cliente (ex.: "Colégio Antares" -> "CA"; um nome só,
    // ex.: "Neo" -> "NE"), sempre em maiúsculas, pro marcador no mapa.
    private static string Iniciais(string nome)
    {
        var partes = (nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
        {
            return $"{partes[0][0]}{partes[1][0]}".ToUpper();
        }
        if (partes.Length == 1 && partes[0].Length >= 2)
        {
            return partes[0].Substring(0, 2).ToUpper();
        }
        return (partes.FirstOrDefault() ?? "?").ToUpper();
    }

    private string? NomeTecnico(OrdemDeServico os) => tecnicos.FirstOrDefault(u => u.IDUsuario == os.IDUsuario)?.Nome;

    private string GetStatusClass(string status) => status switch
    {
        "Em Aberto" => "bg-yellow-100 text-yellow-800",
        "Em Andamento" => "bg-blue-100 text-blue-800",
        "Finalizada" => "bg-green-100 text-green-800",
        "Ocorrência" => "bg-purple-100 text-purple-800",
        "Reagendada" => "bg-orange-100 text-orange-800",
        _ => "bg-slate-100 text-slate-800"
    };

    // Chamado pelo JS (marcador de cliente clicado no mapa — ver maps.js,
    // addSelectableInitialsMarker) pra alternar a seleção desse cliente na rota do técnico
    // em montagem. Fora do modo de montagem (nenhum técnico escolhido), não faz nada.
    [JSInvokable]
    public async Task OnClienteMarcadorClicado(int idCliente)
    {
        if (tecnicoSelecionadoId == null)
        {
            return;
        }

        // Cliente já confirmado pra outro técnico: não deixa reatribuir clicando no mapa
        // (precisa abrir a rota dele e usar "Editar" primeiro).
        if (TodosClientesConfirmados().Contains(idCliente) && !clientesSelecionadosIds.Contains(idCliente))
        {
            return;
        }

        await DefinirSelecaoClienteAsync(idCliente, !clientesSelecionadosIds.Contains(idCliente));
    }

    // Único caminho que marca/desmarca um cliente na rota — usado tanto pelo clique no mapa
    // quanto pela caixa de seleção do card na lista, então os dois ficam sempre em sincronia.
    private async Task DefinirSelecaoClienteAsync(int idCliente, bool selecionado)
    {
        if (selecionado)
        {
            if (!clientesSelecionadosIds.Contains(idCliente))
            {
                clientesSelecionadosIds.Add(idCliente);
            }
        }
        else
        {
            clientesSelecionadosIds.Remove(idCliente);
        }
        await LimparRotaAsync();
        StateHasChanged();
    }

    private async Task OnTecnicoSelecionadoChangedAsync(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        await SelecionarTecnicoAsync(string.IsNullOrEmpty(valor) ? (int?)null : int.Parse(valor));
    }

    // Cabeçalho do acordeão do técnico (ver markup): clicar de novo em quem já está expandido
    // fecha; clicar em outro troca — só um técnico fica com a rota em montagem por vez, tanto
    // faz se foi escolhido pelo campo de cima ou clicando no próprio acordeão.
    private async Task AlternarAccordionTecnicoAsync(int idTecnico)
    {
        await SelecionarTecnicoAsync(tecnicoSelecionadoId == idTecnico ? (int?)null : idTecnico);
    }

    private async Task SelecionarTecnicoAsync(int? idTecnico)
    {
        tecnicoSelecionadoId = idTecnico;
        modoAutomatico = false;
        clientesSelecionadosIds.Clear();
        await LimparRotaAsync();
        StateHasChanged();
    }

    private async Task CancelarSelecaoAsync()
    {
        await SelecionarTecnicoAsync(null);
    }

    // Tira o técnico do estado "confirmado" e devolve os clientes dele pra seleção ativa,
    // deixando editar como se estivesse montando a rota pela primeira vez.
    private async Task EditarRotaConfirmadaAsync(int idTecnico)
    {
        if (rotasConfirmadas.TryGetValue(idTecnico, out var visitasConfirmadas))
        {
            clientesSelecionadosIds = visitasConfirmadas.Select(v => v.IDCliente).ToList();
            rotasConfirmadas.Remove(idTecnico);
        }
        modoAutomatico = false;
        tecnicoSelecionadoId = idTecnico;
        await LimparRotaAsync();
        StateHasChanged();
    }

    private int? refazendoRotaId;

    // Diferente de "Editar" (só mexe no estado local até confirmar de novo), "Refazer"
    // desfaz a rota confirmada já no banco (DELETE api/rotas/tecnico/{id}) e devolve o
    // técnico pra seleção zerada, pra montar tudo de novo do zero.
    private async Task RefazerRotaConfirmadaAsync(int idTecnico)
    {
        refazendoRotaId = idTecnico;
        StateHasChanged();
        try
        {
            await ApiService.ExcluirRotaAsync(idTecnico, dataSelecionada);
            rotasConfirmadas.Remove(idTecnico);
            clientesSelecionadosIds = new List<int>();
            modoAutomatico = false;
            tecnicoSelecionadoId = idTecnico;
            await LimparRotaAsync();
        }
        catch (Exception ex)
        {
            ShowToast("Erro", ex.Message, "error");
        }
        finally
        {
            refazendoRotaId = null;
            StateHasChanged();
        }
    }

    // Alterna entre montar a rota escolhendo manualmente (lista/mapa em branco, você marca)
    // ou automaticamente (mesma lista, só que já vem com os mais próximos marcados).
    private async Task DefinirModoAsync(bool automatico)
    {
        modoAutomatico = automatico;
        clientesSelecionadosIds.Clear();
        if (automatico)
        {
            SugerirAutomaticamente();
        }
        await LimparRotaAsync();
        StateHasChanged();
    }

    private string BotaoModoClasse(bool automatico) => modoAutomatico == automatico
        ? "bg-cyan-600 text-white"
        : "bg-slate-600 text-slate-300 hover:bg-slate-500";

    private async Task LimparRotaAsync()
    {
        rotaCalculada = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("gestaoPiscinaMaps.limparRota", MapaId);
        }
        catch
        {
        }
    }

    // Marca, entre os candidatos do dia, os ~7 mais próximos do técnico em linha reta
    // (fórmula de Haversine) — só uma sugestão de partida; o usuário pode desmarcar/marcar
    // outros (checkbox do card ou clique no mapa) antes de montar a rota de verdade (que aí
    // sim usa a distância real de trajeto via Directions API).
    private void SugerirAutomaticamente()
    {
        var tecnico = TecnicoSelecionado;
        if (tecnico == null || !TemLocalizacao(tecnico))
        {
            return;
        }

        clientesSelecionadosIds = CandidatosOrdenados()
            .Take(MetaClientesPorRota)
            .Select(c => c.IDCliente)
            .ToList();
    }

    private static double DistanciaKm(double lat1, double lng1, double lat2, double lng2)
    {
        const double raioTerraKm = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLng = (lng2 - lng1) * Math.PI / 180;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) *
                Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        var c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        return raioTerraKm * c;
    }

    // Manda o técnico + clientes selecionados pro Google Directions (via JS interop), que
    // devolve a melhor ordem de visita (optimizeWaypoints) e desenha o trajeto no mapa.
    private async Task MontarRotaAsync()
    {
        var tecnico = TecnicoSelecionado;
        if (tecnico == null || !TemLocalizacao(tecnico) || !clientesSelecionadosIds.Any())
        {
            return;
        }

        var apiKey = Configuration["GoogleMapsApiKey"];
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            return;
        }

        calculandoRota = true;
        StateHasChanged();
        try
        {
            var clientesSelecionados = ClientesDoDia().Where(c => clientesSelecionadosIds.Contains(c.IDCliente)).ToList();
            var waypoints = clientesSelecionados.Select(c => new { lat = c.Latitude!.Value, lng = c.Longitude!.Value }).ToArray();

            var resultado = await JSRuntime.InvokeAsync<RotaResultado>("gestaoPiscinaMaps.calculateRoute", MapaId, apiKey,
                tecnico.Latitude!.Value, tecnico.Longitude!.Value, waypoints);

            rotaCalculada = resultado;
            if (resultado.Sucesso && resultado.Ordem != null)
            {
                clientesSelecionadosIds = resultado.Ordem.Select(indice => clientesSelecionados[indice].IDCliente).ToList();
            }
        }
        finally
        {
            calculandoRota = false;
            StateHasChanged();
        }
    }

    // Grava a atribuição decidida no mapa: as OS dos clientes selecionados (na data em
    // exibição) passam a ser do técnico escolhido, e a sequência de visita é persistida via
    // RotasController (RotaVisita) — permite consultar depois e acompanhar o andamento
    // comparando com o status das OS de cada cliente na mesma data.
    private async Task ConfirmarAtribuicaoAsync()
    {
        var tecnico = TecnicoSelecionado;
        if (tecnico == null || !clientesSelecionadosIds.Any())
        {
            return;
        }

        confirmandoAtribuicao = true;
        StateHasChanged();
        try
        {
            // Uma OS com ocorrência registrada não pode mais trocar de técnico (regra do
            // servidor — ver OrdensDeServicoController.PutOrdemDeServico): pula essas em vez
            // de tentar e contar como falha, mas o cliente continua fazendo parte da rota
            // (a sequência de visita não depende de todas as OS dele estarem editáveis).
            var osDosSelecionados = ordensDoDia
                .Where(os => os.Piscina?.Cliente != null && clientesSelecionadosIds.Contains(os.Piscina.Cliente.IDCliente))
                .ToList();
            var osParaAtualizar = osDosSelecionados.Where(os => os.Status != "Ocorrência").ToList();
            var osBloqueadas = osDosSelecionados.Count - osParaAtualizar.Count;

            var falhas = 0;
            foreach (var os in osParaAtualizar)
            {
                os.IDUsuario = tecnico.IDUsuario;
                try
                {
                    await ApiService.UpdateOrdemDeServicoAsync(os);
                }
                catch
                {
                    falhas++;
                }
            }

            try
            {
                await ApiService.SalvarRotaAsync(tecnico.IDUsuario, dataSelecionada, clientesSelecionadosIds);
            }
            catch (Exception ex)
            {
                ShowToast("Erro", $"OS atualizadas, mas não foi possível salvar a rota: {ex.Message}", "error");
                return;
            }

            if (falhas == 0 && osBloqueadas == 0)
            {
                ShowToast("Sucesso", $"Rota com {osParaAtualizar.Count} OS atribuída a {tecnico.Nome}.", "success");
            }
            else
            {
                var partes = new List<string>();
                if (falhas > 0)
                {
                    partes.Add($"{falhas} OS falharam ao atualizar");
                }
                if (osBloqueadas > 0)
                {
                    partes.Add($"{osBloqueadas} OS com ocorrência registrada não puderam trocar de técnico");
                }
                ShowToast("Atenção", $"Rota salva. {string.Join("; ", partes)}.", "warning");
            }

            await CancelarSelecaoAsync();
            await CarregarDadosAsync();
        }
        finally
        {
            confirmandoAtribuicao = false;
            StateHasChanged();
        }
    }

    private static string FormatarDistancia(double metros) => metros >= 1000 ? $"{metros / 1000:0.0} km" : $"{metros:0} m";

    private static string FormatarDuracao(double segundos)
    {
        var tempo = TimeSpan.FromSeconds(segundos);
        return tempo.TotalHours >= 1 ? $"{(int)tempo.TotalHours}h{tempo.Minutes:00}min" : $"{tempo.Minutes}min";
    }

    private void ShowToast(string title, string message, string type)
    {
        MainLayout?.ShowToast(title, message, type);
    }

    // Faz o backfill de Latitude/Longitude pra clientes e técnicos/supervisores que já
    // tinham endereço cadastrado antes deste recurso existir (por isso ainda não têm
    // coordenadas salvas) — sem isso eles nunca apareceriam no mapa.
    private async Task AtualizarLocalizacoesAsync()
    {
        var apiKey = Configuration["GoogleMapsApiKey"];
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            return;
        }

        atualizandoLocalizacoes = true;
        StateHasChanged();

        try
        {
            var clientes = await ApiService.GetClientesAsync();
            foreach (var cliente in clientes.Where(c => !string.IsNullOrWhiteSpace(c.Endereco) && !TemLocalizacao(c)))
            {
                var resultado = await JSRuntime.InvokeAsync<GeoResultado?>("gestaoPiscinaMaps.geocode", apiKey, cliente.Endereco);
                if (resultado == null)
                {
                    continue;
                }

                cliente.Latitude = resultado.Lat;
                cliente.Longitude = resultado.Lng;
                try
                {
                    await ApiService.UpdateClienteAsync(cliente);
                }
                catch
                {
                }
            }

            var usuariosAdmin = await ApiService.GetUsuariosAdminAsync();
            var perfisAlvo = new HashSet<string> { "Técnico", "Supervisor" };
            foreach (var usuario in usuariosAdmin.Where(u => perfisAlvo.Contains(u.Perfil) && !string.IsNullOrWhiteSpace(u.Endereco) && !u.Latitude.HasValue))
            {
                var resultado = await JSRuntime.InvokeAsync<GeoResultado?>("gestaoPiscinaMaps.geocode", apiKey, usuario.Endereco);
                if (resultado == null)
                {
                    continue;
                }

                usuario.Latitude = resultado.Lat;
                usuario.Longitude = resultado.Lng;
                try
                {
                    await ApiService.UpdateUsuarioAsync(usuario);
                }
                catch
                {
                }
            }

            await CarregarDadosAsync();
        }
        finally
        {
            atualizandoLocalizacoes = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        try
        {
            await JSRuntime.InvokeVoidAsync("gestaoPiscinaMaps.limparRota", MapaId);
        }
        catch
        {
        }
    }
