@page "/gestores"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@inject ApiService ApiService

<section class="p-4 space-y-6">
    <div>
        <button @onclick="AbrirModalNovo" class="bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
            <i class="fas fa-plus mr-2"></i>Novo Gestor
        </button>
    </div>

    <div class="flex justify-end space-x-2">
        <button @onclick="SetListView"
                class="@GetListViewButtonClass()"
                title="Lista">
            <i class="fas fa-list"></i>
        </button>
        <button @onclick="SetCardsView"
                class="@GetCardsViewButtonClass()"
                title="Cards">
            <i class="fas fa-th-large"></i>
        </button>
    </div>

    @if (carregando)
    {
        <LoadingSpinner IsVisible="true" Message="Carregando gestores..." />
    }
    else if (gestores != null && gestores.Any())
    {
        @if (viewMode == "cards")
        {
            <GestorCards Gestores="gestores"
                         Clientes="clientes"
                         GestorExpandidoId="gestorExpandidoId"
                         @bind-ClienteParaVincularId="clienteParaVincularId"
                         OnEdit="AbrirModalEditar"
                         OnDelete="ExcluirGestor"
                         OnToggleVinculos="ToggleVinculos"
                         OnVincular="VincularCliente"
                         OnDesvincular="DesvincularClienteVinculo" />
        }
        else
        {
        <!-- Desktop: tabela tradicional (>= sm) -->
        <div class="hidden sm:block bg-slate-800 rounded-xl overflow-hidden overflow-x-auto">
            <table class="w-full">
                    <thead class="bg-slate-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Nome</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Telefone</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Clientes Vinculados</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        @foreach (var gestor in gestores)
                        {
                            <tr @onclick="() => AbrirModalEditar(gestor)" class="hover:bg-slate-700 cursor-pointer">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-100">@gestor.Nome</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@gestor.Telefone</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@gestor.Email</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="@(gestor.Ativo ? "bg-green-100 text-green-800" : "bg-slate-100 text-slate-800") inline-flex px-2 py-1 text-xs font-semibold rounded-full">
                                        @(gestor.Ativo ? "Ativo" : "Inativo")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">
                                    @(gestor.GestorClientes.Count) cliente(s)
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" @onclick:stopPropagation="true">
                                    <button @onclick="() => ToggleVinculos(gestor)" class="text-blue-400 hover:text-blue-300 mr-3" title="Gerenciar clientes vinculados">
                                        <i class="fas fa-link"></i>
                                    </button>
                                    <button @onclick="() => AbrirModalEditar(gestor)" class="text-cyan-400 hover:text-cyan-300 mr-3" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button @onclick="() => ExcluirGestor(gestor)" class="text-red-400 hover:text-red-300" title="Excluir">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            @if (gestorExpandidoId == gestor.IDGestor)
                            {
                                <tr class="bg-slate-900">
                                    <td colspan="6" class="px-6 py-4">
                                        @RenderVinculos(gestor)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
        </div>

        <!-- Celular: cards soltos na página (sem painel externo envolvendo), com a coluna de
             ações sempre visível à direita, separada do conteúdo por espaçamento e uma borda -->
        <div class="sm:hidden space-y-2">
            @foreach (var gestor in gestores)
            {
                <div class="rounded-xl bg-slate-700/40 overflow-hidden">
                    <div @onclick="() => AbrirModalEditar(gestor)" class="flex gap-4 p-4 hover:bg-slate-700/60 transition-colors cursor-pointer">
                        <div class="flex-1 min-w-0 space-y-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="text-sm font-medium text-slate-100 truncate">@gestor.Nome</div>
                                <span class="@(gestor.Ativo ? "bg-green-100 text-green-800" : "bg-slate-100 text-slate-800") px-2 py-0.5 text-xs font-semibold rounded-full shrink-0">
                                    @(gestor.Ativo ? "Ativo" : "Inativo")
                                </span>
                            </div>
                            <div class="text-xs text-slate-400 truncate">@gestor.Telefone</div>
                            <div class="text-xs text-slate-400 truncate">@gestor.Email</div>
                            <div class="text-xs text-slate-500">@(gestor.GestorClientes.Count) cliente(s) vinculado(s)</div>
                        </div>
                        <div class="flex flex-col gap-3 items-center shrink-0 pt-1 pl-3 border-l border-slate-700" @onclick:stopPropagation="true">
                            <button @onclick="() => ToggleVinculos(gestor)" class="text-blue-400 hover:text-blue-300" title="Gerenciar clientes vinculados">
                                <i class="fas fa-link"></i>
                            </button>
                            <button @onclick="() => AbrirModalEditar(gestor)" class="text-cyan-400 hover:text-cyan-300" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button @onclick="() => ExcluirGestor(gestor)" class="text-red-400 hover:text-red-300" title="Excluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    @if (gestorExpandidoId == gestor.IDGestor)
                    {
                        <div class="bg-slate-900 p-4" @onclick:stopPropagation="true">
                            @RenderVinculos(gestor)
                        </div>
                    }
                </div>
            }
        </div>
        }
    }
    else
    {
        <div class="bg-slate-800 rounded-xl p-8 text-center">
            <i class="fas fa-user-tie text-4xl text-slate-600 mb-4"></i>
            <h4 class="text-lg font-medium text-slate-300 mb-2">Nenhum gestor cadastrado</h4>
            <p class="text-slate-400">Clique em "Novo Gestor" para adicionar.</p>
        </div>
    }
</section>

<GestorModal @bind-IsVisible="modalVisible"
             Gestor="gestorSelecionado"
             OnSave="SalvarGestor" />

<ConfirmDialog @bind-IsVisible="confirmacaoExclusaoVisible"
               Title="Confirmar Exclusão"
               Message="Tem certeza que deseja excluir este gestor?"
               ConfirmText="Excluir"
               OnConfirm="ConfirmarExclusao" />

<Toast @bind-IsVisible="toastVisible"
       Title="Notificação"
       Message="@mensagemToast"
       Type="@tipoToast" />

@code {
    private List<Gestor>? gestores;
    private List<Cliente>? clientes;
    private Gestor gestorSelecionado = new Gestor();
    private Gestor? gestorParaExcluir;
    private bool modalVisible = false;
    private bool confirmacaoExclusaoVisible = false;
    private bool carregando = true;
    private int? gestorExpandidoId;
    private int clienteParaVincularId;
    private string viewMode = "cards";
    private bool toastVisible = false;
    private string mensagemToast = "";
    private string tipoToast = "success";

    private void SetListView()
    {
        viewMode = "lista";
    }

    private void SetCardsView()
    {
        viewMode = "cards";
    }

    private string GetListViewButtonClass() =>
        viewMode == "lista"
            ? "px-3 py-2 rounded-lg transition-colors bg-cyan-600 text-white"
            : "px-3 py-2 rounded-lg transition-colors bg-slate-700 text-slate-300 hover:bg-slate-600";

    private string GetCardsViewButtonClass() =>
        viewMode == "cards"
            ? "px-3 py-2 rounded-lg transition-colors bg-cyan-600 text-white"
            : "px-3 py-2 rounded-lg transition-colors bg-slate-700 text-slate-300 hover:bg-slate-600";

    private async Task DesvincularClienteVinculo((Gestor Gestor, GestorCliente Vinculo) args)
    {
        await DesvincularCliente(args.Gestor, args.Vinculo);
    }

    // Painel de "clientes vinculados" da visão em Lista — usado tanto na linha expandida da
    // tabela (desktop) quanto no card expandido (celular), para não duplicar o markup.
    private RenderFragment RenderVinculos(Gestor gestor) => @<div class="space-y-3">
        <h5 class="text-sm font-semibold text-slate-200">Clientes vinculados a @gestor.Nome</h5>
        @if (gestor.GestorClientes.Any())
        {
            <ul class="space-y-1">
                @foreach (var vinculo in gestor.GestorClientes)
                {
                    <li class="flex justify-between items-center bg-slate-800 rounded-lg px-3 py-2">
                        <span class="text-sm text-slate-200">@vinculo.Cliente?.Nome</span>
                        <button @onclick="() => DesvincularCliente(gestor, vinculo)" class="text-red-400 hover:text-red-300 text-sm">
                            <i class="fas fa-unlink mr-1"></i>Desvincular
                        </button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-sm text-slate-400">Nenhum cliente vinculado.</p>
        }

        <div class="flex flex-col sm:flex-row gap-2 pt-2">
            <select @bind="clienteParaVincularId" class="flex-1 min-w-0 bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                <option value="0">Selecione um cliente para vincular...</option>
                @if (clientes != null)
                {
                    @foreach (var cliente in clientes.Where(c => gestor.GestorClientes.All(gc => gc.IDCliente != c.IDCliente)))
                    {
                        <option value="@cliente.IDCliente">@cliente.Nome</option>
                    }
                }
            </select>
            <button @onclick="() => VincularCliente(gestor)" class="bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                Vincular
            </button>
        </div>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            carregando = true;
            gestores = await ApiService.GetGestoresAsync();
            clientes = await ApiService.GetClientesAsync();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao carregar gestores: {ex.Message}", "error");
            gestores = new List<Gestor>();
            clientes = new List<Cliente>();
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirModalNovo()
    {
        gestorSelecionado = new Gestor();
        modalVisible = true;
    }

    private void AbrirModalEditar(Gestor gestor)
    {
        gestorSelecionado = new Gestor
        {
            IDGestor = gestor.IDGestor,
            Nome = gestor.Nome,
            Telefone = gestor.Telefone,
            Email = gestor.Email,
            Ativo = gestor.Ativo,
            DataCadastro = gestor.DataCadastro
        };
        modalVisible = true;
    }

    private async Task SalvarGestor(Gestor gestor)
    {
        try
        {
            if (gestor.IDGestor == 0)
            {
                await ApiService.CreateGestorAsync(gestor);
                MostrarNotificacao("Sucesso", "Gestor criado com sucesso!", "success");
            }
            else
            {
                await ApiService.UpdateGestorAsync(gestor);
                MostrarNotificacao("Sucesso", "Gestor atualizado com sucesso!", "success");
            }

            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao salvar gestor: {ex.Message}", "error");
        }
    }

    private void ExcluirGestor(Gestor gestor)
    {
        gestorParaExcluir = gestor;
        confirmacaoExclusaoVisible = true;
    }

    private async Task ConfirmarExclusao()
    {
        if (gestorParaExcluir != null)
        {
            try
            {
                await ApiService.DeleteGestorAsync(gestorParaExcluir.IDGestor);
                MostrarNotificacao("Sucesso", "Gestor excluído com sucesso!", "success");
                await CarregarDados();
            }
            catch (Exception ex)
            {
                MostrarNotificacao("Erro", $"Erro ao excluir gestor: {ex.Message}", "error");
            }
            finally
            {
                gestorParaExcluir = null;
            }
        }
    }

    private void ToggleVinculos(Gestor gestor)
    {
        gestorExpandidoId = gestorExpandidoId == gestor.IDGestor ? null : gestor.IDGestor;
        clienteParaVincularId = 0;
    }

    private async Task VincularCliente(Gestor gestor)
    {
        if (clienteParaVincularId <= 0)
        {
            MostrarNotificacao("Erro", "Selecione um cliente para vincular.", "error");
            return;
        }

        try
        {
            await ApiService.VincularGestorClienteAsync(gestor.IDGestor, clienteParaVincularId);
            MostrarNotificacao("Sucesso", "Cliente vinculado com sucesso!", "success");
            clienteParaVincularId = 0;
            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao vincular cliente: {ex.Message}", "error");
        }
    }

    private async Task DesvincularCliente(Gestor gestor, GestorCliente vinculo)
    {
        try
        {
            await ApiService.DesvincularGestorClienteAsync(gestor.IDGestor, vinculo.IDCliente);
            MostrarNotificacao("Sucesso", "Cliente desvinculado com sucesso!", "success");
            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao desvincular cliente: {ex.Message}", "error");
        }
    }

    private void MostrarNotificacao(string titulo, string mensagem, string tipo)
    {
        mensagemToast = mensagem;
        tipoToast = tipo;
        toastVisible = true;
    }
}
