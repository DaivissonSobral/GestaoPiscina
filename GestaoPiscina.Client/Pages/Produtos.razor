@page "/produtos"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@inject ApiService ApiService

<section class="p-4 space-y-6">
    <div>
        <button @onclick="AbrirModalNovo" class="bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
            <i class="fas fa-plus mr-2"></i>Novo Produto
        </button>
    </div>

    <div class="flex space-x-2">
        <input type="text" @bind="termoBusca" @bind:event="oninput" placeholder="Buscar produtos..." class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
    </div>

    @if (carregando)
    {
        <LoadingSpinner IsVisible="true" Message="Carregando produtos..." />
    }
    else if (produtosFiltrados.Any())
    {
        <div class="bg-slate-800 rounded-xl overflow-hidden">
            <!-- Desktop: tabela tradicional (>= sm) -->
            <div class="hidden sm:block overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Produto</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Concentração</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Unidade</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        @foreach (var produto in produtosFiltrados)
                        {
                            <tr @onclick="() => AbrirModalEditar(produto)" class="hover:bg-slate-700 cursor-pointer">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-100">@produto.Nome</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">
                                    @(produto.Concentracao.HasValue ? $"{produto.Concentracao}%" : "-")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@produto.Unidade</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" @onclick:stopPropagation="true">
                                    <button @onclick="() => AbrirModalEditar(produto)" class="text-cyan-400 hover:text-cyan-300 mr-3" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button @onclick="() => ExcluirProduto(produto)" class="text-red-400 hover:text-red-300" title="Excluir">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Celular: cards com a coluna de ações sempre visível à direita, em vez de
                 rolar horizontalmente até sumir como aconteceria numa tabela estreita -->
            <div class="sm:hidden divide-y divide-slate-700">
                @foreach (var produto in produtosFiltrados)
                {
                    <div @onclick="() => AbrirModalEditar(produto)" class="flex gap-3 p-4 hover:bg-slate-700/50 cursor-pointer">
                        <div class="flex-1 min-w-0 space-y-1">
                            <div class="text-sm font-medium text-slate-100 truncate">@produto.Nome</div>
                            <div class="grid grid-cols-2 gap-x-3 text-sm text-slate-300">
                                <div>@(produto.Concentracao.HasValue ? $"{produto.Concentracao}%" : "-")</div>
                                <div class="text-right text-slate-400">@produto.Unidade</div>
                            </div>
                        </div>
                        <div class="flex flex-col gap-3 items-center shrink-0 pt-1" @onclick:stopPropagation="true">
                            <button @onclick="() => AbrirModalEditar(produto)" class="text-cyan-400 hover:text-cyan-300" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button @onclick="() => ExcluirProduto(produto)" class="text-red-400 hover:text-red-300" title="Excluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="bg-slate-800 rounded-xl p-8 text-center">
            <i class="fas fa-flask text-4xl text-slate-600 mb-4"></i>
            <h4 class="text-lg font-medium text-slate-300 mb-2">Nenhum produto cadastrado</h4>
            <p class="text-slate-400">Clique em "Novo Produto" para adicionar.</p>
        </div>
    }
</section>

<ProdutoModal @bind-IsVisible="modalVisible"
              Produto="produtoSelecionado"
              OnSave="SalvarProduto" />

<ConfirmDialog @bind-IsVisible="confirmacaoExclusaoVisible"
               Title="Confirmar Exclusão"
               Message="Tem certeza que deseja excluir este produto?"
               ConfirmText="Excluir"
               OnConfirm="ConfirmarExclusao" />

<Toast @bind-IsVisible="toastVisible"
       Title="Notificação"
       Message="@mensagemToast"
       Type="@tipoToast" />

@code {
    private List<Produto>? produtos;
    private Produto produtoSelecionado = new Produto();
    private Produto? produtoParaExcluir;
    private bool modalVisible = false;
    private bool confirmacaoExclusaoVisible = false;
    private bool carregando = true;
    private string termoBusca = "";
    private bool toastVisible = false;
    private string mensagemToast = "";
    private string tipoToast = "success";

    private IEnumerable<Produto> produtosFiltrados => produtos?.Where(p =>
        string.IsNullOrEmpty(termoBusca) || p.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase)
    ) ?? Enumerable.Empty<Produto>();

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            carregando = true;
            produtos = await ApiService.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao carregar produtos: {ex.Message}", "error");
            produtos = new List<Produto>();
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirModalNovo()
    {
        produtoSelecionado = new Produto();
        modalVisible = true;
    }

    private void AbrirModalEditar(Produto produto)
    {
        produtoSelecionado = new Produto
        {
            IDProduto = produto.IDProduto,
            Nome = produto.Nome,
            Concentracao = produto.Concentracao,
            Unidade = produto.Unidade
        };
        modalVisible = true;
    }

    private async Task SalvarProduto(Produto produto)
    {
        try
        {
            if (produto.IDProduto == 0)
            {
                await ApiService.CreateProdutoAsync(produto);
                MostrarNotificacao("Sucesso", "Produto criado com sucesso!", "success");
            }
            else
            {
                await ApiService.UpdateProdutoAsync(produto);
                MostrarNotificacao("Sucesso", "Produto atualizado com sucesso!", "success");
            }

            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao salvar produto: {ex.Message}", "error");
        }
    }

    private void ExcluirProduto(Produto produto)
    {
        produtoParaExcluir = produto;
        confirmacaoExclusaoVisible = true;
    }

    private async Task ConfirmarExclusao()
    {
        if (produtoParaExcluir != null)
        {
            try
            {
                await ApiService.DeleteProdutoAsync(produtoParaExcluir.IDProduto);
                MostrarNotificacao("Sucesso", "Produto excluído com sucesso!", "success");
                await CarregarDados();
            }
            catch (Exception ex)
            {
                MostrarNotificacao("Erro", $"Erro ao excluir produto: {ex.Message}", "error");
            }
            finally
            {
                produtoParaExcluir = null;
            }
        }
    }

    private void MostrarNotificacao(string titulo, string mensagem, string tipo)
    {
        mensagemToast = mensagem;
        tipoToast = tipo;
        toastVisible = true;
    }
}
