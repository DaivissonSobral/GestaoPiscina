@page "/checklist-conformidade"
@using GestaoPiscina.Client.Models

<section class="p-4 space-y-6">
    <h2 class="text-2xl font-semibold text-slate-100">Checklist de Conformidade</h2>

    <div class="bg-slate-800 rounded-xl p-6 shadow-md space-y-6">
        <!-- cabeçalho com informações da vistoria -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm text-slate-400">Nome do cliente:</label>
                <input class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" @bind="ClienteNome" />
            </div>
            <div>
                <label class="block text-sm text-slate-400">Data da vistoria:</label>
                <input type="date" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" @bind="DataVistoria" />
            </div>
            <div>
                <label class="block text-sm text-slate-400">Responsável pela vistoria:</label>
                <input class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" @bind="Responsavel" />
            </div>
            <div>
                <label class="block text-sm text-slate-400">Unidade/Local:</label>
                <input class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" @bind="UnidadeLocal" />
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm text-slate-400">Responsável técnico (se houver):</label>
                <input class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" @bind="ResponsavelTecnico" />
            </div>
        </div>

        <!-- tabela de itens -->
        <div class="overflow-x-auto">
            <table class="w-full table-auto text-sm text-slate-100">
                <thead class="bg-slate-700">
                    <tr>
                        <th class="px-3 py-2">Conformidade</th>
                        <th class="px-3 py-2">Descrição</th>
                        <th class="px-3 py-2">Classificação esperada</th>
                        <th class="px-3 py-2">Classificação obtida</th>
                        <th class="px-3 py-2">Status</th>
                        <th class="px-3 py-2">Observação</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700">
                    @foreach (var item in checklistItems)
                    {
                        <tr class="hover:bg-slate-700">
                            <td class="px-3 py-2 text-center">
                                <input type="checkbox" class="form-checkbox h-4 w-4 text-green-500" @bind="item.Confirmed" />
                            </td>
                            <td class="px-3 py-2">@item.Description</td>
                            <td class="px-3 py-2 text-center">@item.ExpectedPoints</td>
                            <td class="px-3 py-2 text-center">
                                <input type="number" min="0" class="w-16 bg-slate-700 border border-slate-600 rounded-lg px-1 py-1 text-slate-100 text-center" @bind="item.ObtainedPoints" />
                            </td>
                            <td class="px-3 py-2">
                                <select class="bg-slate-700 border border-slate-600 rounded-lg px-2 py-1 text-slate-100" @bind="item.Status">
                                    <option value=""></option>
                                    <option value="Aprovado">Aprovado</option>
                                    <option value="Recusado">Recusado</option>
                                </select>
                            </td>
                            <td class="px-3 py-2">
                                <input type="text" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-2 py-1 text-slate-100" @bind="item.Observation" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button @onclick="SalvarChecklist" class="mt-6 bg-green-600 hover:bg-green-500 text-white px-6 py-2 rounded-lg transition-colors">
            <i class="fas fa-save mr-2"></i>Salvar checklist
        </button>

        @if (mensagemSalvo != null)
        {
            <div class="mt-4 p-4 bg-green-700 text-white rounded-lg">
                @mensagemSalvo
            </div>
        }
    </div>
</section>

