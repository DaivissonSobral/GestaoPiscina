@page "/piscinas"
@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@inject ApiService ApiService

<section class="p-4 space-y-6">
    <div>
        <!-- No celular vira um botão flutuante (FAB) redondo, fixo no canto inferior
             direito da tela; no desktop continua um botão normal no fluxo da página. -->
        <button @onclick="AbrirModalNovo" class="fixed bottom-6 right-6 z-20 w-14 h-14 rounded-full shadow-lg flex items-center justify-center text-lg
                                                   sm:static sm:z-auto sm:w-auto sm:h-auto sm:rounded-lg sm:shadow-none sm:block sm:px-4 sm:py-2 sm:text-base
                                                   bg-cyan-600 hover:bg-cyan-500 text-white transition-colors">
            <i class="fas fa-plus sm:mr-2"></i><span class="hidden sm:inline">Nova Piscina</span>
        </button>
    </div>

    <div class="flex space-x-2">
        <input type="text" @bind="termoBusca" @bind:event="oninput" placeholder="Buscar piscinas..." class="flex-1 bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
        <select @bind="filtroTipo" class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
            <option value="">Todos os Tipos</option>
            <option value="adulto">Adulto</option>
            <option value="espelho">Espelho d'água</option>
            <option value="fonte">Fonte</option>
            <option value="hidromassagem">Hidromassagem/Hidro</option>
            <option value="infantil">Infantil</option>
            <option value="interligada">Interligada</option>
            <option value="parque-aquatico">Parque aquático</option>
            <option value="semiolimpica">Semiolímpica</option>
        </select>
    </div>

    @if (carregando)
    {
        <LoadingSpinner IsVisible="true" Message="Carregando piscinas..." />
    }
    else if (piscinasFiltradas.Any())
    {
        <!-- Desktop: tabela tradicional (>= sm) -->
        <div class="hidden sm:block bg-slate-800 rounded-xl overflow-hidden overflow-x-auto">
            <table class="w-full">
                    <thead class="bg-slate-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Cliente</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Tipo</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Volume</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Localização</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Periodicidade</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-slate-300 uppercase tracking-wider">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        @foreach (var piscina in piscinasFiltradas)
                        {
                            <tr @onclick="() => AbrirModalEditar(piscina)" class="hover:bg-slate-700 cursor-pointer">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-slate-100">@piscina.Cliente?.Nome</div>
                                    <div class="text-sm text-slate-400">@piscina.Cliente?.Tipo</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="@GetTipoClass(piscina.Tipo) px-2 py-1 text-xs font-semibold rounded-full">
                                        @NomeTipo(piscina.Tipo)
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@piscina.VolumeM3 m³</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@(string.IsNullOrEmpty(piscina.Localizacao) ? "-" : piscina.Localizacao)</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300">@(DescricaoRecorrencia(piscina) ?? "Não se repete")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" @onclick:stopPropagation="true">
                                    <button @onclick="() => AbrirModalEditar(piscina)" class="text-cyan-400 hover:text-cyan-300 mr-3" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button @onclick="() => ExcluirPiscina(piscina)" class="text-red-400 hover:text-red-300" title="Excluir">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
        </div>

        <!-- Celular: cards soltos na página (sem painel externo envolvendo), com a coluna de
             ações sempre visível à direita, em vez de rolar horizontalmente até sumir como
             aconteceria numa tabela estreita -->
        <div class="sm:hidden space-y-2">
            @foreach (var piscina in piscinasFiltradas)
            {
                <div @onclick="() => AbrirModalEditar(piscina)" class="flex gap-4 p-4 rounded-xl bg-slate-700/40 hover:bg-slate-700/60 transition-colors cursor-pointer">
                    <div class="flex-1 min-w-0 space-y-1">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <div class="text-sm font-medium text-slate-100 truncate">@piscina.Cliente?.Nome</div>
                                <div class="text-xs text-slate-400 truncate">@piscina.Cliente?.Tipo</div>
                            </div>
                            <span class="@GetTipoClass(piscina.Tipo) px-2 py-0.5 text-xs font-semibold rounded-full shrink-0">
                                @NomeTipo(piscina.Tipo)
                            </span>
                        </div>
                        <div class="grid grid-cols-2 gap-x-3 text-sm text-slate-300">
                            <div>@piscina.VolumeM3 m³</div>
                            <div class="text-right text-slate-400 truncate">@(string.IsNullOrEmpty(piscina.Localizacao) ? "-" : piscina.Localizacao)</div>
                        </div>
                        <div class="text-xs text-slate-400">@(DescricaoRecorrencia(piscina) ?? "Não se repete")</div>
                    </div>
                    <div class="flex flex-col gap-3 items-center shrink-0 pt-1 pl-3 border-l border-slate-700" @onclick:stopPropagation="true">
                        <button @onclick="() => AbrirModalEditar(piscina)" class="text-cyan-400 hover:text-cyan-300" title="Editar">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button @onclick="() => ExcluirPiscina(piscina)" class="text-red-400 hover:text-red-300" title="Excluir">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-slate-800 rounded-xl p-8 text-center">
            <i class="fas fa-swimming-pool text-4xl text-slate-600 mb-4"></i>
            <h4 class="text-lg font-medium text-slate-300 mb-2">Nenhuma piscina encontrada</h4>
            <p class="text-slate-400">Clique em "Nova Piscina" para adicionar.</p>
        </div>
    }
</section>

<PiscinaModal @bind-IsVisible="modalVisible"
              Piscina="piscinaSelecionada"
              Clientes="clientes"
              OnSave="SalvarPiscina" />

<ConfirmDialog @bind-IsVisible="confirmacaoExclusaoVisible"
               Title="Confirmar Exclusão"
               Message="Tem certeza que deseja excluir esta piscina?"
               ConfirmText="Excluir"
               OnConfirm="ConfirmarExclusao" />

<Toast @bind-IsVisible="toastVisible"
       Title="Notificação"
       Message="@mensagemToast"
       Type="@tipoToast" />

@code {
    private List<Piscina>? piscinas;
    private List<Cliente>? clientes;
    private Piscina piscinaSelecionada = new Piscina();
    private Piscina? piscinaParaExcluir;
    private bool modalVisible = false;
    private bool confirmacaoExclusaoVisible = false;
    private bool carregando = true;
    private string termoBusca = "";
    private string filtroTipo = "";
    private bool toastVisible = false;
    private string mensagemToast = "";
    private string tipoToast = "success";

    private IEnumerable<Piscina> piscinasFiltradas => piscinas?.Where(p =>
        (string.IsNullOrEmpty(termoBusca) ||
            p.Cliente?.Nome?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true ||
            NomeTipo(p.Tipo).Contains(termoBusca, StringComparison.OrdinalIgnoreCase) ||
            p.Localizacao?.Contains(termoBusca, StringComparison.OrdinalIgnoreCase) == true) &&
        (string.IsNullOrEmpty(filtroTipo) || p.Tipo == filtroTipo)
    ) ?? Enumerable.Empty<Piscina>();

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        try
        {
            carregando = true;
            var piscinasTask = ApiService.GetPiscinasAsync();
            var clientesTask = ApiService.GetClientesAsync();

            await Task.WhenAll(piscinasTask, clientesTask);
            piscinas = await piscinasTask;
            clientes = await clientesTask;
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao carregar piscinas: {ex.Message}", "error");
            piscinas = new List<Piscina>();
            clientes = new List<Cliente>();
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirModalNovo()
    {
        piscinaSelecionada = new Piscina();
        modalVisible = true;
    }

    private void AbrirModalEditar(Piscina piscina)
    {
        piscinaSelecionada = new Piscina
        {
            IDPiscina = piscina.IDPiscina,
            IDCliente = piscina.IDCliente,
            Tipo = piscina.Tipo,
            VolumeM3 = piscina.VolumeM3,
            Localizacao = piscina.Localizacao,
            Coberta = piscina.Coberta,
            Aquecida = piscina.Aquecida,
            RecorrenciaFrequencia = piscina.RecorrenciaFrequencia,
            RecorrenciaIntervalo = piscina.RecorrenciaIntervalo,
            RecorrenciaDiasSemana = piscina.RecorrenciaDiasSemana,
            RecorrenciaDataInicio = piscina.RecorrenciaDataInicio,
            RecorrenciaTermino = piscina.RecorrenciaTermino,
            RecorrenciaDataFim = piscina.RecorrenciaDataFim,
            RecorrenciaOcorrencias = piscina.RecorrenciaOcorrencias
        };
        modalVisible = true;
    }

    private async Task SalvarPiscina(Piscina piscina)
    {
        try
        {
            if (piscina.IDPiscina == 0)
            {
                await ApiService.CreatePiscinaAsync(piscina);
                MostrarNotificacao("Sucesso", "Piscina criada com sucesso!", "success");
            }
            else
            {
                await ApiService.UpdatePiscinaAsync(piscina);
                MostrarNotificacao("Sucesso", "Piscina atualizada com sucesso!", "success");
            }

            await CarregarDados();
        }
        catch (Exception ex)
        {
            MostrarNotificacao("Erro", $"Erro ao salvar piscina: {ex.Message}", "error");
        }
    }

    private void ExcluirPiscina(Piscina piscina)
    {
        piscinaParaExcluir = piscina;
        confirmacaoExclusaoVisible = true;
    }

    private async Task ConfirmarExclusao()
    {
        if (piscinaParaExcluir != null)
        {
            try
            {
                await ApiService.DeletePiscinaAsync(piscinaParaExcluir.IDPiscina);
                MostrarNotificacao("Sucesso", "Piscina excluída com sucesso!", "success");
                await CarregarDados();
            }
            catch (Exception ex)
            {
                MostrarNotificacao("Erro", $"Erro ao excluir piscina: {ex.Message}", "error");
            }
            finally
            {
                piscinaParaExcluir = null;
            }
        }
    }

    private void MostrarNotificacao(string titulo, string mensagem, string tipo)
    {
        mensagemToast = mensagem;
        tipoToast = tipo;
        toastVisible = true;
    }

    private string NomeTipo(string tipo) => tipo switch
    {
        "adulto" => "Adulto",
        "espelho" => "Espelho d'água",
        "fonte" => "Fonte",
        "hidromassagem" => "Hidromassagem/Hidro",
        "infantil" => "Infantil",
        "interligada" => "Interligada",
        "parque-aquatico" => "Parque aquático",
        "semiolimpica" => "Semiolímpica",
        _ => tipo
    };

    private string GetTipoClass(string tipo) => tipo switch
    {
        "adulto" => "bg-blue-100 text-blue-800",
        "espelho" => "bg-purple-100 text-purple-800",
        "fonte" => "bg-amber-100 text-amber-800",
        "hidromassagem" => "bg-teal-100 text-teal-800",
        "infantil" => "bg-green-100 text-green-800",
        "interligada" => "bg-indigo-100 text-indigo-800",
        "parque-aquatico" => "bg-orange-100 text-orange-800",
        "semiolimpica" => "bg-cyan-100 text-cyan-800",
        _ => "bg-slate-100 text-slate-800"
    };

    private string? DescricaoRecorrencia(Piscina piscina)
    {
        if (piscina.RecorrenciaFrequencia == "Nenhuma")
        {
            return null;
        }

        var intervalo = piscina.RecorrenciaIntervalo;
        string baseTexto;

        switch (piscina.RecorrenciaFrequencia)
        {
            case "Diaria":
                baseTexto = intervalo <= 1 ? "Diariamente" : $"A cada {intervalo} dias";
                break;
            case "Semanal":
                var dias = string.IsNullOrWhiteSpace(piscina.RecorrenciaDiasSemana) ? "" : $" ({piscina.RecorrenciaDiasSemana.Replace(",", ", ")})";
                baseTexto = (intervalo <= 1 ? "Semanalmente" : $"A cada {intervalo} semanas") + dias;
                break;
            case "Mensal":
                baseTexto = intervalo <= 1 ? "Mensalmente" : $"A cada {intervalo} meses";
                break;
            default:
                return null;
        }

        return baseTexto;
    }
}
