@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@implements IDisposable
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<div id="app-topbar" class="flex justify-between items-center p-4 border-b border-slate-700">
    <div class="flex items-center gap-3">
        <button @onclick="() => MainLayout?.ToggleMobileMenu()" class="md:hidden text-slate-300 hover:text-white transition-colors" title="Abrir menu">
            <i class="fas fa-bars text-xl"></i>
        </button>
        <div class="text-xl font-bold">@PageTitle</div>
    </div>
    <div class="flex items-center space-x-4 text-xl">
        <!-- Botão de Notificação -->
        <button class="hover:text-cyan-400 transition-colors">
            <i class="fas fa-bell"></i>
        </button>

        <!-- Avatar e Menu do Usuário -->
        @if (currentUser != null)
        {
            <div class="relative">
                <button @onclick="ToggleUserMenu" class="flex items-center space-x-2 text-slate-300 hover:text-slate-100 transition-colors">
                    @if (!string.IsNullOrEmpty(currentUser.FotoUrl))
                    {
                        <img src="@currentUser.FotoUrl" alt="Foto de perfil" class="w-8 h-8 rounded-full object-cover" />
                    }
                    else
                    {
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                        </svg>
                    }
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </button>

                @if (showUserMenu)
                {
                    <div class="absolute right-0 mt-2 w-56 bg-slate-800 rounded-lg shadow-lg border border-slate-700 z-50 text-base">
                        <div class="px-4 py-3 border-b border-slate-700">
                            <p class="text-sm text-slate-400">Olá,</p>
                            <p class="font-medium text-slate-100 truncate">@PrimeiroNome</p>
                        </div>
                        <div class="py-1">
                            <button @onclick="AbrirPerfil" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-slate-100 transition-colors">
                                <div class="flex items-center space-x-2">
                                    <i class="fas fa-user w-4"></i>
                                    <span>Perfil</span>
                                </div>
                            </button>
                            <button @onclick="AbrirTrocarSenha" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-slate-100 transition-colors">
                                <div class="flex items-center space-x-2">
                                    <i class="fas fa-key w-4"></i>
                                    <span>Trocar minha senha</span>
                                </div>
                            </button>
                        </div>
                        <div class="py-1 border-t border-slate-700">
                            <button @onclick="HandleLogout" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-slate-100 transition-colors">
                                <div class="flex items-center space-x-2">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"/>
                                    </svg>
                                    <span>Sair</span>
                                </div>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Fallback para quando não há usuário logado -->
            <button class="hover:text-cyan-400 transition-colors">
                <i class="fas fa-user-circle"></i>
            </button>
        }
    </div>
</div>

<UsuarioModal @bind-IsVisible="modalPerfilVisible"
              Usuario="usuarioPerfil"
              Perfis="perfis"
              ModoPerfil="true"
              PodeEditarCamposSensiveis="@PodeGerenciarUsuarios"
              OnPerfilSalvo="OnPerfilSalvo" />

<ResetarSenhaModal @bind-IsVisible="modalSenhaVisible"
                    ModoAutoServico="true"
                    OnSenhaAlterada="OnSenhaAlterada" />

@code {
    [Parameter] public string PageTitle { get; set; } = "Painel de Manutenção";
    [CascadingParameter] public MainLayout? MainLayout { get; set; }

    private UsuarioInfo? currentUser;
    private bool showUserMenu = false;

    private List<Perfil>? perfis;
    private UsuarioAdmin usuarioPerfil = new();
    private bool modalPerfilVisible;
    private bool modalSenhaVisible;

    private string PrimeiroNome => (currentUser?.Nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    private bool PodeGerenciarUsuarios => currentUser?.Permissoes != null
        && currentUser.Permissoes.TryGetValue("PodeGerenciarUsuarios", out var pode) && pode;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    // Sem isso, trocar a foto/dados em "Perfil" não atualizaria o avatar aqui sem um novo
    // login — AtualizarUsuarioCacheAsync já grava o cache novo, só falta recarregar e
    // re-renderizar quando o evento dispara.
    private async void OnAuthenticationStateChanged()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task AbrirPerfil()
    {
        showUserMenu = false;

        if (perfis == null)
        {
            try
            {
                perfis = await ApiService.GetPerfisAsync();
            }
            catch
            {
                perfis = new List<Perfil>();
            }
        }

        usuarioPerfil = new UsuarioAdmin
        {
            IDUsuario = currentUser!.IDUsuario,
            Nome = currentUser.Nome,
            Email = currentUser.Email,
            Login = currentUser.Login,
            IDPerfil = currentUser.IDPerfil,
            FotoUrl = currentUser.FotoUrl,
            Endereco = currentUser.Endereco
        };
        modalPerfilVisible = true;
    }

    private async Task OnPerfilSalvo(UsuarioInfo atualizado)
    {
        await AuthService.AtualizarUsuarioCacheAsync(atualizado);
        MainLayout?.ShowToast("Sucesso", "Perfil atualizado com sucesso!", "success");
    }

    private void AbrirTrocarSenha()
    {
        showUserMenu = false;
        modalSenhaVisible = true;
    }

    private Task OnSenhaAlterada()
    {
        MainLayout?.ShowToast("Sucesso", "Senha alterada com sucesso!", "success");
        return Task.CompletedTask;
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        showUserMenu = false;
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
