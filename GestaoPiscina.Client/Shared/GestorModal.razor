@using GestaoPiscina.Client.Models

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-50 flex items-center justify-center z-50 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 rounded-xl p-6 w-full max-w-md mx-4">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-slate-100">
                @(Gestor.IDGestor > 0 ? "Editar Gestor" : "Novo Gestor")
            </h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="border-t border-slate-700"></div>

        <EditForm Model="Gestor" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Nome *</label>
                    <InputText @bind-Value="Gestor.Nome" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
                    <ValidationMessage For="@(() => Gestor.Nome)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Telefone *</label>
                    <InputText @bind-Value="Gestor.Telefone" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
                    <ValidationMessage For="@(() => Gestor.Telefone)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Email *</label>
                    <InputText @bind-Value="Gestor.Email" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
                    <ValidationMessage For="@(() => Gestor.Email)" class="text-red-500 text-sm" />
                </div>

                <div class="flex items-center">
                    <InputCheckbox @bind-Value="Gestor.Ativo" class="mr-2" />
                    <label class="text-sm font-medium text-slate-300">Ativo</label>
                </div>
            </div>

            <div class="flex space-x-3 mt-6">
                <button type="submit" class="flex-1 bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas fa-save mr-2"></i>Salvar
                </button>
                <button type="button" @onclick="Close" class="flex-1 bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded-lg text-white transition-colors">
                    Cancelar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Gestor Gestor { get; set; } = new Gestor();
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<Gestor> OnSave { get; set; }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Gestor);
        await Close();
    }
}
