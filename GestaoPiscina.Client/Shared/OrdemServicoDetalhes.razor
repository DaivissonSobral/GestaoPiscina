@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Services
@inject NavigationManager Navigation
@inject ApiService ApiService
@inject AuthService AuthService
@inject IJSRuntime JSRuntime

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-50 flex sm:items-start justify-center z-50 sm:pt-8 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 w-full h-full sm:h-auto sm:rounded-xl sm:max-w-4xl sm:mx-4 sm:max-h-[90vh] flex flex-col">
        <div class="flex justify-between items-center p-6 pb-4 shrink-0">
            <h3 class="text-lg font-semibold text-slate-100">
                Detalhes da Ordem de Serviço #@OrdemDeServico.IDOS
            </h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="border-t border-slate-700"></div>

        <div class="flex-1 overflow-y-auto px-6 pb-4 scroll-tema">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4 md:row-span-2">
                <div class="bg-slate-700 rounded-lg p-4">
                    <h4 class="text-md font-semibold text-slate-200 mb-3">Dados Gerais</h4>
                    <div class="space-y-2">
                        <div class="flex justify-between">
                            <span class="text-slate-400">OS:</span>
                            <span class="text-slate-100 font-medium">#@OrdemDeServico.IDOS</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Data de Execução:</span>
                            <span class="text-slate-100">@OrdemDeServico.DataExecucao.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Status:</span>
                            <span class="@GetStatusClass(OrdemDeServico.Status)">@OrdemDeServico.Status</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Início / Término:</span>
                            <span class="text-slate-100">@OrdemDeServico.HoraInicio.ToString("HH:mm") - @OrdemDeServico.HoraTermino.ToString("HH:mm")</span>
                        </div>
                    </div>
                </div>

                @if (OrdemDeServico.Piscina != null)
                {
                    <div class="bg-slate-700 rounded-lg p-4">
                        <h4 class="text-md font-semibold text-slate-200 mb-3">Informações da Piscina</h4>
                        <div class="space-y-2">
                            <div class="flex justify-between">
                                <span class="text-slate-400">Cliente:</span>
                                <span class="text-slate-100">@OrdemDeServico.Piscina.Cliente?.Nome</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Tipo:</span>
                                <span class="text-slate-100">@OrdemDeServico.Piscina.Tipo</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Volume:</span>
                                <span class="text-slate-100">@OrdemDeServico.Piscina.VolumeLitros L</span>
                            </div>
                            @if (!string.IsNullOrEmpty(OrdemDeServico.Piscina.Localizacao))
                            {
                                <div class="flex justify-between">
                                    <span class="text-slate-400">Localização:</span>
                                    <span class="text-slate-100">@OrdemDeServico.Piscina.Localizacao</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="bg-slate-700 rounded-lg p-4">
                    <h4 class="text-md font-semibold text-slate-200 mb-3">Parâmetros da Água</h4>
                    <div class="space-y-2">
                        <div class="flex justify-between">
                            <span class="text-slate-400">pH:</span>
                            <span class="text-slate-100">@OrdemDeServico.pH</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Alcalinidade:</span>
                            <span class="text-slate-100">@OrdemDeServico.Alcalinidade ppm</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Cloro Livre:</span>
                            <span class="text-slate-100">@OrdemDeServico.CloroLivre ppm</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">Dureza Cálcica:</span>
                            <span class="text-slate-100">@OrdemDeServico.DurezaCalcica ppm</span>
                        </div>
                    </div>
                </div>

                <div class="bg-slate-700 rounded-lg p-4">
                    <h4 class="text-md font-semibold text-slate-200 mb-3">Dosagem</h4>
                    @if (dosagensAtuais.Any())
                    {
                        <div class="space-y-2">
                            @foreach (var dosagem in dosagensAtuais)
                            {
                                <div class="flex justify-between">
                                    <span class="text-slate-400">@dosagem.Produto?.Nome:</span>
                                    <span class="text-slate-100">@dosagem.Quantidade.ToString("0.##") @dosagem.Produto?.Unidade</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-slate-400 text-sm">Nenhum produto dosado.</p>
                    }
                </div>
            </div>

            <div class="order-last md:order-none bg-slate-700 rounded-lg p-4">
                <h4 class="text-md font-semibold text-slate-200 mb-3"><i class="fas fa-route mr-2 text-cyan-400"></i>Rota</h4>
                <RotaOSWidget MapaId="mapa-rota-os-detalhes"
                              Visivel="IsVisible"
                              TecnicoLat="RotaTecnicoLat"
                              TecnicoLng="RotaTecnicoLng"
                              TecnicoNome="Tecnico?.Nome"
                              ClienteLat="OrdemDeServico.Piscina?.Cliente?.Latitude"
                              ClienteLng="OrdemDeServico.Piscina?.Cliente?.Longitude"
                              ClienteNome="OrdemDeServico.Piscina?.Cliente?.Nome" />
            </div>

            <div class="space-y-4">
                @if (!string.IsNullOrEmpty(OrdemDeServico.Observacoes))
                {
                    <div class="bg-slate-700 rounded-lg p-4">
                        <h4 class="text-md font-semibold text-slate-200 mb-3">Observação</h4>
                        <p class="text-slate-300 text-sm leading-relaxed">@OrdemDeServico.Observacoes</p>
                    </div>
                }

                <div class="bg-slate-700 rounded-lg p-4">
                    <h4 class="text-md font-semibold text-slate-200 mb-3">Checklist</h4>
                    <div class="space-y-2">
                        @if (!ChecklistItensAplicaveis.Any())
                        {
                            <p class="text-sm text-slate-500">Nenhum item de checklist obrigatório para este tipo de cliente/piscina.</p>
                        }
                        @foreach (var item in ChecklistItensAplicaveis)
                        {
                            var marcado = ChecklistMarcados.Contains(item.Chave);
                            <div class="flex items-start space-x-2">
                                <i class="fas @(marcado ? "fa-check-circle text-green-400" : "fa-times-circle text-red-400") mt-0.5"></i>
                                <span class="text-sm @(marcado ? "text-slate-300" : "text-slate-500")">@item.Texto</span>
                            </div>
                        }
                        <div class="flex items-start space-x-2 pt-1 border-t border-slate-600">
                            <i class="fas @(ParametrosAguaPreenchidos ? "fa-check-circle text-green-400" : "fa-times-circle text-red-400") mt-0.5"></i>
                            <span class="text-sm @(ParametrosAguaPreenchidos ? "text-slate-300" : "text-slate-500")">
                                @(ParametrosAguaPreenchidos ? "Parâmetros da água informados." : "Parâmetros da água ainda não informados.")
                            </span>
                        </div>
                        <div class="flex items-start space-x-2">
                            <i class="fas @(FotosCompletas ? "fa-check-circle text-green-400" : "fa-times-circle text-red-400") mt-0.5"></i>
                            <span class="text-sm @(FotosCompletas ? "text-slate-300" : "text-slate-500")">
                                @(FotosCompletas ? "Fotos de antes e depois anexadas." : "Fotos de antes e depois ainda não anexadas.")
                            </span>
                        </div>
                        <div class="flex items-start space-x-2">
                            <i class="fas @(dosagensAtuais.Any() ? "fa-check-circle text-green-400" : "fa-times-circle text-red-400") mt-0.5"></i>
                            <span class="text-sm @(dosagensAtuais.Any() ? "text-slate-300" : "text-slate-500")">
                                @(dosagensAtuais.Any() ? TextoDosagemAplicada : "Nenhum produto dosado ainda.")
                            </span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(OrdemDeServico.FotosAntes) || !string.IsNullOrEmpty(OrdemDeServico.FotosDepois))
                {
                    <div class="bg-slate-700 rounded-lg p-4 space-y-4">
                        <h4 class="text-md font-semibold text-slate-200">Fotos</h4>

                        @if (!string.IsNullOrEmpty(OrdemDeServico.FotosAntes))
                        {
                            <div>
                                <h5 class="text-sm font-medium text-slate-300 mb-2">Antes</h5>
                                <div class="grid grid-cols-2 gap-2">
                                    @foreach (var foto in OrdemDeServico.FotosAntes.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(4))
                                    {
                                        <div class="aspect-square bg-slate-600 rounded-lg flex items-center justify-center">
                                            <img src="@foto.Trim()" alt="Foto antes" class="w-full h-full object-cover rounded-lg"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="hidden w-full h-full items-center justify-center text-slate-400 text-xs">
                                                <i class="fas fa-image mr-2"></i>Foto não disponível
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(OrdemDeServico.FotosDepois))
                        {
                            <div>
                                <h5 class="text-sm font-medium text-slate-300 mb-2">Depois</h5>
                                <div class="grid grid-cols-2 gap-2">
                                    @foreach (var foto in OrdemDeServico.FotosDepois.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(4))
                                    {
                                        <div class="aspect-square bg-slate-600 rounded-lg flex items-center justify-center">
                                            <img src="@foto.Trim()" alt="Foto depois" class="w-full h-full object-cover rounded-lg"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="hidden w-full h-full items-center justify-center text-slate-400 text-xs">
                                                <i class="fas fa-image mr-2"></i>Foto não disponível
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (OrdemDeServico.Status == "Ocorrência" || !string.IsNullOrEmpty(OrdemDeServico.FotosOcorrencias))
                {
                    <div class="bg-purple-950/20 border border-purple-800 rounded-lg p-4 space-y-3">
                        <h4 class="text-md font-semibold text-purple-300">
                            <i class="fas fa-exclamation-triangle mr-1"></i>Ocorrência
                        </h4>

                        <div class="flex justify-between">
                            <span class="text-slate-400">Aprovador:</span>
                            <span class="text-slate-100">@NomeAprovador()</span>
                        </div>

                        @if (OrdemDeServico.OcorrenciaAprovada)
                        {
                            <div class="flex justify-between">
                                <span class="text-slate-400">Aprovada em:</span>
                                <span class="text-green-400"><i class="fas fa-check-circle mr-1"></i>@OrdemDeServico.DataAprovacaoOcorrencia?.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                        else if (OrdemDeServico.OcorrenciaReprovada)
                        {
                            <div class="flex justify-between">
                                <span class="text-slate-400">Reprovada em:</span>
                                <span class="text-red-400"><i class="fas fa-times-circle mr-1"></i>@OrdemDeServico.DataReprovacaoOcorrencia?.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(OrdemDeServico.FotosOcorrencias))
                        {
                            <div>
                                <h5 class="text-sm font-medium text-slate-300 mb-2">Foto</h5>
                                <div class="grid grid-cols-2 gap-2">
                                    @foreach (var foto in OrdemDeServico.FotosOcorrencias.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(4))
                                    {
                                        <div class="aspect-square bg-slate-600 rounded-lg flex items-center justify-center">
                                            <img src="@foto.Trim()" alt="Foto da ocorrência" class="w-full h-full object-cover rounded-lg"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="hidden w-full h-full items-center justify-center text-slate-400 text-xs">
                                                <i class="fas fa-image mr-2"></i>Foto não disponível
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        </div>

        @if (!string.IsNullOrEmpty(erroAprovacao) || !string.IsNullOrEmpty(erroReprovacao))
        {
            <p class="text-red-400 text-xs px-3 sm:px-6 pt-2">@(erroAprovacao ?? erroReprovacao)</p>
        }

        <div class="flex flex-nowrap items-center gap-1.5 sm:gap-3 px-3 sm:px-6 py-3 sm:py-4 border-t border-slate-700 shrink-0">
            @if (AguardandoDecisaoDoAprovador)
            {
                <button @onclick="AprovarOcorrenciaAsync" disabled="@(aprovando || reprovando)" class="flex-1 min-w-0 whitespace-nowrap bg-green-600 hover:bg-green-500 disabled:opacity-50 px-2 sm:px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas fa-check mr-1 sm:mr-2"></i>@(aprovando ? "Aprovando..." : "Aprovar")
                </button>
                <button @onclick="ReprovarOcorrenciaAsync" disabled="@(aprovando || reprovando)" class="flex-1 min-w-0 whitespace-nowrap bg-red-600 hover:bg-red-500 disabled:opacity-50 px-2 sm:px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas fa-times mr-1 sm:mr-2"></i>@(reprovando ? "Reprovando..." : "Reprovar")
                </button>
            }
            else
            {
                <button @onclick="IniciarEEditarAsync" disabled="@capturandoLocalizacao" class="flex-[2] min-w-0 whitespace-nowrap bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 px-2 sm:px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas @(capturandoLocalizacao ? "fa-spinner fa-spin" : "fa-edit") mr-1 sm:mr-2"></i>@(capturandoLocalizacao ? "Localizando..." : TextoBotaoEditar())
                </button>
                @if (OrdemDeServico.Status is not ("Finalizada" or "Cancelada" or "Ocorrência"))
                {
                    <button @onclick="() => cancelarModalVisible = true" class="flex-1 min-w-0 whitespace-nowrap bg-red-600 hover:bg-red-500 px-2 sm:px-4 py-2 rounded-lg text-white transition-colors">
                        <i class="fas fa-ban mr-1 sm:mr-2"></i>Cancelar
                    </button>
                }
                @if (PodeVerRelatorio)
                {
                    <button @onclick="AbrirRelatorio" class="shrink-0 w-11 h-11 flex items-center justify-center bg-teal-600 hover:bg-teal-500 rounded-lg text-white text-lg transition-colors" title="Relatório">
                        <i class="fas fa-print"></i>
                    </button>
                }
            }
            <button @onclick="Close" class="shrink-0 w-11 h-11 flex items-center justify-center bg-slate-600 hover:bg-slate-500 rounded-lg text-white text-lg transition-colors" title="Fechar">
                <i class="fas fa-door-open"></i>
            </button>
        </div>
    </div>

    <CancelarOSModal @bind-IsVisible="cancelarModalVisible" OrdemDeServico="OrdemDeServico" OnCancelado="OnOSCancelada" />
</div>

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-70 flex items-center justify-center z-[60] @(hodometroModalVisible ? "" : "hidden")">
    <div class="bg-slate-800 rounded-xl p-6 w-full max-w-sm mx-4">
        <h4 class="text-slate-100 font-semibold mb-1">Iniciar Percurso</h4>
        <p class="text-slate-400 text-xs mb-3">Tire uma foto do hodômetro antes de sair para o cliente.</p>
        <UploadFotos Label="Foto do Hodômetro" @bind-Urls="OrdemDeServico.FotoHodometro" />
        @if (!string.IsNullOrEmpty(erroHodometro))
        {
            <p class="text-red-400 text-xs mt-2"><i class="fas fa-exclamation-circle mr-1"></i>@erroHodometro</p>
        }
        <div class="flex space-x-3 mt-4">
            <button type="button" @onclick="EnviarInicioPercursoAsync" disabled="@enviandoPercurso" class="flex-1 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas @(enviandoPercurso ? "fa-spinner fa-spin" : "fa-paper-plane") mr-2"></i>@(enviandoPercurso ? "Enviando..." : "Enviar")
            </button>
            <button type="button" @onclick="CancelarHodometro" disabled="@enviandoPercurso" class="flex-1 bg-slate-600 hover:bg-slate-500 disabled:opacity-50 px-4 py-2 rounded-lg text-white transition-colors">
                Cancelar
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public OrdemDeServico OrdemDeServico { get; set; } = new OrdemDeServico();
    [Parameter] public List<Usuario>? Aprovadores { get; set; }
    [Parameter] public List<Usuario>? Tecnicos { get; set; }
    [Parameter] public List<ChecklistItemDefinicao>? ChecklistItensDisponiveis { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<OrdemDeServico> OnEdit { get; set; }
    [Parameter] public bool MostrarInicioPercurso { get; set; } = true;

    private List<DosagemProduto> dosagensAtuais = new();

    private bool ParametrosAguaPreenchidos =>
        OrdemDeServico.pH > 0 && OrdemDeServico.Alcalinidade > 0 && OrdemDeServico.CloroLivre > 0;

    private bool FotosCompletas =>
        !string.IsNullOrWhiteSpace(OrdemDeServico.FotosAntes) && !string.IsNullOrWhiteSpace(OrdemDeServico.FotosDepois);
    private bool eraVisivel;

    private HashSet<string> ChecklistMarcados => ChecklistOS.ItensMarcados(OrdemDeServico.ChecklistItens);

    // Mesma regra do formulário de edição: só mostra os itens que se aplicam ao tipo
    // de cliente/piscina desta OS específica.
    private IEnumerable<ChecklistItemDefinicao> ChecklistItensAplicaveis =>
        (ChecklistItensDisponiveis ?? new List<ChecklistItemDefinicao>())
            .Where(i => i.Ativo && i.AplicaSe(OrdemDeServico.Piscina?.Cliente?.Tipo, OrdemDeServico.Piscina?.Tipo))
            .OrderBy(i => i.Ordem);

    private string TextoDosagemAplicada =>
        ChecklistOS.TextoDosagemAplicada(ChecklistOS.NomePiscina(OrdemDeServico.Piscina?.Tipo), dosagensAtuais);

    // Numa Ocorrência, o Relatório só libera depois que ela for aprovada — antes disso,
    // tanto aqui quanto no cadastro (OrdemServicoModal), o botão fica desabilitado.
    private bool PodeVerRelatorio =>
        OrdemDeServico.Status == "Finalizada"
        || (OrdemDeServico.Status == "Ocorrência" && OrdemDeServico.OcorrenciaAprovada);

    private string NomeAprovador() =>
        Aprovadores?.FirstOrDefault(a => a.IDUsuario == OrdemDeServico.Aprovador)?.Nome ?? "-";

    private int? currentUserId;
    private bool aprovando;
    private bool reprovando;
    private string? erroAprovacao;
    private string? erroReprovacao;

    // Só o próprio químico responsável (Aprovador desta OS) pode aprovar, e só enquanto
    // a ocorrência ainda não tiver sido aprovada.
    private bool PodeAprovarOcorrencia =>
        OrdemDeServico.Status == "Ocorrência" && currentUserId.HasValue && currentUserId == OrdemDeServico.Aprovador;

    // Enquanto o aprovador não decidiu (nem aprovou, nem reprovou), a tela dele mostra
    // só Aprovar/Reprovar/Fechar no rodapé — sem o botão de editar/continuar, Cancelar
    // ou Relatório, que só fazem sentido depois da decisão.
    private bool AguardandoDecisaoDoAprovador =>
        PodeAprovarOcorrencia && !OrdemDeServico.OcorrenciaAprovada && !OrdemDeServico.OcorrenciaReprovada;

    private async Task AprovarOcorrenciaAsync()
    {
        aprovando = true;
        erroAprovacao = null;
        try
        {
            var atualizada = await ApiService.AprovarOcorrenciaAsync(OrdemDeServico.IDOS);
            OrdemDeServico.OcorrenciaAprovada = atualizada?.OcorrenciaAprovada ?? true;
            OrdemDeServico.DataAprovacaoOcorrencia = atualizada?.DataAprovacaoOcorrencia ?? DateTime.Now;
        }
        catch (Exception ex)
        {
            erroAprovacao = ex.Message;
        }
        finally
        {
            aprovando = false;
        }
    }

    private async Task ReprovarOcorrenciaAsync()
    {
        reprovando = true;
        erroReprovacao = null;
        try
        {
            var atualizada = await ApiService.ReprovarOcorrenciaAsync(OrdemDeServico.IDOS);
            OrdemDeServico.OcorrenciaReprovada = atualizada?.OcorrenciaReprovada ?? true;
            OrdemDeServico.DataReprovacaoOcorrencia = atualizada?.DataReprovacaoOcorrencia ?? DateTime.Now;
        }
        catch (Exception ex)
        {
            erroReprovacao = ex.Message;
        }
        finally
        {
            reprovando = false;
        }
    }

    // Busca as dosagens e identifica o usuário logado só quando o modal realmente acaba de
    // abrir (transição de IsVisible para true) — não a cada re-render do pai, e sem depender
    // de comparação de referência (a mesma instância de OrdemDeServico pode voltar aqui logo
    // após ser editada).
    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !eraVisivel)
        {
            if (OrdemDeServico.IDOS > 0)
            {
                try
                {
                    var dosagens = await ApiService.GetDosagensPorOSAsync(OrdemDeServico.IDOS);
                    dosagensAtuais = dosagens.Where(d => d.Quantidade > 0).ToList();
                }
                catch
                {
                    dosagensAtuais = new List<DosagemProduto>();
                }
            }
            else
            {
                dosagensAtuais = new List<DosagemProduto>();
            }

            erroAprovacao = null;
            var usuarioLogado = await AuthService.GetCurrentUserAsync();
            currentUserId = usuarioLogado?.IDUsuario;
        }

        eraVisivel = IsVisible;
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    // Dados usados pela área de Rota (ver RotaOSWidget), no canto superior direito desta
    // tela. Prefere a localização exata capturada ao iniciar (LatitudeInicio/LongitudeInicio)
    // — antes disso, cai pro endereço cadastrado do técnico, como estimativa.
    private Usuario? Tecnico => Tecnicos?.FirstOrDefault(t => t.IDUsuario == OrdemDeServico.IDUsuario);
    private double? RotaTecnicoLat => OrdemDeServico.LatitudeInicio ?? Tecnico?.Latitude;
    private double? RotaTecnicoLng => OrdemDeServico.LongitudeInicio ?? Tecnico?.Longitude;

    private bool capturandoLocalizacao;

    // Numa OS "Em Aberto" o fluxo agora tem duas etapas: "Iniciar Percurso" (abre o modal
    // do hodômetro — ver AbrirModalHodometro/EnviarInicioPercursoAsync, que já muda o
    // Status pra "Em Andamento" ao enviar) e, na próxima vez que abrir pra editar, "Iniciar
    // Manutenção" — identificado por já ter InicioPercurso mas ainda não ter capturado
    // LatitudeInicio. É só nesse momento que a geolocalização é capturada e o Horário de
    // Início é de fato gravado (reaberturas seguintes, com LatitudeInicio já preenchida,
    // caem direto no Editar sem regravar nada — vira "Continuar"). Nunca bloqueia o fluxo:
    // se a geolocalização falhar (sem suporte, permissão negada, timeout), o Horário de
    // Início ainda assim é atualizado e segue pro Editar do mesmo jeito.
    private async Task IniciarEEditarAsync()
    {
        if (OrdemDeServico.Status == "Em Aberto")
        {
            if (MostrarInicioPercurso)
            {
                AbrirModalHodometro();
                return;
            }

            await OnEdit.InvokeAsync(OrdemDeServico);
            return;
        }

        if (OrdemDeServico.Status == "Em Andamento" && OrdemDeServico.InicioPercurso != null && OrdemDeServico.LatitudeInicio == null)
        {
            OrdemDeServico.HoraInicio = OrdemDeServico.DataExecucao.Date + DateTime.Now.TimeOfDay;
            capturandoLocalizacao = true;
            try
            {
                var localizacao = await JSRuntime.InvokeAsync<GeoResultado?>("gestaoPiscinaMaps.obterLocalizacaoAtual");
                if (localizacao != null)
                {
                    OrdemDeServico.LatitudeInicio = localizacao.Lat;
                    OrdemDeServico.LongitudeInicio = localizacao.Lng;
                }
            }
            catch
            {
            }
            finally
            {
                capturandoLocalizacao = false;
            }
        }

        await OnEdit.InvokeAsync(OrdemDeServico);
    }

    private bool hodometroModalVisible;
    private bool enviandoPercurso;
    private string? erroHodometro;

    private void AbrirModalHodometro()
    {
        erroHodometro = null;
        hodometroModalVisible = true;
    }

    private void CancelarHodometro()
    {
        hodometroModalVisible = false;
        erroHodometro = null;
    }

    // "Enviar" no modal do hodômetro já salva a OS na hora (diferente do resto da tela, que
    // só salva quando o técnico confirma o formulário completo em "Iniciar Manutenção") —
    // pra garantir o registro do início do percurso mesmo que ele feche o app antes de
    // efetivamente começar o atendimento. Já muda o Status pra "Em Andamento" também.
    private async Task EnviarInicioPercursoAsync()
    {
        if (string.IsNullOrWhiteSpace(OrdemDeServico.FotoHodometro))
        {
            erroHodometro = "Tire uma foto do hodômetro antes de enviar.";
            return;
        }

        enviandoPercurso = true;
        erroHodometro = null;
        var statusAnterior = OrdemDeServico.Status;
        try
        {
            OrdemDeServico.InicioPercurso = DateTime.Now;
            OrdemDeServico.Status = "Em Andamento";
            await ApiService.UpdateOrdemDeServicoAsync(OrdemDeServico);
            hodometroModalVisible = false;
        }
        catch (Exception ex)
        {
            OrdemDeServico.InicioPercurso = null;
            OrdemDeServico.Status = statusAnterior;
            erroHodometro = ex.Message;
        }
        finally
        {
            enviandoPercurso = false;
        }
    }

    private void AbrirRelatorio()
    {
        Navigation.NavigateTo($"/relatorios/os/{OrdemDeServico.IDOS}");
    }

    private bool cancelarModalVisible;

    // O modal já deixa a OrdemDeServico (mesma instância usada pela lista/Kanban na tela
    // pai) com Status "Cancelada" antes de fechar — só precisa mandar re-renderizar aqui.
    private void OnOSCancelada()
    {
        StateHasChanged();
    }

    // Uma Ocorrência ou um Cancelamento trava Salvar pra qualquer um (ver
    // EstaBloqueadaParaEdicao no OrdemServicoModal) — o botão vira "Abrir" (só
    // visualização), igual a uma OS já finalizada. "Em Aberto" é sempre "Iniciar Percurso"
    // (que já muda o Status pra "Em Andamento" ao enviar a foto do hodômetro); a partir daí,
    // enquanto a localização de início ainda não foi capturada, o botão vira "Iniciar
    // Manutenção" (ver IniciarEEditarAsync) — só depois disso passa a ser "Continuar".
    private string TextoBotaoEditar()
    {
        if (OrdemDeServico.Status == "Em Aberto")
        {
            return MostrarInicioPercurso ? "Iniciar Percurso" : "Iniciar Manutenção";
        }

        if (OrdemDeServico.Status == "Em Andamento" && OrdemDeServico.InicioPercurso != null && OrdemDeServico.LatitudeInicio == null)
        {
            return "Iniciar Manutenção";
        }

        return OrdemDeServico.Status switch
        {
            "Finalizada" => "Abrir",
            "Cancelada" => "Abrir",
            "Ocorrência" => "Abrir",
            _ => "Continuar"
        };
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Em Aberto" => "text-yellow-400",
            "Em Andamento" => "text-blue-400",
            "Finalizada" => "text-green-400",
            "Ocorrência" => "text-purple-400",
            "Reagendada" => "text-orange-400",
            "Cancelada" => "text-red-400",
            _ => "text-slate-400"
        };
    }
}
