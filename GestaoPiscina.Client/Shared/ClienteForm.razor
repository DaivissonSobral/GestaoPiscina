@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Validation

<div class="space-y-6">
    <h5 class="text-lg font-semibold text-slate-200 mb-4 flex items-center">
        <i class="fas fa-user text-cyan-400 mr-2"></i>Dados do Cliente
    </h5>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">Nome *</label>
            <InputText @bind-Value="Cliente.Nome" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" placeholder="Nome completo" />
            <ValidationMessage For="@(() => Cliente.Nome)" class="text-red-500 text-sm" />
        </div>
        <div class="space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">Tipo *</label>
            <InputSelect @bind-Value="Cliente.Tipo" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500">
                <option value="">Selecione...</option>
                <option value="Residencial Privativa">Residencial Privativa</option>
                <option value="Uso Coletivo">Uso Coletivo</option>
            </InputSelect>
            <ValidationMessage For="@(() => Cliente.Tipo)" class="text-red-500 text-sm" />
        </div>
        <div class="space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">Gestor Responsável</label>
            <div class="flex items-center gap-2">
                <InputSelect TValue="int" Value="SelectedGestorId" ValueChanged="OnGestorSelected" ValueExpression="() => SelectedGestorId" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500">
                    <option value="0">Nenhum</option>
                    @if (Gestores != null)
                    {
                        @foreach (var gestor in Gestores)
                        {
                            <option value="@gestor.IDGestor">@gestor.Nome</option>
                        }
                    }
                </InputSelect>
                <button type="button" @onclick="OnNovoGestor" title="Adicionar novo gestor" class="shrink-0 bg-slate-700 hover:bg-slate-600 border border-slate-600 rounded-lg px-3 py-2 text-slate-300 hover:text-cyan-400 transition-colors">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">Telefone</label>
            <input type="text" @bind="Cliente.Telefone" @bind:event="oninput" @bind:after="FormatarTelefone" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" placeholder="(11) 99999-9999" maxlength="15" />
            <ValidationMessage For="@(() => Cliente.Telefone)" class="text-red-500 text-sm" />
        </div>
        <div class="space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">Email</label>
            <InputText @bind-Value="Cliente.Email" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" placeholder="email@exemplo.com" />
            <ValidationMessage For="@(() => Cliente.Email)" class="text-red-500 text-sm" />
        </div>
        <div class="space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">CNPJ/CPF</label>
            <input type="text" @bind="Cliente.CNPJ" @bind:event="oninput" @bind:after="FormatarCnpj" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" placeholder="000.000.000-00 ou 00.000.000/0000-00" maxlength="18" />
            <ValidationMessage For="@(() => Cliente.CNPJ)" class="text-red-500 text-sm" />
        </div>
        <div class="md:col-span-2 space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">Endereço</label>
            <InputText @bind-Value="Cliente.Endereco" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" placeholder="Endereço completo" />
            <ValidationMessage For="@(() => Cliente.Endereco)" class="text-red-500 text-sm" />
        </div>
        <div class="md:col-span-2 space-y-3">
            <label class="block text-sm font-medium text-slate-300 mb-2">Observações</label>
            <InputTextArea @bind-Value="Cliente.Observacoes" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" rows="4" placeholder="Observações adicionais..." />
            <ValidationMessage For="@(() => Cliente.Observacoes)" class="text-red-500 text-sm" />
        </div>
    </div>
</div>

@code {
    // Os campos de Telefone e CNPJ/CPF usam <input> puro (em vez de InputText) pra poder
    // reformatar o valor a cada tecla digitada via @bind:after. Isso não passa pelo
    // CurrentValueAsString do InputBase, que é quem normalmente avisa o EditContext que o
    // campo mudou — sem o NotifyFieldChanged manual abaixo, a mensagem de validação (CPF/CNPJ
    // ou telefone inválido) só apareceria ao submeter o formulário, não enquanto digita.
    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    [Parameter] public Cliente Cliente { get; set; } = new();
    [Parameter] public List<Gestor>? Gestores { get; set; }
    [Parameter] public int SelectedGestorId { get; set; }
    [Parameter] public EventCallback<int> OnGestorSelected { get; set; }
    [Parameter] public EventCallback OnNovoGestor { get; set; }

    private void FormatarTelefone()
    {
        Cliente.Telefone = Formatadores.FormatarTelefone(Cliente.Telefone);
        CascadedEditContext?.NotifyFieldChanged(new FieldIdentifier(Cliente, nameof(Cliente.Telefone)));
    }

    private void FormatarCnpj()
    {
        Cliente.CNPJ = Formatadores.FormatarCpfCnpj(Cliente.CNPJ);
        CascadedEditContext?.NotifyFieldChanged(new FieldIdentifier(Cliente, nameof(Cliente.CNPJ)));
    }
}