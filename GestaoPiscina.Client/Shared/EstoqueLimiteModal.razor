@using GestaoPiscina.Client.Models

<div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 rounded-xl p-6 w-full max-w-sm mx-4">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-slate-100">Quantidade Mínima</h3>
            <button type="button" @onclick="Close" class="text-slate-400 hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <p class="text-sm text-slate-400 mb-4">@Estoque.Produto?.Nome</p>

        <label class="block text-sm font-medium text-slate-300 mb-2">Quantidade mínima (alerta de estoque baixo)</label>
        <input type="number" step="0.01" min="0" @bind="quantidadeMinima" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Opcional" />

        <div class="flex space-x-3 mt-6">
            <button type="button" @onclick="Salvar" class="flex-1 bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas fa-save mr-2"></i>Salvar
            </button>
            <button type="button" @onclick="Close" class="flex-1 bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded-lg text-white transition-colors">
                Cancelar
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EstoqueCliente Estoque { get; set; } = new EstoqueCliente();
    [Parameter] public EventCallback<EstoqueCliente> OnSave { get; set; }

    private decimal? quantidadeMinima;
    private bool wasVisible;

    protected override void OnParametersSet()
    {
        if (IsVisible && !wasVisible)
        {
            quantidadeMinima = Estoque.QuantidadeMinima;
        }
        wasVisible = IsVisible;
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task Salvar()
    {
        Estoque.QuantidadeMinima = quantidadeMinima;
        await OnSave.InvokeAsync(Estoque);
        await Close();
    }
}
