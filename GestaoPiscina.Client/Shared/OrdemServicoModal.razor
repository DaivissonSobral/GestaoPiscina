@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Services
@inject ApiService ApiService
@inject NavigationManager Navigation

<div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 rounded-xl w-full max-w-4xl mx-4 max-h-[90vh] flex flex-col">
        <div class="flex justify-between items-center p-6 pb-4 gap-3 shrink-0">
            <h3 class="text-lg font-semibold text-slate-100">
                @(OrdemDeServico.IDOS > 0 ? "Editar Ordem de Serviço" : "Nova Ordem de Serviço")
            </h3>
            <div class="flex items-center gap-2">
                <select @bind="OrdemDeServico.Status" @bind:after="OnStatusAlterado" class="@GetStatusBadgeClass() text-xs font-semibold rounded-full pl-3 pr-2 py-1.5 border-0 focus:outline-none focus:ring-2 focus:ring-cyan-500">
                    <option value="Em Aberto">Em Aberto</option>
                    <option value="Em Andamento">Em Andamento</option>
                    <option value="Finalizada" disabled="@(!PodeFinalizar)">Finalizada</option>
                    <option value="Ocorrência">Ocorrência</option>
                    <option value="Reagendada">Reagendada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
                <button @onclick="Close" class="text-slate-400 hover:text-slate-200">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <EditForm Model="OrdemDeServico" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit" class="flex flex-col flex-1 min-h-0">
            <DataAnnotationsValidator />

            <div class="flex-1 overflow-y-auto px-6 space-y-3 scroll-tema">
                <ValidationMessage For="@(() => OrdemDeServico.Status)" />

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => secaoDadosAberta = !secaoDadosAberta" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-clipboard-list mr-2 text-cyan-400"></i>Dados Gerais</span>
                        <i class="fas @(secaoDadosAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                    </button>
                    @if (secaoDadosAberta)
                    {
                        <div class="p-4 space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Cliente</label>
                                    <select value="@clienteSelecionadoId" @onchange="OnClienteMudou" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                                        <option value="0">Selecione um cliente...</option>
                                        @foreach (var cliente in ClientesDisponiveis)
                                        {
                                            <option value="@cliente.IDCliente">@cliente.Nome</option>
                                        }
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Piscina</label>
                                    <InputSelect @bind-Value="OrdemDeServico.IDPiscina" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                                        <option value="0">Selecione uma piscina...</option>
                                        @foreach (var piscina in PiscinasDoCliente)
                                        {
                                            <option value="@piscina.IDPiscina">@piscina.Tipo (@piscina.VolumeLitros L)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => OrdemDeServico.IDPiscina)" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Data de Execução</label>
                                    <InputDate @bind-Value="OrdemDeServico.DataExecucao" @bind-Value:after="OnDataExecucaoAlterada" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
                                    <ValidationMessage For="@(() => OrdemDeServico.DataExecucao)" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Técnico Responsável</label>
                                    <InputSelect @bind-Value="OrdemDeServico.IDUsuario" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                                        <option value="0">Selecione...</option>
                                        @if (Tecnicos != null)
                                        {
                                            @foreach (var tecnico in Tecnicos)
                                            {
                                                <option value="@tecnico.IDUsuario">@tecnico.Nome</option>
                                            }
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => OrdemDeServico.IDUsuario)" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Horário de Início</label>
                                    <InputDate Type="InputDateType.Time" @bind-Value="HoraInicioTime" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">
                                        Horário de Término
                                        @if (!PermiteEditarHoraTermino)
                                        {
                                            <span class="text-xs text-slate-500 font-normal">(preenchido ao finalizar ou registrar ocorrência)</span>
                                        }
                                    </label>
                                    <InputDate Type="InputDateType.Time" @bind-Value="HoraTerminoTime" disabled="@(!PermiteEditarHoraTermino)" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 disabled:opacity-50" />
                                    <ValidationMessage For="@(() => OrdemDeServico.HoraTermino)" />
                                </div>
                            </div>

                            @if (OrdemDeServico.Status != "Ocorrência")
                            {
                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Observações</label>
                                    <InputTextArea @bind-Value="OrdemDeServico.Observacoes" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" rows="4" placeholder="Descreva detalhes da ordem de serviço..." />
                                    <ValidationMessage For="@(() => OrdemDeServico.Observacoes)" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => secaoAguaAberta = !secaoAguaAberta" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-tint mr-2 text-cyan-400"></i>Parâmetros da Água</span>
                        <i class="fas @(secaoAguaAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                    </button>
                    @if (secaoAguaAberta)
                    {
                        <div class="p-4 space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <CampoNumerico Label="pH" @bind-Value="OrdemDeServico.pH" Step="0.1m" Min="0m" Max="14m" />
                                <CampoNumerico Label="Alcalinidade" Unidade="ppm" @bind-Value="OrdemDeServico.Alcalinidade" Step="10m" Min="0m" Max="300m" />
                                <CampoNumerico Label="Cloro Livre" Unidade="ppm" @bind-Value="OrdemDeServico.CloroLivre" Step="0.5m" Min="0m" Max="10m" />
                                <CampoNumerico Label="Dureza Cálcica" Unidade="ppm" @bind-Value="OrdemDeServico.DurezaCalcica" Step="10m" Min="0m" Max="800m" />
                            </div>
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => secaoDosagemAberta = !secaoDosagemAberta" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-flask mr-2 text-cyan-400"></i>Dosagem de Produtos</span>
                        <i class="fas @(secaoDosagemAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                    </button>
                    @if (secaoDosagemAberta)
                    {
                        <div class="p-4">
                            @if (ClienteIdDaOS > 0)
                            {
                                <DosagemForm @ref="dosagemFormRef" OsId="OrdemDeServico.IDOS" ClienteId="ClienteIdDaOS" OnDosagensAtualizadas="AoAtualizarDosagens" />
                            }
                            else
                            {
                                <p class="text-sm text-amber-400">
                                    <i class="fas fa-info-circle mr-1"></i>Selecione o cliente e a piscina para ver os produtos disponíveis.
                                </p>
                            }
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => secaoFotosAberta = !secaoFotosAberta" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-camera mr-2 text-cyan-400"></i>Fotos</span>
                        <i class="fas @(secaoFotosAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                    </button>
                    @if (secaoFotosAberta)
                    {
                        <div class="p-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                <UploadFotos Label="Fotos Antes" @bind-Urls="OrdemDeServico.FotosAntes" />
                                <UploadFotos Label="Fotos Depois" @bind-Urls="OrdemDeServico.FotosDepois" />
                                @if (OrdemDeServico.Status != "Ocorrência" && !string.IsNullOrEmpty(OrdemDeServico.FotosOcorrencias))
                                {
                                    <UploadFotos Label="Fotos da Ocorrência" @bind-Urls="OrdemDeServico.FotosOcorrencias" />
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => secaoChecklistAberta = !secaoChecklistAberta" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-clipboard-check mr-2 text-cyan-400"></i>Checklist</span>
                        <i class="fas @(secaoChecklistAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                    </button>
                    @if (secaoChecklistAberta)
                    {
                        <div class="p-4 space-y-3">
                            @foreach (var item in ChecklistOS.ItensFixos)
                            {
                                <div class="flex items-start">
                                    <input type="checkbox" checked="@ItemChecklistMarcado(item.Chave)" @onchange="@(e => AlternarItemChecklist(item.Chave, e))" class="mr-2 mt-1 shrink-0" />
                                    <label class="text-sm text-slate-300">@item.Texto</label>
                                </div>
                            }

                            <div class="flex items-start pt-2 border-t border-slate-700">
                                <i class="fas @(dosagensAtuais.Any() ? "fa-check-circle text-green-400" : "fa-circle-notch text-slate-500") mr-2 mt-1 shrink-0"></i>
                                <span class="text-sm text-slate-300">
                                    @(dosagensAtuais.Any() ? TextoDosagemAplicada() : "Nenhum produto dosado ainda — registre na seção \"Dosagem de Produtos\".")
                                </span>
                            </div>
                        </div>
                    }
                </div>

                @if (OrdemDeServico.Status == "Ocorrência")
                {
                    <div class="border border-purple-800 rounded-lg overflow-hidden">
                        <button type="button" @onclick="() => secaoOcorrenciaAberta = !secaoOcorrenciaAberta" class="w-full flex justify-between items-center px-4 py-3 bg-purple-950/40 hover:bg-purple-950/60 text-left transition-colors">
                            <span class="text-sm font-semibold text-purple-300"><i class="fas fa-exclamation-triangle mr-2"></i>Ocorrência</span>
                            <i class="fas @(secaoOcorrenciaAberta ? "fa-chevron-up" : "fa-chevron-down") text-purple-300"></i>
                        </button>
                        @if (secaoOcorrenciaAberta)
                        {
                            <div class="p-4 space-y-4 bg-purple-950/20">
                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Aprovador (obrigatório)</label>
                                    <InputSelect @bind-Value="OrdemDeServico.Aprovador" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                                        <option value="">Selecione...</option>
                                        @if (Aprovadores != null)
                                        {
                                            @foreach (var aprovador in Aprovadores)
                                            {
                                                <option value="@aprovador.IDUsuario">@aprovador.Nome</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Descrição da Ocorrência</label>
                                    <InputTextArea @bind-Value="OrdemDeServico.Observacoes" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" rows="4" placeholder="Descreva o que aconteceu..." />
                                    <ValidationMessage For="@(() => OrdemDeServico.Observacoes)" />
                                </div>

                                <UploadFotos Label="Foto da Ocorrência" @bind-Urls="OrdemDeServico.FotosOcorrencias" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="flex space-x-3 p-6 pt-4 border-t border-slate-700 shrink-0">
                <button type="submit" disabled="@EstaFinalizadaOuOcorrencia" class="flex-1 bg-slate-600 hover:bg-slate-500 disabled:opacity-40 disabled:cursor-not-allowed px-4 py-2 rounded-lg text-white transition-colors" title="@(EstaFinalizadaOuOcorrencia ? "OS finalizada ou com ocorrência não pode mais ser salva por aqui" : "")">
                    <i class="fas fa-save mr-2"></i>Salvar
                </button>
                @if (EstaFinalizadaOuOcorrencia)
                {
                    <button type="button" @onclick="AbrirRelatorio" class="flex-1 bg-teal-600 hover:bg-teal-500 px-4 py-2 rounded-lg text-white transition-colors">
                        <i class="fas fa-file-alt mr-2"></i>Relatório
                    </button>
                }
                else
                {
                    <button type="submit" @onclick="PrepararFinalizar" disabled="@(!PodeFinalizar)" class="flex-1 bg-green-600 hover:bg-green-500 disabled:opacity-40 disabled:cursor-not-allowed px-4 py-2 rounded-lg text-white transition-colors" title="@(PodeFinalizar ? "" : "Conclua o checklist, os parâmetros da água e as fotos de antes/depois para finalizar")">
                        <i class="fas fa-check-circle mr-2"></i>Finalizar
                    </button>
                }
                <button type="button" @onclick="Close" class="flex-1 bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg text-white transition-colors">
                    Cancelar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public OrdemDeServico OrdemDeServico { get; set; } = new OrdemDeServico();
    [Parameter] public List<Piscina>? Piscinas { get; set; }
    [Parameter] public List<Usuario>? Tecnicos { get; set; }
    [Parameter] public List<Usuario>? Aprovadores { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public Func<OrdemDeServico, Task<bool>>? OnSave { get; set; }
    [Parameter] public EventCallback<OrdemDeServico> OnSalvo { get; set; }

    private int ClienteIdDaOS =>
        OrdemDeServico.Piscina?.Cliente?.IDCliente
        ?? Piscinas?.FirstOrDefault(p => p.IDPiscina == OrdemDeServico.IDPiscina)?.Cliente?.IDCliente
        ?? 0;

    private int clienteSelecionadoId;
    private DateTime dataExecucaoOriginal;

    // Seções do acordeão — "Dados Gerais" começa aberta (é onde ficam quase todos os
    // campos obrigatórios); as demais começam fechadas para reduzir a rolagem inicial.
    private bool secaoDadosAberta = true;
    private bool secaoAguaAberta = false;
    private bool secaoDosagemAberta = false;
    private bool secaoFotosAberta = false;
    private bool secaoChecklistAberta = false;
    private bool secaoOcorrenciaAberta = true;

    // Dosagens de produtos já salvas nesta OS (reportadas pelo DosagemForm) — usadas para
    // montar o item dinâmico "produtos aplicados" do checklist e para exigir que pelo menos
    // um produto tenha sido dosado antes de considerar o checklist concluído.
    private List<DosagemProduto> dosagensAtuais = new();
    private DosagemForm? dosagemFormRef;

    private IEnumerable<Cliente> ClientesDisponiveis =>
        (Piscinas ?? new List<Piscina>())
            .Where(p => p.Cliente != null)
            .Select(p => p.Cliente)
            .GroupBy(c => c.IDCliente)
            .Select(g => g.First())
            .OrderBy(c => c.Nome);

    private IEnumerable<Piscina> PiscinasDoCliente =>
        (Piscinas ?? new List<Piscina>()).Where(p => p.IDCliente == clienteSelecionadoId);

    private void OnClienteMudou(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            clienteSelecionadoId = id;
            OrdemDeServico.IDPiscina = 0;
        }
    }

    // Horário de Início/Término exibem só a hora — a data acompanha sempre a Data de Execução.
    private TimeOnly HoraInicioTime
    {
        get => TimeOnly.FromDateTime(OrdemDeServico.HoraInicio);
        set => OrdemDeServico.HoraInicio = OrdemDeServico.DataExecucao.Date + value.ToTimeSpan();
    }

    private TimeOnly HoraTerminoTime
    {
        get => TimeOnly.FromDateTime(OrdemDeServico.HoraTermino);
        set => OrdemDeServico.HoraTermino = OrdemDeServico.DataExecucao.Date + value.ToTimeSpan();
    }

    // Só é possível preencher o horário de término ao finalizar a OS ou registrar uma ocorrência.
    private bool PermiteEditarHoraTermino => OrdemDeServico.Status is "Finalizada" or "Ocorrência";

    // Checklist concluído = todos os itens fixos marcados + pelo menos um produto dosado.
    // Recalculado (e persistido em ChecklistConcluido) a cada mudança relevante, pra manter os
    // outros lugares do sistema que já leem esse bool (dashboard, listagem, relatórios) corretos.
    private HashSet<string> ChecklistMarcados => ChecklistOS.ItensMarcados(OrdemDeServico.ChecklistItens);

    private bool ItemChecklistMarcado(string chave) => ChecklistMarcados.Contains(chave);

    private void AlternarItemChecklist(string chave, ChangeEventArgs e)
    {
        var marcados = ChecklistMarcados;
        if (e.Value is true)
        {
            marcados.Add(chave);
        }
        else
        {
            marcados.Remove(chave);
        }

        OrdemDeServico.ChecklistItens = string.Join(",", marcados);
        AtualizarChecklistConcluido();
    }

    private void AoAtualizarDosagens(List<DosagemProduto> dosagens)
    {
        dosagensAtuais = dosagens;
        AtualizarChecklistConcluido();
        StateHasChanged();
    }

    private void AtualizarChecklistConcluido()
    {
        OrdemDeServico.ChecklistConcluido =
            ChecklistOS.ItensFixos.All(item => ItemChecklistMarcado(item.Chave)) && dosagensAtuais.Any();
    }

    private string NomePiscinaAtual()
    {
        var tipo = PiscinasDoCliente.FirstOrDefault(p => p.IDPiscina == OrdemDeServico.IDPiscina)?.Tipo
            ?? OrdemDeServico.Piscina?.Tipo;
        return ChecklistOS.NomePiscina(tipo);
    }

    private string TextoDosagemAplicada() => ChecklistOS.TextoDosagemAplicada(NomePiscinaAtual(), dosagensAtuais);

    // "Finalizar" deixa de fazer sentido para uma OS já finalizada ou com ocorrência
    // registrada — nesses casos o botão vira atalho para o Relatório, e Salvar é bloqueado.
    private bool EstaFinalizadaOuOcorrencia => OrdemDeServico.Status is "Finalizada" or "Ocorrência";

    private void AbrirRelatorio()
    {
        Navigation.NavigateTo($"/relatorios/os/{OrdemDeServico.IDOS}");
    }

    // Aproximação do que dá para checar sem sair do formulário: checklist concluído (itens +
    // dosagem de produtos), os 4 parâmetros da água informados (diferentes de zero) e as fotos
    // de antes/depois anexadas.
    private bool PodeFinalizar =>
        OrdemDeServico.ChecklistConcluido
        && OrdemDeServico.pH > 0
        && OrdemDeServico.Alcalinidade > 0
        && OrdemDeServico.CloroLivre > 0
        && OrdemDeServico.DurezaCalcica > 0
        && !string.IsNullOrWhiteSpace(OrdemDeServico.FotosAntes)
        && !string.IsNullOrWhiteSpace(OrdemDeServico.FotosDepois);

    private void OnDataExecucaoAlterada()
    {
        // Mantém a data de HoraInicio/HoraTermino em dia com a Data de Execução.
        HoraInicioTime = TimeOnly.FromDateTime(OrdemDeServico.HoraInicio);
        HoraTerminoTime = TimeOnly.FromDateTime(OrdemDeServico.HoraTermino);

        if (OrdemDeServico.DataExecucao.Date != dataExecucaoOriginal.Date && OrdemDeServico.Status == "Em Aberto")
        {
            OrdemDeServico.Status = "Reagendada";
        }
    }

    private void OnStatusAlterado()
    {
        if (PermiteEditarHoraTermino)
        {
            HoraTerminoTime = TimeOnly.FromDateTime(DateTime.Now);
        }

        if (OrdemDeServico.Status == "Ocorrência")
        {
            secaoOcorrenciaAberta = true;
        }
    }

    // Clique em "Finalizar": aplica o status/horário de finalização antes da validação
    // do próprio submit (roda no @onclick de um botão type="submit", então acontece antes
    // do EditForm validar e chamar HandleSubmit).
    private void PrepararFinalizar()
    {
        OrdemDeServico.Status = "Finalizada";
        HoraTerminoTime = TimeOnly.FromDateTime(DateTime.Now);
    }

    private string GetStatusBadgeClass() => OrdemDeServico.Status switch
    {
        "Em Aberto" => "bg-yellow-600 text-white",
        "Em Andamento" => "bg-blue-600 text-white",
        "Finalizada" => "bg-green-600 text-white",
        "Ocorrência" => "bg-purple-600 text-white",
        "Reagendada" => "bg-orange-600 text-white",
        "Cancelada" => "bg-red-600 text-white",
        _ => "bg-slate-600 text-white"
    };

    // O modal é um componente filho fixo (só fica escondido via CSS), então OnInitialized
    // roda uma única vez pra sempre. Cada "Nova OS"/"Editar" troca a instância de
    // OrdemDeServico — é essa troca de referência que dispara a preparação abaixo,
    // não o ciclo de vida do componente em si.
    private OrdemDeServico? ordemInicializada;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(ordemInicializada, OrdemDeServico))
        {
            return;
        }

        ordemInicializada = OrdemDeServico;

        // Toda OS aberta começa só com "Dados Gerais" expandida.
        secaoDadosAberta = true;
        secaoAguaAberta = false;
        secaoDosagemAberta = false;
        secaoFotosAberta = false;
        secaoChecklistAberta = false;
        secaoOcorrenciaAberta = true;
        dosagensAtuais = new List<DosagemProduto>();

        if (OrdemDeServico.DataExecucao == default)
        {
            OrdemDeServico.DataExecucao = DateTime.Today;
        }

        if (string.IsNullOrEmpty(OrdemDeServico.Status))
        {
            OrdemDeServico.Status = "Em Aberto";
        }

        dataExecucaoOriginal = OrdemDeServico.DataExecucao;
        clienteSelecionadoId = ClienteIdDaOS;

        // A transição "Em Aberto" -> "Em Andamento" ao iniciar o atendimento é decidida pelo
        // pai (OrdensServico.EditarOS), disparada só pelo clique explícito em Iniciar/Continuar
        // — não aqui, porque este modal (mesmo escondido) também recebe OrdemDeServico quando
        // o usuário só abre a Visualização, e abrir a Visualização não deve "iniciar" a OS.
        if (OrdemDeServico.IDOS == 0)
        {
            HoraInicioTime = TimeOnly.FromDateTime(DateTime.Now);
            HoraTerminoTime = HoraInicioTime;
        }

        // Busca as dosagens já registradas independente do acordeão "Dosagem de Produtos"
        // estar aberto — o checklist e o botão Finalizar precisam saber disso de cara.
        if (OrdemDeServico.IDOS > 0)
        {
            try
            {
                var dosagens = await ApiService.GetDosagensPorOSAsync(OrdemDeServico.IDOS);
                dosagensAtuais = dosagens.Where(d => d.Quantidade > 0).ToList();
            }
            catch
            {
                dosagensAtuais = new List<DosagemProduto>();
            }
        }

        AtualizarChecklistConcluido();
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        var sucesso = OnSave == null || await OnSave.Invoke(OrdemDeServico);
        if (!sucesso)
        {
            return;
        }

        // A dosagem só pode ser gravada depois da OS existir de verdade (precisa de um IDOS
        // válido) — por isso roda aqui, logo após o OnSave acima, na mesma submissão do
        // Salvar/Finalizar, em vez de exigir um botão de salvar dosagem à parte.
        if (dosagemFormRef != null)
        {
            var dosagemOk = await dosagemFormRef.SalvarPendentesAsync(OrdemDeServico.IDOS);
            if (!dosagemOk)
            {
                secaoDosagemAberta = true;
                return;
            }
        }

        await OnSalvo.InvokeAsync(OrdemDeServico);
        await Close();
    }

    // A maioria dos campos com validação (Piscina, Técnico, Status/Observações, horários)
    // mora em "Dados Gerais" — se o Salvar falhar por validação, garante que essa seção
    // esteja visível para o usuário ver a mensagem, mesmo se ele tiver fechado o acordeão.
    private void HandleInvalidSubmit()
    {
        secaoDadosAberta = true;
    }
}
