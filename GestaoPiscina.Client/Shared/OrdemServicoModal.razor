@using System.Globalization
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Services
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-50 flex sm:items-start justify-center z-50 sm:pt-8 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 w-full h-full sm:h-auto sm:rounded-xl sm:max-w-4xl sm:mx-4 sm:max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between px-4 py-3 gap-3 shrink-0 sm:px-6 sm:py-4">
            <div class="flex items-center gap-3 min-w-0">
                <button type="button" @onclick="Voltar" class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-200 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                </button>
                <div class="min-w-0">
                    <h3 class="text-xl font-semibold text-slate-100 truncate">
                        Editar OS
                    </h3>
                    <div class="text-[10px] text-slate-400 leading-none mt-0.5">
                        Informações da Ordem de Serviço
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
                <span class="inline-flex items-center justify-center w-4 h-4 rounded-full @GetStatusDotClass()" title="@OrdemDeServico.Status"></span>
                <button type="button" @onclick="ToggleSecaoOcorrencia" class="w-10 h-10 flex items-center justify-center rounded-xl bg-purple-600 hover:bg-purple-500 text-white transition-colors" title="Ocorrência">
                    <i class="fas fa-triangle-exclamation"></i>
                </button>
                <button type="button" @onclick="() => cancelarModalVisible = true" class="w-10 h-10 flex items-center justify-center rounded-xl bg-red-600 hover:bg-red-500 text-white transition-colors @(PodeCancelar ? "" : "hidden")" title="Cancelar">
                    <i class="fas fa-ban"></i>
                </button>
            </div>
        </div>

        <div class="border-t border-slate-700"></div>

        <div class="px-4 pb-3 pt-3 sm:px-6 sm:pt-4">
            <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="flex items-center space-x-2 text-slate-300 hover:text-slate-100 transition-colors">
                        @EtapaAtual
                    </div>
                    <div class="text-sm font-semibold text-slate-100 truncate">
                        @NomeEtapaAtual
                    </div>
                    <div class="text-xs text-slate-400">@EtapaAtual de 7</div>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                    <button type="button" @onclick="AlternarTodasSecoes" class="text-slate-400 hover:text-slate-200 transition-colors" title="@(TodasSecoesAbertas ? "Recolher tudo" : "Expandir tudo")">
                        <i class="fas @(TodasSecoesAbertas ? "fa-compress-alt" : "fa-expand-alt")"></i>
                    </button>
                    <div class="text-sm font-medium text-slate-300">
                        @(ProgressoPercentual.ToString("0", CultureInfo.InvariantCulture))%
                    </div>
                </div>
            </div>
            <div class="mt-2 h-2.5 rounded-full bg-slate-700 overflow-hidden">
                <div class="h-full rounded-full" style="width:@(ProgressoPercentual.ToString("0.##", CultureInfo.InvariantCulture))%; background-color:#06b6d4;"></div>
            </div>

        </div>

        <EditForm Model="OrdemDeServico" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit" class="flex flex-col flex-1 min-h-0 pt-2">
            <DataAnnotationsValidator />

            <div class="flex-1 overflow-y-auto px-6 space-y-3 scroll-tema">
                <ValidationMessage For="@(() => OrdemDeServico.Status)" />

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => AlternarSecao(1)" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-clipboard-list mr-2 text-cyan-400"></i>Dados Gerais</span>
                        <span class="flex items-center gap-2">
                            @if (SecaoDadosConcluida)
                            {
                                <i class="fas fa-check-circle text-green-400" title="Concluído"></i>
                            }
                            <i class="fas @(secaoDadosAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                        </span>
                    </button>
                    @if (secaoDadosAberta)
                    {
                        <div class="p-4 space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Cliente</label>
                                    <select value="@clienteSelecionadoId" @onchange="OnClienteMudou" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                                        <option value="0">Selecione um cliente...</option>
                                        @foreach (var cliente in ClientesDisponiveis)
                                        {
                                            <option value="@cliente.IDCliente">@cliente.Nome</option>
                                        }
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Piscina *</label>
                                    <InputSelect @bind-Value="OrdemDeServico.IDPiscina" @bind-Value:after="AtualizarChecklistConcluido" class="@ObterClasseCampo(nameof(OrdemDeServico.IDPiscina))">
                                        <option value="0">Selecione uma piscina...</option>
                                        @foreach (var piscina in PiscinasDoCliente)
                                        {
                                            <option value="@piscina.IDPiscina">@piscina.Tipo (@piscina.VolumeM3 m³)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => OrdemDeServico.IDPiscina)" class="text-red-500 text-sm" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Data de Execução *</label>
                                    <InputDate @bind-Value="OrdemDeServico.DataExecucao" @bind-Value:after="OnDataExecucaoAlterada" class="@ObterClasseCampo(nameof(OrdemDeServico.DataExecucao))" />
                                    <ValidationMessage For="@(() => OrdemDeServico.DataExecucao)" class="text-red-500 text-sm" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Técnico Responsável</label>
                                    <InputSelect @bind-Value="OrdemDeServico.IDUsuario" @bind-Value:after="AtualizarChecklistConcluido" class="@ObterClasseCampo(nameof(OrdemDeServico.IDUsuario))">
                                        <option value="">Selecione...</option>
                                        @if (Tecnicos != null)
                                        {
                                            @foreach (var tecnico in Tecnicos)
                                            {
                                                <option value="@tecnico.IDUsuario">@tecnico.Nome</option>
                                            }
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => OrdemDeServico.IDUsuario)" class="text-red-500 text-sm" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Horário de Início *</label>
                                    <InputDate Type="InputDateType.Time" @bind-Value="HoraInicioTime" @bind-Value:after="AtualizarChecklistConcluido" class="@ObterClasseCampo(nameof(OrdemDeServico.HoraInicio))" />
                                    <ValidationMessage For="@(() => OrdemDeServico.HoraInicio)" class="text-red-500 text-sm" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">
                                        Horário de Término *
                                        @if (!PermiteEditarHoraTermino)
                                        {
                                            <span class="text-xs text-slate-500 font-normal">(preenchido ao finalizar ou registrar ocorrência)</span>
                                        }
                                    </label>
                                    <InputDate Type="InputDateType.Time" @bind-Value="HoraTerminoTime" disabled="@(!PermiteEditarHoraTermino)" class="@($"{ObterClasseCampo(nameof(OrdemDeServico.HoraTermino))} {(PermiteEditarHoraTermino ? "" : "disabled:opacity-50")}")" />
                                    <ValidationMessage For="@(() => OrdemDeServico.HoraTermino)" class="text-red-500 text-sm" />
                                </div>
                            </div>

                            @if (OrdemDeServico.Status != "Ocorrência")
                            {
                                <div>
                                    <label class="block text-sm font-medium text-slate-300 mb-2">Observações</label>
                                    <InputTextArea @bind-Value="OrdemDeServico.Observacoes" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" rows="4" placeholder="Descreva detalhes da ordem de serviço..." />
                                    <ValidationMessage For="@(() => OrdemDeServico.Observacoes)" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => AlternarSecao(2)" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-route mr-2 text-cyan-400"></i>Rota</span>
                        <span class="flex items-center gap-2">
                            @if (SecaoRotaConcluida)
                            {
                                <i class="fas fa-check-circle text-green-400" title="Concluído"></i>
                            }
                            <i class="fas @(secaoRotaAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                        </span>
                    </button>
                    @if (secaoRotaAberta)
                    {
                        <div class="p-4">
                            <RotaOSWidget MapaId="mapa-rota-os-cadastro"
                                          Visivel="@(IsVisible && secaoRotaAberta)"
                                          TecnicoLat="RotaTecnicoLat"
                                          TecnicoLng="RotaTecnicoLng"
                                          TecnicoNome="TecnicoSelecionado?.Nome"
                                          ClienteLat="ClienteSelecionadoParaRota?.Latitude"
                                          ClienteLng="ClienteSelecionadoParaRota?.Longitude"
                                          ClienteNome="ClienteSelecionadoParaRota?.Nome" />
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => AlternarSecao(3)" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-tint mr-2 text-cyan-400"></i>Parâmetros da Água - Antes</span>
                        <span class="flex items-center gap-2">
                            @if (SecaoAguaAntesConcluida)
                            {
                                <i class="fas fa-check-circle text-green-400" title="Concluído"></i>
                            }
                            <i class="fas @(secaoAguaAntesAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                        </span>
                    </button>
                    @if (secaoAguaAntesAberta)
                    {
                        <div class="p-4 space-y-4">
                            @* <CampoParametroAgua Label="pH2" Icone="fa-tint" @bind-Value="OrdemDeServico.pH" @bind-Value:after="AtualizarChecklistConcluido" Step="0.1m" Min="4m" Max="10m" IdealMin="7.2m" IdealMax="7.8m" SemCard="true" /> *@
                            @* <CampoParametroAgua Label="pH2" Icone="fa-tint" @bind-Value="OrdemDeServico.pH" @bind-Value:after="AtualizarChecklistConcluido" Step="0.1m" Min="4m" Max="10m" IdealMin="7.2m" IdealMax="7.8m" SemCard="true" BadgeNaFaixaIdeal="true" /> *@
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <CampoParametroAgua Label="pH" Icone="fa-tint" @bind-Value="OrdemDeServico.pH" @bind-Value:after="AtualizarChecklistConcluido" Step="0.1m" Min="4m" Max="10m" IdealMin="7.2m" IdealMax="7.8m" BadgeNaFaixaIdeal="true" />
                                <CampoParametroAgua Label="Alcalinidade" Icone="fa-water" Unidade="ppm" @bind-Value="OrdemDeServico.Alcalinidade" @bind-Value:after="AtualizarChecklistConcluido" Step="10m" Min="40m" Max="200m" IdealMin="80m" IdealMax="120m" BadgeNaFaixaIdeal="true" />
                                <CampoParametroAgua Label="Cloro Livre" Icone="fa-flask" Unidade="ppm" @bind-Value="OrdemDeServico.CloroLivre" @bind-Value:after="AtualizarChecklistConcluido" Step="0.5m" Min="0m" Max="5m" IdealMin="0.8m" IdealMax="3m" BadgeNaFaixaIdeal="true" />
                                <CampoParametroAgua Label="Dureza Cálcica" Icone="fa-gem" Unidade="ppm" @bind-Value="OrdemDeServico.DurezaCalcica" Step="10m" Min="100m" Max="600m" IdealMin="200m" IdealMax="400m" BadgeNaFaixaIdeal="true" />
                            </div>
                        </div>

                        
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => AlternarSecao(4)" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-flask mr-2 text-cyan-400"></i>Dosagem de Produtos</span>
                        <span class="flex items-center gap-2">
                            @if (SecaoDosagemConcluida)
                            {
                                <i class="fas fa-check-circle text-green-400" title="Concluído"></i>
                            }
                            <i class="fas @(secaoDosagemAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                        </span>
                    </button>
                    @* Fica sempre montado (só escondido via CSS, não @if) para que a dosagem seja
                       carregada e conte para o checklist mesmo sem o usuário abrir esta seção. *@
                    <div class="p-4 @(secaoDosagemAberta ? "" : "hidden")">
                        @if (ClienteIdDaOS > 0)
                        {
                            <DosagemForm @ref="dosagemFormRef" OsId="OrdemDeServico.IDOS" ClienteId="ClienteIdDaOS" OnDosagensAtualizadas="AoAtualizarDosagens" />
                        }
                        else
                        {
                            <p class="text-sm text-amber-400">
                                <i class="fas fa-info-circle mr-1"></i>Selecione o cliente e a piscina para ver os produtos disponíveis.
                            </p>
                        }
                    </div>
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => AlternarSecao(5)" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-tint mr-2 text-cyan-400"></i>Parâmetros da Água - Depois</span>
                        <span class="flex items-center gap-2">
                            @if (SecaoAguaDepoisConcluida)
                            {
                                <i class="fas fa-check-circle text-green-400" title="Concluído"></i>
                            }
                            <i class="fas @(secaoAguaDepoisAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                        </span>
                    </button>
                    @if (secaoAguaDepoisAberta)
                    {
                        <div class="p-4 space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <CampoNumerico Label="pH" @bind-Value="PHDepoisValue" @bind-Value:after="AtualizarChecklistConcluido" Step="0.1m" Min="0m" Max="14m" IdealMin="7.2m" IdealMax="7.8m" />
                                <CampoNumerico Label="Alcalinidade" Unidade="ppm" @bind-Value="AlcalinidadeDepoisValue" @bind-Value:after="AtualizarChecklistConcluido" Step="10m" Min="0m" Max="300m" IdealMin="80m" IdealMax="120m" />
                                <CampoNumerico Label="Cloro Livre" Unidade="ppm" @bind-Value="CloroLivreDepoisValue" @bind-Value:after="AtualizarChecklistConcluido" Step="0.5m" Min="0m" Max="10m" IdealMin="0.8m" IdealMax="3m" />
                                <CampoNumerico Label="Dureza Cálcica" Unidade="ppm" @bind-Value="DurezaCalcicaDepoisValue" Step="10m" Min="0m" Max="800m" IdealMin="200m" IdealMax="400m" />
                            </div>
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => AlternarSecao(6)" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-camera mr-2 text-cyan-400"></i>Fotos</span>
                        <span class="flex items-center gap-2">
                            @if (SecaoFotosConcluida)
                            {
                                <i class="fas fa-check-circle text-green-400" title="Concluído"></i>
                            }
                            <i class="fas @(secaoFotosAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                        </span>
                    </button>
                    @if (secaoFotosAberta)
                    {
                        <div class="p-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                <UploadFotos Label="Fotos Antes" @bind-Urls="OrdemDeServico.FotosAntes" @bind-Urls:after="AtualizarChecklistConcluido" />
                                <UploadFotos Label="Fotos Depois" @bind-Urls="OrdemDeServico.FotosDepois" @bind-Urls:after="AtualizarChecklistConcluido" />
                            </div>
                        </div>
                    }
                </div>

                <div class="border border-slate-700 rounded-lg overflow-hidden">
                    <button type="button" @onclick="() => AlternarSecao(7)" class="w-full flex justify-between items-center px-4 py-3 bg-slate-700/60 hover:bg-slate-700 text-left transition-colors">
                        <span class="text-sm font-semibold text-slate-200"><i class="fas fa-clipboard-check mr-2 text-cyan-400"></i>Checklist</span>
                        <span class="flex items-center gap-2">
                            @if (SecaoChecklistConcluida)
                            {
                                <i class="fas fa-check-circle text-green-400" title="Concluído"></i>
                            }
                            <i class="fas @(secaoChecklistAberta ? "fa-chevron-up" : "fa-chevron-down") text-slate-400"></i>
                        </span>
                    </button>
                    @if (secaoChecklistAberta)
                    {
                        <div class="p-4 space-y-3">
                            @if (!ChecklistItensAplicaveis.Any())
                            {
                                <p class="text-sm text-amber-400">
                                    <i class="fas fa-info-circle mr-1"></i>Nenhum item de checklist obrigatório para este tipo de cliente/piscina.
                                </p>
                            }
                            @foreach (var item in ChecklistItensAplicaveis)
                            {
                                <div class="flex items-start">
                                    <input type="checkbox" checked="@ItemChecklistMarcado(item.Chave)" @onchange="@(e => AlternarItemChecklist(item.Chave, e))" class="mr-2 mt-1 shrink-0" />
                                    <label class="text-sm text-slate-300">@item.Texto</label>
                                </div>
                            }

                            <div class="flex items-start pt-2 border-t border-slate-700">
                                <i class="fas @(TecnicoPreenchido ? "fa-check-circle text-green-400" : "fa-circle-notch text-slate-500") mr-2 mt-1 shrink-0"></i>
                                <span class="text-sm text-slate-300">
                                    @(TecnicoPreenchido ? "Técnico responsável informado." : "Técnico responsável ainda não informado — preencha em \"Dados Gerais\".")
                                </span>
                            </div>

                            <div class="flex items-start">
                                <i class="fas @(HoraInicioPreenchida ? "fa-check-circle text-green-400" : "fa-circle-notch text-slate-500") mr-2 mt-1 shrink-0"></i>
                                <span class="text-sm text-slate-300">
                                    @(HoraInicioPreenchida ? "Horário de início informado." : "Horário de início ainda não informado — preencha em \"Dados Gerais\".")
                                </span>
                            </div>

                            <div class="flex items-start">
                                <i class="fas @(ParametrosAguaPreenchidos ? "fa-check-circle text-green-400" : "fa-circle-notch text-slate-500") mr-2 mt-1 shrink-0"></i>
                                <span class="text-sm text-slate-300">
                                    @(ParametrosAguaPreenchidos ? "Parâmetros da água (antes e depois) informados." : "Parâmetros da água ainda não informados — preencha as seções \"Antes\" e \"Depois\" (Dureza Cálcica é opcional).")
                                </span>
                            </div>

                            <div class="flex items-start">
                                <i class="fas @(FotosCompletas ? "fa-check-circle text-green-400" : "fa-circle-notch text-slate-500") mr-2 mt-1 shrink-0"></i>
                                <span class="text-sm text-slate-300">
                                    @(FotosCompletas ? "Fotos de antes e depois anexadas." : "Fotos de antes e depois ainda não anexadas — registre na seção \"Fotos\".")
                                </span>
                            </div>

                            <div class="flex items-start">
                                <i class="fas @(dosagensAtuais.Any() ? "fa-check-circle text-green-400" : "fa-circle-notch text-slate-500") mr-2 mt-1 shrink-0"></i>
                                <span class="text-sm text-slate-300">
                                    @(dosagensAtuais.Any() ? TextoDosagemAplicada() : "Nenhum produto dosado ainda — registre na seção \"Dosagem de Produtos\".")
                                </span>
                            </div>
                        </div>
                    }
                </div>

                <div class="border border-purple-800 rounded-lg overflow-hidden">
                    <button type="button" @onclick="ToggleSecaoOcorrencia" class="w-full flex justify-between items-center px-4 py-3 bg-purple-950/40 hover:bg-purple-950/60 text-left transition-colors">
                        <span class="text-sm font-semibold text-purple-300"><i class="fas fa-exclamation-triangle mr-2"></i>Ocorrência</span>
                        <i class="fas @(secaoOcorrenciaAberta ? "fa-chevron-up" : "fa-chevron-down") text-purple-300"></i>
                    </button>
                    @if (secaoOcorrenciaAberta)
                    {
                        <div class="p-4 space-y-4 bg-purple-950/20">
                            <div>
                                <label class="block text-sm font-medium text-slate-300 mb-2">Aprovador (obrigatório)</label>
                                <InputSelect @bind-Value="OrdemDeServico.Aprovador" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100">
                                    <option value="">Selecione...</option>
                                    @if (Aprovadores != null)
                                    {
                                        @foreach (var aprovador in Aprovadores)
                                        {
                                            <option value="@aprovador.IDUsuario">@aprovador.Nome</option>
                                        }
                                    }
                                </InputSelect>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-300 mb-2">Descrição da Ocorrência</label>
                                <InputTextArea @bind-Value="OrdemDeServico.Observacoes" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" rows="4" placeholder="Descreva o que aconteceu..." />
                                <ValidationMessage For="@(() => OrdemDeServico.Observacoes)" />
                            </div>

                            <UploadFotos Label="Foto da Ocorrência" @bind-Urls="OrdemDeServico.FotosOcorrencias" />
                        </div>
                    }
                </div>
            </div>

            <div class="flex flex-nowrap items-center gap-1.5 sm:gap-3 px-3 sm:px-6 py-3 sm:py-4 border-t border-slate-700 shrink-0">
                <button type="button" @onclick="AnteriorEtapa" disabled="@(EtapaAtual <= 1)" class="flex-1 min-w-0 whitespace-nowrap overflow-hidden bg-slate-600 hover:bg-slate-500 disabled:opacity-40 disabled:cursor-not-allowed px-2 sm:px-4 py-2 sm:py-3 rounded-lg text-white transition-colors">
                    Anterior
                </button>

                @if (EtapaAtual < 7)
                {
                    <button type="button" @onclick="AvancarEtapaAsync" class="flex-1 min-w-0 whitespace-nowrap overflow-hidden bg-blue-600 hover:bg-blue-500 px-2 sm:px-4 py-2 sm:py-3 rounded-lg text-white transition-colors">
                        Avançar
                    </button>
                }
                else
                {
                    <button type="submit" @onclick="PrepararFinalizar" disabled="@(!PodeFinalizar)" class="flex-1 min-w-0 whitespace-nowrap overflow-hidden bg-green-600 hover:bg-green-500 disabled:opacity-40 disabled:cursor-not-allowed px-2 sm:px-4 py-2 sm:py-3 rounded-lg text-white transition-colors" title="@(PodeFinalizar ? "Finalizar" : "Preencha técnico, horário de início, parâmetros da água (antes e depois) e fotos, e dose ao menos um produto para finalizar")">
                        Finalizar
                    </button>
                }
            </div>
            @if (!string.IsNullOrEmpty(erroAprovacaoOcorrencia))
            {
                <p class="text-red-400 text-xs px-6 pb-3">@erroAprovacaoOcorrencia</p>
            }
        </EditForm>
    </div>

    <CancelarOSModal @bind-IsVisible="cancelarModalVisible" OrdemDeServico="OrdemDeServico" OnCancelado="OnOSCancelada" />
    <Toast @bind-IsVisible="toastValidacaoVisible"
           Title="Validação"
           Message="@mensagemErroValidacao"
           Type="error"
           AutoHideDelay="4000" />
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public OrdemDeServico OrdemDeServico { get; set; } = new OrdemDeServico();
    [Parameter] public List<Piscina>? Piscinas { get; set; }
    [Parameter] public List<Usuario>? Tecnicos { get; set; }
    [Parameter] public List<Usuario>? Aprovadores { get; set; }
    [Parameter] public List<ChecklistItemDefinicao>? ChecklistItensDisponiveis { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    // O segundo parâmetro indica se o pai deve exibir o toast de sucesso — false nos
    // salvamentos automáticos entre etapas (ver SalvarEtapaAtualAsync), true no Salvar/Finalizar.
    [Parameter] public Func<OrdemDeServico, bool, Task<bool>>? OnSave { get; set; }
    [Parameter] public EventCallback<OrdemDeServico> OnSalvo { get; set; }
    // Disparado só pelo botão de voltar do topo (não por Salvar/Finalizar/Cancelar, que já
    // têm seu próprio retorno via OnSalvo) — deixa o pai decidir se volta pra Detalhes.
    [Parameter] public EventCallback OnVoltar { get; set; }

    private int ClienteIdDaOS =>
        OrdemDeServico.Piscina?.Cliente?.IDCliente
        ?? Piscinas?.FirstOrDefault(p => p.IDPiscina == OrdemDeServico.IDPiscina)?.Cliente?.IDCliente
        ?? 0;

    private Piscina? PiscinaAtual =>
        OrdemDeServico.Piscina
        ?? Piscinas?.FirstOrDefault(p => p.IDPiscina == OrdemDeServico.IDPiscina);

    // Só os itens que se aplicam ao tipo de cliente/piscina desta OS específica são
    // exibidos e exigidos — um item cadastrado para "Uso Coletivo" nunca aparece numa
    // OS de cliente "Residencial Privativa", por exemplo.
    private IEnumerable<ChecklistItemDefinicao> ChecklistItensAplicaveis =>
        (ChecklistItensDisponiveis ?? new List<ChecklistItemDefinicao>())
            .Where(i => i.Ativo && i.AplicaSe(PiscinaAtual?.Cliente?.Tipo, PiscinaAtual?.Tipo))
            .OrderBy(i => i.Ordem);

    private int clienteSelecionadoId;
    private DateTime dataExecucaoOriginal;

    // Seções do acordeão — "Dados Gerais" começa aberta (é onde ficam quase todos os
    // campos obrigatórios); as demais começam fechadas para reduzir a rolagem inicial.
    private bool secaoDadosAberta = true;
    private bool secaoRotaAberta = false;
    private bool secaoAguaAntesAberta = false;
    private bool secaoAguaDepoisAberta = false;
    private bool secaoDosagemAberta = false;
    private bool secaoFotosAberta = false;
    private bool secaoChecklistAberta = false;
    private bool secaoOcorrenciaAberta = false;

    // CampoNumerico só aceita decimal (não decimal?) — estes wrappers adaptam os campos
    // "Depois", que começam nulos até o técnico medir novamente após a dosagem.
    private decimal PHDepoisValue
    {
        get => OrdemDeServico.pHDepois ?? 0m;
        set => OrdemDeServico.pHDepois = value;
    }

    private decimal AlcalinidadeDepoisValue
    {
        get => OrdemDeServico.AlcalinidadeDepois ?? 0m;
        set => OrdemDeServico.AlcalinidadeDepois = value;
    }

    private decimal CloroLivreDepoisValue
    {
        get => OrdemDeServico.CloroLivreDepois ?? 0m;
        set => OrdemDeServico.CloroLivreDepois = value;
    }

    private decimal DurezaCalcicaDepoisValue
    {
        get => OrdemDeServico.DurezaCalcicaDepois ?? 0m;
        set => OrdemDeServico.DurezaCalcicaDepois = value;
    }

    // Dosagens de produtos já salvas nesta OS (reportadas pelo DosagemForm) — usadas para
    // montar o item dinâmico "produtos aplicados" do checklist e para exigir que pelo menos
    // um produto tenha sido dosado antes de considerar o checklist concluído.
    private List<DosagemProduto> dosagensAtuais = new();
    private DosagemForm? dosagemFormRef;

    private IEnumerable<Cliente> ClientesDisponiveis =>
        (Piscinas ?? new List<Piscina>())
            .Where(p => p.Cliente != null)
            .Select(p => p.Cliente)
            .GroupBy(c => c.IDCliente)
            .Select(g => g.First())
            .OrderBy(c => c.Nome);

    private IEnumerable<Piscina> PiscinasDoCliente =>
        (Piscinas ?? new List<Piscina>()).Where(p => p.IDCliente == clienteSelecionadoId);

    // Dados usados pelo acordeão "Rota" (ver RotaOSWidget). Prefere a localização exata
    // capturada ao clicar "Iniciar" (LatitudeInicio/LongitudeInicio) — quando ainda não
    // existe (OS nem começou), cai pro endereço cadastrado do técnico, como estimativa.
    private Usuario? TecnicoSelecionado => Tecnicos?.FirstOrDefault(t => t.IDUsuario == OrdemDeServico.IDUsuario);
    private double? RotaTecnicoLat => OrdemDeServico.LatitudeInicio ?? TecnicoSelecionado?.Latitude;
    private double? RotaTecnicoLng => OrdemDeServico.LongitudeInicio ?? TecnicoSelecionado?.Longitude;
    private Cliente? ClienteSelecionadoParaRota => ClientesDisponiveis.FirstOrDefault(c => c.IDCliente == clienteSelecionadoId);

    private void OnClienteMudou(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            clienteSelecionadoId = id;
            OrdemDeServico.IDPiscina = 0;
            AtualizarChecklistConcluido();
        }
    }

    // Horário de Início/Término exibem só a hora — a data acompanha sempre a Data de Execução.
    private TimeOnly HoraInicioTime
    {
        get => TimeOnly.FromDateTime(OrdemDeServico.HoraInicio);
        set => OrdemDeServico.HoraInicio = OrdemDeServico.DataExecucao.Date + value.ToTimeSpan();
    }

    private TimeOnly HoraTerminoTime
    {
        get => TimeOnly.FromDateTime(OrdemDeServico.HoraTermino);
        set => OrdemDeServico.HoraTermino = OrdemDeServico.DataExecucao.Date + value.ToTimeSpan();
    }

    // Só é possível preencher o horário de término ao finalizar a OS ou registrar uma ocorrência.
    private bool PermiteEditarHoraTermino => OrdemDeServico.Status is "Finalizada" or "Ocorrência";

    // ChecklistConcluido reflete só se os itens de checklist aplicáveis estão marcados —
    // usado como indicador informativo em outros lugares do sistema (dashboard, listagem,
    // relatórios). Não bloqueia mais o Finalizar (ver PodeFinalizar).
    private HashSet<string> ChecklistMarcados => ChecklistOS.ItensMarcados(OrdemDeServico.ChecklistItens);

    private bool ItemChecklistMarcado(string chave) => ChecklistMarcados.Contains(chave);

    private void AlternarItemChecklist(string chave, ChangeEventArgs e)
    {
        var marcados = ChecklistMarcados;
        if (e.Value is true)
        {
            marcados.Add(chave);
        }
        else
        {
            marcados.Remove(chave);
        }

        OrdemDeServico.ChecklistItens = string.Join(",", marcados);
        AtualizarChecklistConcluido();
    }

    private void AoAtualizarDosagens(List<DosagemProduto> dosagens)
    {
        dosagensAtuais = dosagens;
        AtualizarChecklistConcluido();
        StateHasChanged();
    }

    // Dureza Cálcica não é exigida (medida com menor frequência) — os demais parâmetros,
    // sim, tanto no "Antes" quanto no "Depois".
    private bool ParametrosAguaPreenchidos =>
        OrdemDeServico.pH > 0 && OrdemDeServico.Alcalinidade > 0 && OrdemDeServico.CloroLivre > 0
        && OrdemDeServico.pHDepois > 0 && OrdemDeServico.AlcalinidadeDepois > 0 && OrdemDeServico.CloroLivreDepois > 0;

    private bool FotosCompletas =>
        !string.IsNullOrWhiteSpace(OrdemDeServico.FotosAntes) && !string.IsNullOrWhiteSpace(OrdemDeServico.FotosDepois);

    private bool TecnicoPreenchido => OrdemDeServico.IDUsuario is > 0;

    private bool HoraInicioPreenchida => OrdemDeServico.HoraInicio != default;

    private void AtualizarChecklistConcluido()
    {
        OrdemDeServico.ChecklistConcluido = ChecklistItensAplicaveis.All(item => ItemChecklistMarcado(item.Chave));
    }

    private string NomePiscinaAtual()
    {
        var tipo = PiscinasDoCliente.FirstOrDefault(p => p.IDPiscina == OrdemDeServico.IDPiscina)?.Tipo
            ?? OrdemDeServico.Piscina?.Tipo;
        return ChecklistOS.NomePiscina(tipo);
    }

    private string TextoDosagemAplicada() => ChecklistOS.TextoDosagemAplicada(NomePiscinaAtual(), dosagensAtuais);

    // Status já persistido quando o modal foi aberto — usado para travar Salvar só depois
    // que a ocorrência já foi de fato salva, não assim que o usuário seleciona "Ocorrência"
    // no dropdown (senão nunca daria pra salvar o registro da ocorrência pela primeira vez).
    private string? statusOriginal;

    // Abrir o acordeão já registra a ocorrência (sem botão separado) — só ao ABRIR, não ao
    // fechar de novo, senão colapsar a seção depois de preenchida desfaria o registro. Ao
    // abrir, fecha todas as demais seções para deixar só a Ocorrência (com todos os campos
    // visíveis) em foco na tela.
    private void ToggleSecaoOcorrencia()
    {
        secaoOcorrenciaAberta = !secaoOcorrenciaAberta;
        if (!secaoOcorrenciaAberta)
        {
            return;
        }

        secaoDadosAberta = false;
        secaoRotaAberta = false;
        secaoAguaAntesAberta = false;
        secaoDosagemAberta = false;
        secaoAguaDepoisAberta = false;
        secaoFotosAberta = false;
        secaoChecklistAberta = false;

        if (OrdemDeServico.Status != "Ocorrência")
        {
            OrdemDeServico.Status = "Ocorrência";
            OnStatusAlterado();
        }
    }

    // Salvar é bloqueado numa OS Finalizada, Cancelada (ambas feitas por ações dedicadas —
    // Finalizar e Cancelar aqui mesmo), ou que JÁ ESTAVA com ocorrência registrada quando o
    // modal foi aberto (edições posteriores só acontecem via aprovação, não por aqui).
    private bool EstaBloqueadaParaEdicao => OrdemDeServico.Status is "Finalizada" or "Cancelada" || statusOriginal == "Ocorrência";

    // Cancelada nunca libera o Relatório — só Finalizada (sempre) ou Ocorrência já aprovada.
    private bool PodeVerRelatorio => OrdemDeServico.Status == "Finalizada" || OrdemDeServico.OcorrenciaAprovada;

    // Não faz sentido cancelar uma OS que já está Finalizada ou já Cancelada — mesma regra
    // usada para esconder o botão "Cancelar" na tela de Detalhes.
    private bool PodeCancelar => OrdemDeServico.Status is not ("Finalizada" or "Cancelada");

    private bool cancelarModalVisible;
    private bool toastValidacaoVisible;
    private string? mensagemErroValidacao;

    // O CancelarOSModal já deixou a OrdemDeServico com Status "Cancelada" e salvou no
    // servidor — só falta repassar pro pai (mesmo callback usado ao Salvar/Finalizar) e
    // fechar este modal, voltando pra tela de Detalhes já travada.
    private async Task OnOSCancelada()
    {
        await OnSalvo.InvokeAsync(OrdemDeServico);
        await Close();
    }

    private void AbrirRelatorio()
    {
        Navigation.NavigateTo($"/relatorios/os/{OrdemDeServico.IDOS}");
    }

    // Requisitos para finalizar a OS: técnico, horário de início, parâmetros da água (antes
    // e depois, exceto Dureza Cálcica), pelo menos um produto dosado e fotos de antes/depois.
    // O checklist de itens fixos é só informativo — não bloqueia mais a finalização.
    private bool PodeFinalizar =>
        TecnicoPreenchido
        && HoraInicioPreenchida
        && ParametrosAguaPreenchidos
        && dosagensAtuais.Any()
        && FotosCompletas;

    private int? currentUserId;
    private bool aprovandoOcorrencia;
    private string? erroAprovacaoOcorrencia;

    // Só o próprio químico responsável (Aprovador desta OS) vê o botão "Aprovar" no lugar do
    // Relatório, e só enquanto a ocorrência ainda não tiver sido aprovada.
    private bool PodeAprovarOcorrencia =>
        statusOriginal == "Ocorrência" && !OrdemDeServico.OcorrenciaAprovada
        && currentUserId.HasValue && currentUserId == OrdemDeServico.Aprovador;

    private async Task AprovarOcorrenciaAsync()
    {
        aprovandoOcorrencia = true;
        erroAprovacaoOcorrencia = null;
        try
        {
            var atualizada = await ApiService.AprovarOcorrenciaAsync(OrdemDeServico.IDOS);
            OrdemDeServico.OcorrenciaAprovada = atualizada?.OcorrenciaAprovada ?? true;
            OrdemDeServico.DataAprovacaoOcorrencia = atualizada?.DataAprovacaoOcorrencia ?? DateTime.Now;
        }
        catch (Exception ex)
        {
            erroAprovacaoOcorrencia = ex.Message;
        }
        finally
        {
            aprovandoOcorrencia = false;
        }
    }

    private void OnDataExecucaoAlterada()
    {
        // Mantém a data de HoraInicio/HoraTermino em dia com a Data de Execução.
        HoraInicioTime = TimeOnly.FromDateTime(OrdemDeServico.HoraInicio);
        HoraTerminoTime = TimeOnly.FromDateTime(OrdemDeServico.HoraTermino);

        if (OrdemDeServico.DataExecucao.Date != dataExecucaoOriginal.Date && OrdemDeServico.Status == "Em Aberto")
        {
            OrdemDeServico.Status = "Reagendada";
        }
    }

    private void OnStatusAlterado()
    {
        if (PermiteEditarHoraTermino)
        {
            HoraTerminoTime = TimeOnly.FromDateTime(DateTime.Now);
        }

        if (OrdemDeServico.Status == "Ocorrência")
        {
            secaoOcorrenciaAberta = true;
        }
    }

    // Clique em "Finalizar": aplica o status/horário de finalização antes da validação
    // do próprio submit (roda no @onclick de um botão type="submit", então acontece antes
    // do EditForm validar e chamar HandleSubmit).
    private void PrepararFinalizar()
    {
        OrdemDeServico.Status = "Finalizada";
        HoraTerminoTime = TimeOnly.FromDateTime(DateTime.Now);
    }

    private string GetStatusBadgeClass() => OrdemDeServico.Status switch
    {
        "Em Aberto" => "bg-yellow-600 text-white",
        "Em Andamento" => "bg-blue-600 text-white",
        "Finalizada" => "bg-green-600 text-white",
        "Ocorrência" => "bg-purple-600 text-white",
        "Reagendada" => "bg-orange-600 text-white",
        "Cancelada" => "bg-red-600 text-white",
        _ => "bg-slate-600 text-white"
    };

    private string GetStatusDotClass() => OrdemDeServico.Status switch
    {
        "Em Aberto" => "bg-yellow-500 shadow-[0_0_0_2px_rgba(250,204,21,0.25)]",
        "Em Andamento" => "bg-blue-500 shadow-[0_0_0_2px_rgba(59,130,246,0.25)]",
        "Finalizada" => "bg-green-500 shadow-[0_0_0_2px_rgba(34,197,94,0.25)]",
        "Ocorrência" => "bg-purple-500 shadow-[0_0_0_2px_rgba(168,85,247,0.25)]",
        "Reagendada" => "bg-orange-500 shadow-[0_0_0_2px_rgba(249,115,22,0.25)]",
        "Cancelada" => "bg-red-500 shadow-[0_0_0_2px_rgba(239,68,68,0.25)]",
        _ => "bg-slate-500 shadow-[0_0_0_2px_rgba(148,163,184,0.25)]"
    };

    private int etapaAtualIndex = 1;

    private int EtapaAtual => etapaAtualIndex;

    private string NomeEtapaAtual => EtapaAtual switch
    {
        1 => "Dados Gerais",
        2 => "Rota",
        3 => "Parâmetros antes",
        4 => "Dosagem",
        5 => "Parâmetros depois",
        6 => "Fotos",
        _ => "Checklist"
    };

    // Cada seção pode ser aberta/fechada independente das demais (o usuário decide o que
    // ver na tela) — só a abertura/fechamento pontual de UM acordeão por vez, sem fechar
    // os outros.
    private void AlternarSecao(int etapa)
    {
        etapaAtualIndex = etapa;
        switch (etapa)
        {
            case 1: secaoDadosAberta = !secaoDadosAberta; break;
            case 2: secaoRotaAberta = !secaoRotaAberta; break;
            case 3: secaoAguaAntesAberta = !secaoAguaAntesAberta; break;
            case 4: secaoDosagemAberta = !secaoDosagemAberta; break;
            case 5: secaoAguaDepoisAberta = !secaoAguaDepoisAberta; break;
            case 6: secaoFotosAberta = !secaoFotosAberta; break;
            case 7: secaoChecklistAberta = !secaoChecklistAberta; break;
        }
    }

    // Usado por Avançar/Anterior para levar o usuário direto à seção alvo, sem mexer no
    // estado (aberto/fechado) das demais.
    private void AbrirSecao(int etapa)
    {
        etapaAtualIndex = etapa;
        switch (etapa)
        {
            case 1: secaoDadosAberta = true; break;
            case 2: secaoRotaAberta = true; break;
            case 3: secaoAguaAntesAberta = true; break;
            case 4: secaoDosagemAberta = true; break;
            case 5: secaoAguaDepoisAberta = true; break;
            case 6: secaoFotosAberta = true; break;
            case 7: secaoChecklistAberta = true; break;
        }
    }

    // Usado por Avançar/Anterior pra fechar a etapa que está sendo deixada para trás,
    // antes de abrir a próxima — clique manual no cabeçalho (AlternarSecao) continua livre
    // pra manter várias seções abertas ao mesmo tempo.
    private void FecharSecao(int etapa)
    {
        switch (etapa)
        {
            case 1: secaoDadosAberta = false; break;
            case 2: secaoRotaAberta = false; break;
            case 3: secaoAguaAntesAberta = false; break;
            case 4: secaoDosagemAberta = false; break;
            case 5: secaoAguaDepoisAberta = false; break;
            case 6: secaoFotosAberta = false; break;
            case 7: secaoChecklistAberta = false; break;
        }
    }

    private bool TodasSecoesAbertas =>
        secaoDadosAberta && secaoRotaAberta && secaoAguaAntesAberta && secaoDosagemAberta
        && secaoAguaDepoisAberta && secaoFotosAberta && secaoChecklistAberta;

    private void AlternarTodasSecoes()
    {
        var abrir = !TodasSecoesAbertas;
        secaoDadosAberta = abrir;
        secaoRotaAberta = abrir;
        secaoAguaAntesAberta = abrir;
        secaoDosagemAberta = abrir;
        secaoAguaDepoisAberta = abrir;
        secaoFotosAberta = abrir;
        secaoChecklistAberta = abrir;
    }

    // Conclusão de cada etapa com base nos dados reais preenchidos — usada para o ícone
    // verde no acordeão, a barra de progresso e a navegação por Avançar/Anterior.
    private bool SecaoDadosConcluida => OrdemDeServico.IDPiscina > 0 && TecnicoPreenchido && HoraInicioPreenchida;
    // A Rota não tem campo próprio pra preencher (é só apoio visual) — conta como concluída
    // assim que o técnico já clicou em "Iniciar Manutenção" (Status sai de "Em Aberto"/
    // "Reagendada", que são os únicos status possíveis pra uma OS que ainda não começou).
    private bool SecaoRotaConcluida => OrdemDeServico.Status is not ("Em Aberto" or "Reagendada");
    private bool SecaoAguaAntesConcluida => OrdemDeServico.pH > 0 && OrdemDeServico.Alcalinidade > 0 && OrdemDeServico.CloroLivre > 0;
    private bool SecaoDosagemConcluida => dosagensAtuais.Any();
    private bool SecaoAguaDepoisConcluida => OrdemDeServico.pHDepois > 0 && OrdemDeServico.AlcalinidadeDepois > 0 && OrdemDeServico.CloroLivreDepois > 0;
    private bool SecaoFotosConcluida => FotosCompletas;
    private bool SecaoChecklistConcluida => PodeFinalizar;

    private bool SecaoConcluida(int etapa) => etapa switch
    {
        1 => SecaoDadosConcluida,
        2 => SecaoRotaConcluida,
        3 => SecaoAguaAntesConcluida,
        4 => SecaoDosagemConcluida,
        5 => SecaoAguaDepoisConcluida,
        6 => SecaoFotosConcluida,
        7 => SecaoChecklistConcluida,
        _ => true
    };

    // Só as etapas com requisito próprio contam pra % de progresso — Rota não tem nada
    // pra preencher e Checklist só espelha o conjunto das outras quatro (PodeFinalizar),
    // então incluir as duas inflaria o percentual sem refletir dado novo.
    private static readonly int[] EtapasComRequisitoProprio = { 1, 3, 4, 5, 6 };

    private double ProgressoPercentual =>
        EtapasComRequisitoProprio.Count(SecaoConcluida) * 100.0 / EtapasComRequisitoProprio.Length;

    private void AnteriorEtapa()
    {
        var etapaOrigem = etapaAtualIndex;

        for (var etapa = etapaOrigem - 1; etapa >= 1; etapa--)
        {
            if (SecaoConcluida(etapa))
            {
                FecharSecao(etapaOrigem);
                AbrirSecao(etapa);
                return;
            }
        }

        if (etapaOrigem > 1)
        {
            FecharSecao(etapaOrigem);
            AbrirSecao(etapaOrigem - 1);
        }
    }

    private async Task AvancarEtapaAsync()
    {
        if (etapaAtualIndex >= 7)
        {
            return;
        }

        var salvo = await SalvarEtapaAtualAsync();
        if (!salvo)
        {
            return;
        }

        var etapaOrigem = etapaAtualIndex;

        for (var etapa = etapaOrigem + 1; etapa <= 7; etapa++)
        {
            if (!SecaoConcluida(etapa))
            {
                FecharSecao(etapaOrigem);
                AbrirSecao(etapa);
                return;
            }
        }

        FecharSecao(etapaOrigem);
        AbrirSecao(Math.Min(etapaOrigem + 1, 7));
    }

    private async Task<bool> SalvarEtapaAtualAsync()
    {
        if (OnSave == null)
        {
            return true;
        }

        var sucesso = await OnSave.Invoke(OrdemDeServico, false);
        if (!sucesso)
        {
            return false;
        }

        if (dosagemFormRef != null)
        {
            var dosagemOk = await dosagemFormRef.SalvarPendentesAsync(OrdemDeServico.IDOS);
            if (!dosagemOk)
            {
                secaoDosagemAberta = true;
                return false;
            }
        }

        return true;
    }

    // O modal é um componente filho fixo (só fica escondido via CSS), então OnInitialized
    // roda uma única vez pra sempre. Cada "Nova OS"/"Editar" troca a instância de
    // OrdemDeServico — é essa troca de referência que dispara a preparação abaixo,
    // não o ciclo de vida do componente em si.
    private OrdemDeServico? ordemInicializada;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(ordemInicializada, OrdemDeServico))
        {
            return;
        }

        ordemInicializada = OrdemDeServico;

        // Toda OS aberta começa com todos os acordeões fechados — o técnico escolhe o que
        // quer ver primeiro (ou usa Avançar/Anterior, que abrem a etapa certa sozinhos).
        mensagemErroValidacao = null;
        toastValidacaoVisible = false;
        etapaAtualIndex = 1;
        secaoDadosAberta = false;
        secaoRotaAberta = false;
        secaoAguaAntesAberta = false;
        secaoAguaDepoisAberta = false;
        secaoDosagemAberta = false;
        secaoFotosAberta = false;
        secaoChecklistAberta = false;
        secaoOcorrenciaAberta = false;
        dosagensAtuais = new List<DosagemProduto>();

        statusOriginal = OrdemDeServico.IDOS > 0 ? OrdemDeServico.Status : null;
        erroAprovacaoOcorrencia = null;
        var usuarioLogado = await AuthService.GetCurrentUserAsync();
        currentUserId = usuarioLogado?.IDUsuario;

        if (OrdemDeServico.DataExecucao == default)
        {
            OrdemDeServico.DataExecucao = DateTime.Today;
        }

        if (string.IsNullOrEmpty(OrdemDeServico.Status))
        {
            OrdemDeServico.Status = "Em Aberto";
        }

        dataExecucaoOriginal = OrdemDeServico.DataExecucao;
        clienteSelecionadoId = ClienteIdDaOS;

        // A transição "Em Aberto" -> "Em Andamento" ao iniciar o atendimento é decidida pelo
        // pai (OrdensServico.EditarOS), disparada só pelo clique explícito em Iniciar/Continuar
        // — não aqui, porque este modal (mesmo escondido) também recebe OrdemDeServico quando
        // o usuário só abre a Visualização, e abrir a Visualização não deve "iniciar" a OS.
        if (OrdemDeServico.IDOS == 0)
        {
            HoraInicioTime = TimeOnly.FromDateTime(DateTime.Now);
            HoraTerminoTime = HoraInicioTime;
        }

        // Busca as dosagens já registradas independente do acordeão "Dosagem de Produtos"
        // estar aberto — o checklist e o botão Finalizar precisam saber disso de cara.
        if (OrdemDeServico.IDOS > 0)
        {
            try
            {
                var dosagens = await ApiService.GetDosagensPorOSAsync(OrdemDeServico.IDOS);
                dosagensAtuais = dosagens.Where(d => d.Quantidade > 0).ToList();
            }
            catch
            {
                dosagensAtuais = new List<DosagemProduto>();
            }
        }

        AtualizarChecklistConcluido();
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    // Botão de voltar do topo: fecha este modal e avisa o pai — que decide se volta pra
    // Detalhes (OS já existente) ou pra lista (OS nova ainda não salva).
    private async Task Voltar()
    {
        await Close();
        await OnVoltar.InvokeAsync();
    }

    private async Task HandleSubmit()
    {
        var sucesso = OnSave == null || await OnSave.Invoke(OrdemDeServico, true);
        if (!sucesso)
        {
            return;
        }

        // A dosagem só pode ser gravada depois da OS existir de verdade (precisa de um IDOS
        // válido) — por isso roda aqui, logo após o OnSave acima, na mesma submissão do
        // Salvar/Finalizar, em vez de exigir um botão de salvar dosagem à parte.
        if (dosagemFormRef != null)
        {
            var dosagemOk = await dosagemFormRef.SalvarPendentesAsync(OrdemDeServico.IDOS);
            if (!dosagemOk)
            {
                secaoDosagemAberta = true;
                return;
            }
        }

        await OnSalvo.InvokeAsync(OrdemDeServico);
        await Close();
    }

    // A maioria dos campos com validação (Piscina, Técnico, Status/Observações, horários)
    // mora em "Dados Gerais" — se o Salvar falhar por validação, garante que essa seção
    // esteja visível para o usuário ver a mensagem, mesmo se ele tiver fechado o acordeão.
    [CascadingParameter] private EditContext? EditContext { get; set; }

    private string ObterClasseCampo(string nomeCampo, string classePadrao = "w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500")
    {
        if (EditContext == null)
        {
            return classePadrao;
        }

        var invalid = EditContext.GetValidationMessages(new FieldIdentifier(OrdemDeServico, nomeCampo)).Any();
        if (!invalid)
        {
            return classePadrao;
        }

        return "w-full bg-red-950/20 border border-red-500 rounded-lg px-3 py-2 text-red-50 shadow-[0_0_0_1px_rgba(239,68,68,0.35)] focus:border-red-400 focus:ring-2 focus:ring-red-500/60";
    }

    private void HandleInvalidSubmit()
    {
        mensagemErroValidacao = "Corrija os campos destacados antes de salvar a ordem de serviço.";
        toastValidacaoVisible = true;
        secaoDadosAberta = true;
    }
}
