@using GestaoPiscina.Client.Models

<div class="space-y-6">
    <div class="flex items-center justify-between mb-4">
        <h5 class="text-lg font-semibold text-slate-200 flex items-center">
            <i class="fas fa-robot text-cyan-400 mr-2"></i>Equipamentos
        </h5>
        @if (!ShowForm)
        {
            <button type="button" @onclick="OnCreate" class="bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white text-sm transition-colors">
                <i class="fas fa-plus mr-1"></i>Novo Equipamento
            </button>
        }
    </div>

    @if (ShowForm)
    {
        <div class="bg-slate-700 rounded-lg p-6 border border-slate-600">
            <div class="flex items-center justify-between mb-4">
                <h6 class="text-md font-semibold text-slate-200">
                    @(Equipamento.IDEquipamento > 0 ? "Editar Equipamento" : "Novo Equipamento")
                </h6>
                <button @onclick="OnClose" class="text-slate-400 hover:text-slate-300">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <EditForm Model="Equipamento" OnValidSubmit="OnSave" Context="equipamentoContext">
                <DataAnnotationsValidator />
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Tipo *</label>
                        <InputText @bind-Value="Equipamento.Tipo" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-800 !text-slate-800" placeholder="Ex: Bomba, Filtro..." style="color: #1e293b !important;" />
                        <ValidationMessage For="@(() => Equipamento.Tipo)" class="text-red-500 text-sm" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Número de Série *</label>
                        <InputText @bind-Value="Equipamento.NumeroSerie" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-800 !text-slate-800" placeholder="Número de série" style="color: #1e293b !important;" />
                        <ValidationMessage For="@(() => Equipamento.NumeroSerie)" class="text-red-500 text-sm" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Última Calibragem</label>
                        <InputDate @bind-Value="Equipamento.UltimaCalibragem" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-800 !text-slate-800" style="color: #1e293b !important;" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Observações</label>
                        <InputTextArea @bind-Value="Equipamento.Observacao" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-800 !text-slate-800" rows="3" placeholder="Observações adicionais..." style="color: #1e293b !important;" />
                    </div>
                </div>
                
                <div class="flex space-x-3 mt-8">
                    <button type="submit" class="bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 focus:ring-offset-slate-800">
                        <i class="fas fa-save mr-2"></i>Salvar
                    </button>
                    <button type="button" @onclick="OnClose" class="bg-slate-600 hover:bg-slate-500 px-3 py-2 rounded-lg text-white transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 focus:ring-offset-slate-800">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    }
    
    @if ((Equipamentos != null && Equipamentos.Any()) || EquipamentosTemporarios.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @if (Equipamentos != null)
            {
                @foreach (var equipamento in Equipamentos)
                {
                    <div class="bg-slate-800 rounded-xl p-4 space-y-3">
                        <div class="flex justify-between items-start">
                            <div class="flex-1">
                                <h4 class="text-sm font-medium text-slate-100">@equipamento.Tipo</h4>
                                <span class="text-sm text-slate-400">Série: @equipamento.NumeroSerie</span>
                            </div>
                            <div class="flex space-x-3 ml-4">
                                <button @onclick="() => OnEdit.InvokeAsync(equipamento)" class="text-cyan-400 hover:text-cyan-300 p-2 rounded transition-colors" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button @onclick="() => OnDelete.InvokeAsync(equipamento)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Excluir">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="space-y-2">
                            @if (equipamento.UltimaCalibragem.HasValue)
                            {
                                <div class="text-sm text-slate-400">
                                    <i class="fas fa-calendar-alt text-slate-500 mr-2"></i>
                                    Última Calibragem: @equipamento.UltimaCalibragem.Value.ToShortDateString()
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            
            @foreach (var equipamento in EquipamentosTemporarios)
            {
                <div class="bg-slate-700 rounded-xl p-4 space-y-3 border-2 border-dashed border-cyan-400">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <h4 class="text-sm font-medium text-slate-100">@equipamento.Tipo</h4>
                            <span class="text-sm text-slate-400">Série: @equipamento.NumeroSerie</span>
                            <span class="text-xs text-cyan-400 bg-cyan-900 px-2 py-1 rounded">Temporário</span>
                        </div>
                        <div class="flex space-x-3 ml-4">
                            <button @onclick="() => OnRemoveTemporario.InvokeAsync(equipamento)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Remover">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="space-y-2">
                        @if (equipamento.UltimaCalibragem.HasValue)
                        {
                            <div class="text-sm text-slate-400">
                                <i class="fas fa-calendar-alt text-slate-500 mr-2"></i>
                                Última Calibragem: @equipamento.UltimaCalibragem.Value.ToShortDateString()
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (!ShowForm && (ClienteId > 0 || EquipamentosTemporarios.Any()))
    {
        <div class="text-center py-8 text-slate-400">
            <i class="fas fa-robot text-4xl mb-4"></i>
            <p class="text-lg">Nenhum equipamento cadastrado</p>
            <p class="text-sm mt-2">Clique em "Novo Equipamento" para adicionar</p>
        </div>
    }
    else if (ClienteId <= 0 && !EquipamentosTemporarios.Any())
    {
        <div class="text-center py-8 text-slate-400">
            <i class="fas fa-user-plus text-4xl mb-4"></i>
            <p class="text-lg">Cliente não salvo</p>
            <p class="text-sm mt-2">Salve o cliente primeiro para gerenciar equipamentos</p>
        </div>
    }
</div>

@code {
    [Parameter] public int ClienteId { get; set; }
    [Parameter] public List<Equipamento>? Equipamentos { get; set; }
    [Parameter] public List<Equipamento> EquipamentosTemporarios { get; set; } = new();
    [Parameter] public Equipamento Equipamento { get; set; } = new();
    [Parameter] public bool ShowForm { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EditContext> OnSave { get; set; }
    [Parameter] public EventCallback<Equipamento> OnEdit { get; set; }
    [Parameter] public EventCallback<Equipamento> OnDelete { get; set; }
    [Parameter] public EventCallback<Equipamento> OnRemoveTemporario { get; set; }
}