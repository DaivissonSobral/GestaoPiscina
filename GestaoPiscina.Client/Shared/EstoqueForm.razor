@using GestaoPiscina.Client.Models

<div class="space-y-6">
    <div class="flex items-center justify-between mb-4">
        <h5 class="text-lg font-semibold text-slate-200 flex items-center">
            <i class="fas fa-box text-cyan-400 mr-2"></i>Estoque do Cliente
        </h5>
        @if (!ShowForm)
        {
            <button type="button" @onclick="OnCreate" class="bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white text-sm transition-colors">
                <i class="fas fa-plus mr-1"></i>Novo Item no Estoque
            </button>
        }
    </div>

    @if (ShowForm)
    {
        <div class="bg-slate-700 rounded-lg p-6 border border-slate-600">
            <div class="flex items-center justify-between mb-4">
                <h6 class="text-md font-semibold text-slate-200">
                    @(Estoque.IDEstoque > 0 ? "Editar Item do Estoque" : "Novo Item no Estoque")
                </h6>
                <button @onclick="OnClose" class="text-slate-400 hover:text-slate-300">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <EditForm Model="Estoque" OnValidSubmit="OnSave" Context="estoqueContext">
                <DataAnnotationsValidator />
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Produto *</label>
                        <InputSelect TValue="int" Value="SelectedProdutoId" ValueChanged="OnProdutoSelected" ValueExpression="() => SelectedProdutoId" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-100" style="color: #f1f5f9 !important;">
                            <option value="0">Selecione um produto...</option>
                            @if (Produtos != null)
                            {
                                @foreach (var produto in Produtos)
                                {
                                    <option value="@produto.IDProduto">@produto.Nome @(produto.Concentracao.HasValue ? $"({produto.Concentracao})" : "") @(string.IsNullOrEmpty(produto.Unidade) ? "" : $"({produto.Unidade})")</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Estoque.Produto.Nome)" class="text-red-500 text-sm" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Quantidade Atual *</label>
                        <InputNumber @bind-Value="Estoque.QuantidadeAtual" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-100" placeholder="0.00" style="color: #f1f5f9 !important;" />
                        <ValidationMessage For="@(() => Estoque.QuantidadeAtual)" class="text-red-500 text-sm" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Quantidade Mínima</label>
                        <InputNumber @bind-Value="Estoque.QuantidadeMinima" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-100" placeholder="0.00" style="color: #f1f5f9 !important;" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Unidade</label>
                        <InputText @bind-Value="Estoque.Produto.Unidade" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-100" readonly style="color: #f1f5f9 !important;" />
                    </div>
                    
                    <div class="md:col-span-2 space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Concentração</label>
                        <InputNumber @bind-Value="Estoque.Produto.Concentracao" class="w-full bg-slate-600 border border-slate-500 rounded-lg px-3 py-2 text-slate-100" readonly style="color: #f1f5f9 !important;" />
                    </div>
                </div>
                
                <div class="flex space-x-3 mt-8">
                    <button type="submit" class="bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 focus:ring-offset-slate-800">
                        <i class="fas fa-save mr-2"></i>Salvar
                    </button>
                    <button type="button" @onclick="OnClose" class="bg-slate-600 hover:bg-slate-500 px-3 py-2 rounded-lg text-white transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 focus:ring-offset-slate-800">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    }
    
    @if ((Estoques != null && Estoques.Any()) || EstoquesTemporarios.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @if (Estoques != null)
            {
                @foreach (var estoque in Estoques)
                {
                    <div class="bg-slate-800 rounded-xl p-4 space-y-3">
                        <div class="flex justify-between items-start">
                            <div class="flex-1">
                                <h4 class="text-sm font-medium text-slate-100">@estoque.Produto.Nome</h4>
                                <span class="text-sm text-slate-400">Quantidade: @estoque.QuantidadeAtual @estoque.Produto.Unidade</span>
                            </div>
                            <div class="flex space-x-3 ml-4">
                                <button @onclick="() => OnEdit.InvokeAsync(estoque)" class="text-cyan-400 hover:text-cyan-300 p-2 rounded transition-colors" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button @onclick="() => OnDelete.InvokeAsync(estoque)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Excluir">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="space-y-2">
                            @if (estoque.Produto.Concentracao.HasValue)
                            {
                                <div class="text-sm text-slate-400">
                                    <i class="fas fa-percentage text-slate-500 mr-2"></i>
                                    Concentração: @estoque.Produto.Concentracao
                                </div>
                            }
                            @if (estoque.QuantidadeMinima.HasValue)
                            {
                                <div class="text-sm text-slate-400">
                                    <i class="fas fa-exclamation-triangle text-slate-500 mr-2"></i>
                                    Mínimo: @estoque.QuantidadeMinima @estoque.Produto.Unidade
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            
            @foreach (var estoque in EstoquesTemporarios)
            {
                <div class="bg-slate-700 rounded-xl p-4 space-y-3 border-2 border-dashed border-cyan-400">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <h4 class="text-sm font-medium text-slate-100">@estoque.Produto.Nome</h4>
                            <span class="text-sm text-slate-400">Quantidade: @estoque.QuantidadeAtual @estoque.Produto.Unidade</span>
                            <span class="text-xs text-cyan-400 bg-cyan-900 px-2 py-1 rounded">Temporário</span>
                        </div>
                        <div class="flex space-x-3 ml-4">
                            <button @onclick="() => OnRemoveTemporario.InvokeAsync(estoque)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Remover">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="space-y-2">
                        @if (estoque.Produto.Concentracao.HasValue)
                        {
                            <div class="text-sm text-slate-400">
                                <i class="fas fa-percentage text-slate-500 mr-2"></i>
                                Concentração: @estoque.Produto.Concentracao
                            </div>
                        }
                        @if (estoque.QuantidadeMinima.HasValue)
                        {
                            <div class="text-sm text-slate-400">
                                <i class="fas fa-exclamation-triangle text-slate-500 mr-2"></i>
                                Mínimo: @estoque.QuantidadeMinima @estoque.Produto.Unidade
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (!ShowForm && (ClienteId > 0 || EstoquesTemporarios.Any()))
    {
        <div class="text-center py-8 text-slate-400">
            <i class="fas fa-box text-4xl mb-4"></i>
            <p class="text-lg">Nenhum item no estoque</p>
            <p class="text-sm mt-2">Clique em "Novo Item no Estoque" para adicionar</p>
        </div>
    }
    else if (ClienteId <= 0 && !EstoquesTemporarios.Any())
    {
        <div class="text-center py-8 text-slate-400">
            <i class="fas fa-user-plus text-4xl mb-4"></i>
            <p class="text-lg">Cliente não salvo</p>
            <p class="text-sm mt-2">Salve o cliente primeiro para gerenciar estoque</p>
        </div>
    }
</div>

@code {
    [Parameter] public int ClienteId { get; set; }
    [Parameter] public List<EstoqueCliente>? Estoques { get; set; }
    [Parameter] public List<EstoqueCliente> EstoquesTemporarios { get; set; } = new();
    [Parameter] public List<Produto>? Produtos { get; set; }
    [Parameter] public EstoqueCliente Estoque { get; set; } = new();
    [Parameter] public int SelectedProdutoId { get; set; }
    [Parameter] public bool ShowForm { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EditContext> OnSave { get; set; }
    [Parameter] public EventCallback<EstoqueCliente> OnEdit { get; set; }
    [Parameter] public EventCallback<EstoqueCliente> OnDelete { get; set; }
    [Parameter] public EventCallback<EstoqueCliente> OnRemoveTemporario { get; set; }
    [Parameter] public EventCallback<int> OnProdutoSelected { get; set; }
}