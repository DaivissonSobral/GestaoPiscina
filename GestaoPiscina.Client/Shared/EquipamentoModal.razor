@using GestaoPiscina.Client.Models

<div class="fixed inset-0 bg-black bg-opacity-50 flex items-start justify-center z-50 pt-8 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 rounded-xl p-6 w-full max-w-md mx-4 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-slate-100">
                @(Equipamento.IDEquipamento > 0 ? "Editar Equipamento" : "Novo Equipamento")
            </h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <EditForm Model="Equipamento" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                @if (ClienteId <= 0)
                {
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2">Cliente *</label>
                        <InputSelect TValue="int" Value="Equipamento.IDCliente" ValueChanged="OnClienteChanged" ValueExpression="() => Equipamento.IDCliente" disabled="@(Equipamento.IDEquipamento > 0)" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 disabled:opacity-60 disabled:cursor-not-allowed">
                            <option value="0">Selecione...</option>
                            @if (Clientes != null)
                            {
                                @foreach (var cliente in Clientes)
                                {
                                    <option value="@cliente.IDCliente">@cliente.Nome</option>
                                }
                            }
                        </InputSelect>
                        @if (Equipamento.IDEquipamento > 0)
                        {
                            <p class="text-xs text-slate-400">O cliente não pode ser alterado após o cadastro.</p>
                        }
                    </div>
                }

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Descrição *</label>
                    <InputText @bind-Value="Equipamento.Descricao" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Ex: Bomba, Filtro..." />
                    <ValidationMessage For="@(() => Equipamento.Descricao)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Número de Série *</label>
                    <InputText @bind-Value="Equipamento.NumeroSerie" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Número de série" />
                    <ValidationMessage For="@(() => Equipamento.NumeroSerie)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Última Calibragem</label>
                    <InputDate @bind-Value="Equipamento.UltimaCalibragem" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Observações</label>
                    <InputTextArea @bind-Value="Equipamento.Observacao" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" rows="3" placeholder="Observações adicionais..." />
                    <ValidationMessage For="@(() => Equipamento.Observacao)" class="text-red-500 text-sm" />
                </div>
            </div>

            @if (erro != null)
            {
                <p class="text-red-500 text-sm mt-4"><i class="fas fa-exclamation-circle mr-1"></i>@erro</p>
            }

            <div class="flex space-x-3 mt-6">
                <button type="submit" class="flex-1 bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas fa-save mr-2"></i>Salvar
                </button>
                <button type="button" @onclick="Close" class="flex-1 bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded-lg text-white transition-colors">
                    Cancelar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Equipamento Equipamento { get; set; } = new Equipamento();
    [Parameter] public List<Cliente>? Clientes { get; set; }
    // Quando > 0, o modal é usado num contexto de cliente já fixado (aba Equipamentos do
    // cadastro de cliente): o seletor de Cliente fica oculto e o ID é aplicado direto.
    // Quando 0, é o uso "global" (lista de Equipamentos), com o seletor de Cliente visível.
    [Parameter] public int ClienteId { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<Equipamento> OnSave { get; set; }

    private string? erro;

    private void OnClienteChanged(int clienteId)
    {
        Equipamento.IDCliente = clienteId;
    }

    private async Task Close()
    {
        erro = null;
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        if (ClienteId > 0)
        {
            Equipamento.IDCliente = ClienteId;
        }
        else if (Equipamento.IDCliente <= 0)
        {
            erro = "Selecione um cliente.";
            return;
        }

        erro = null;
        await OnSave.InvokeAsync(Equipamento);
        await Close();
    }
}
