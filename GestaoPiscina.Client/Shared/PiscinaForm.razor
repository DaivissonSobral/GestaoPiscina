@using GestaoPiscina.Client.Models

<div class="space-y-6">
    <div class="flex items-center justify-between mb-4">
        <h5 class="text-lg font-semibold text-slate-200 flex items-center">
            <i class="fas fa-swimming-pool text-cyan-400 mr-2"></i>Piscinas
        </h5>
        @if (!ShowForm)
        {
            <button type="button" @onclick="OnCreate" class="bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white text-sm transition-colors">
                <i class="fas fa-plus mr-1"></i>Nova Piscina
            </button>
        }
    </div>

    @if (ShowForm)
    {
        <div class="bg-slate-700 rounded-lg p-6 border border-slate-600">
            <div class="flex items-center justify-between mb-4">
                <h6 class="text-md font-semibold text-slate-200">
                    @(Piscina.IDPiscina > 0 ? "Editar Piscina" : "Nova Piscina")
                </h6>
                <button type="button" @onclick="OnClose" class="text-slate-400 hover:text-slate-300">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <EditForm Model="Piscina" OnValidSubmit="OnSave" Context="piscinaContext">
                <DataAnnotationsValidator />
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Tipo *</label>
                        <InputSelect @bind-Value="Piscina.Tipo" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" style="background-color: white !important; color: #111827 !important;">
                            <option value="">Selecione...</option>
                            <option value="adulto">Adulto</option>
                            <option value="infantil">Infantil</option>
                            <option value="espelho">Espelho d'água</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Piscina.Tipo)" class="text-red-500 text-sm" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Volume (Litros) *</label>
                        <InputNumber @bind-Value="Piscina.VolumeLitros" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" placeholder="Ex: 50000" style="background-color: white !important; color: #111827 !important;" />
                        <ValidationMessage For="@(() => Piscina.VolumeLitros)" class="text-red-500 text-sm" />
                    </div>
                    
                    <div class="space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Coberta *</label>
                        <InputSelect @bind-Value="Piscina.Coberta" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" style="background-color: white !important; color: #111827 !important;">
                            <option value="">Selecione...</option>
                            <option value="Sim">Sim</option>
                            <option value="Não">Não</option>
                            <option value="Parcial">Parcial</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Piscina.Coberta)" class="text-red-500 text-sm" />
                    </div>

                    <div class="space-y-3 flex items-center">
                        <label class="flex items-center space-x-2 text-sm font-medium text-slate-300 mt-6">
                            <InputCheckbox @bind-Value="Piscina.Aquecida" class="rounded" />
                            <span>Aquecida</span>
                        </label>
                    </div>

                    <div class="md:col-span-2 space-y-3">
                        <label class="block text-sm font-medium text-slate-300 mb-2">Localização</label>
                        <InputText @bind-Value="Piscina.Localizacao" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500" placeholder="Ex: Fundos, Lateral..." style="background-color: white !important; color: #111827 !important;" />
                    </div>

                    <div class="md:col-span-2 space-y-3 bg-slate-800 rounded-lg p-4 border border-slate-600">
                        <label class="block text-sm font-medium text-slate-300">
                            <i class="fas fa-redo text-cyan-400 mr-2"></i>Periodicidade de Limpeza
                        </label>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-xs text-slate-400">Repetir</label>
                                <InputSelect TValue="string" Value="Piscina.RecorrenciaFrequencia" ValueChanged="OnFrequenciaChanged" ValueExpression="() => Piscina.RecorrenciaFrequencia" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900" style="background-color: white !important; color: #111827 !important;">
                                    <option value="Nenhuma">Não se repete</option>
                                    <option value="Diaria">Diariamente</option>
                                    <option value="Semanal">Semanalmente</option>
                                    <option value="Mensal">Mensalmente</option>
                                </InputSelect>
                            </div>

                            @if (Piscina.RecorrenciaFrequencia != "Nenhuma")
                            {
                                <div class="space-y-2">
                                    <label class="block text-xs text-slate-400">Data de início</label>
                                    <InputDate @bind-Value="Piscina.RecorrenciaDataInicio" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900" style="background-color: white !important; color: #111827 !important;" />
                                </div>

                                <div class="space-y-2">
                                    <label class="block text-xs text-slate-400">Repetir a cada</label>
                                    <div class="flex items-center space-x-2">
                                        <InputNumber @bind-Value="Piscina.RecorrenciaIntervalo" class="w-20 bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900" style="background-color: white !important; color: #111827 !important;" min="1" />
                                        <span class="text-sm text-slate-300">@UnidadeIntervalo</span>
                                    </div>
                                </div>

                                @if (Piscina.RecorrenciaFrequencia == "Semanal")
                                {
                                    <div class="md:col-span-2 space-y-2">
                                        <label class="block text-xs text-slate-400">Repetir nos dias</label>
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var dia in diasSemana)
                                            {
                                                <button type="button" @onclick="() => ToggleDiaSemana(dia)"
                                                        class="@(DiasSemanaSelecionados.Contains(dia) ? "bg-cyan-600 text-white" : "bg-slate-600 text-slate-300 hover:bg-slate-500") w-10 h-10 rounded-full text-xs font-semibold transition-colors">
                                                    @dia.Substring(0, 1)
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="md:col-span-2 space-y-2">
                                    <label class="block text-xs text-slate-400">Termina</label>
                                    <InputRadioGroup @bind-Value="Piscina.RecorrenciaTermino" class="space-y-2 block">
                                        <div class="flex items-center space-x-2">
                                            <InputRadio Value="@("Nunca")" />
                                            <span class="text-sm text-slate-300">Nunca</span>
                                        </div>
                                        <div class="flex items-center space-x-2">
                                            <InputRadio Value="@("Data")" />
                                            <span class="text-sm text-slate-300">Em</span>
                                            <InputDate @bind-Value="Piscina.RecorrenciaDataFim" disabled="@(Piscina.RecorrenciaTermino != "Data")" class="bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900 disabled:opacity-50" style="background-color: white !important; color: #111827 !important;" />
                                        </div>
                                        <div class="flex items-center space-x-2">
                                            <InputRadio Value="@("Ocorrencias")" />
                                            <span class="text-sm text-slate-300">Após</span>
                                            <InputNumber @bind-Value="Piscina.RecorrenciaOcorrencias" disabled="@(Piscina.RecorrenciaTermino != "Ocorrencias")" class="w-20 bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-900 disabled:opacity-50" style="background-color: white !important; color: #111827 !important;" min="1" />
                                            <span class="text-sm text-slate-300">ocorrência(s)</span>
                                        </div>
                                    </InputRadioGroup>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="flex space-x-3 mt-8">
                    <button type="submit" class="bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 focus:ring-offset-slate-800">
                        <i class="fas fa-save mr-2"></i>Salvar
                    </button>
                    <button type="button" @onclick="OnClose" class="bg-slate-600 hover:bg-slate-500 px-3 py-2 rounded-lg text-white transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 focus:ring-offset-slate-800">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    }
    
    @if ((Piscinas != null && Piscinas.Any()) || PiscinasTemporarias.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @if (Piscinas != null)
            {
                @foreach (var piscina in Piscinas)
                {
                    <div class="bg-slate-800 rounded-xl p-4 space-y-3">
                        <div class="flex justify-between items-start">
                            <div class="flex-1">
                                <h4 class="text-sm font-medium text-slate-100">@piscina.Tipo</h4>
                                <span class="text-sm text-slate-400">Volume: @piscina.VolumeLitros L</span>
                            </div>
                            <div class="flex space-x-3 ml-4">
                                <button type="button" @onclick="() => OnEdit.InvokeAsync(piscina)" class="text-cyan-400 hover:text-cyan-300 p-2 rounded transition-colors" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" @onclick="() => OnDelete.InvokeAsync(piscina)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Excluir">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="space-y-2">
                            @if (!string.IsNullOrEmpty(piscina.Localizacao))
                            {
                                <div class="text-sm text-slate-400">
                                    <i class="fas fa-map-marker-alt text-slate-500 mr-2"></i>
                                    @piscina.Localizacao
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            
            @foreach (var piscina in PiscinasTemporarias)
            {
                <div class="bg-slate-700 rounded-xl p-4 space-y-3 border-2 border-dashed border-cyan-400">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <h4 class="text-sm font-medium text-slate-100">@piscina.Tipo</h4>
                            <span class="text-sm text-slate-400">Volume: @piscina.VolumeLitros L</span>
                            <span class="text-xs text-cyan-400 bg-cyan-900 px-2 py-1 rounded">Temporário</span>
                        </div>
                        <div class="flex space-x-3 ml-4">
                            <button type="button" @onclick="() => OnRemoveTemporario.InvokeAsync(piscina)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Remover">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="space-y-2">
                        @if (!string.IsNullOrEmpty(piscina.Localizacao))
                        {
                            <div class="text-sm text-slate-400">
                                <i class="fas fa-map-marker-alt text-slate-500 mr-2"></i>
                                @piscina.Localizacao
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (!ShowForm && (ClienteId > 0 || PiscinasTemporarias.Any()))
    {
        <div class="text-center py-8 text-slate-400">
            <i class="fas fa-swimming-pool text-4xl mb-4"></i>
            <p class="text-lg">Nenhuma piscina cadastrada</p>
            <p class="text-sm mt-2">Clique em "Nova Piscina" para adicionar</p>
        </div>
    }
    else if (ClienteId <= 0 && !PiscinasTemporarias.Any())
    {
        <div class="text-center py-8 text-slate-400">
            <i class="fas fa-user-plus text-4xl mb-4"></i>
            <p class="text-lg">Cliente não salvo</p>
            <p class="text-sm mt-2">Salve o cliente primeiro para gerenciar piscinas</p>
        </div>
    }
</div>

@code {
    [Parameter] public int ClienteId { get; set; }
    [Parameter] public List<Piscina>? Piscinas { get; set; }
    [Parameter] public List<Piscina> PiscinasTemporarias { get; set; } = new();
    [Parameter] public Piscina Piscina { get; set; } = new();
    [Parameter] public bool ShowForm { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EditContext> OnSave { get; set; }
    [Parameter] public EventCallback<Piscina> OnEdit { get; set; }
    [Parameter] public EventCallback<Piscina> OnDelete { get; set; }
    [Parameter] public EventCallback<Piscina> OnRemoveTemporario { get; set; }

    private readonly string[] diasSemana = { "Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sab" };

    private List<string> DiasSemanaSelecionados =>
        (Piscina.RecorrenciaDiasSemana ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();

    private string UnidadeIntervalo => Piscina.RecorrenciaFrequencia switch
    {
        "Diaria" => Piscina.RecorrenciaIntervalo == 1 ? "dia" : "dias",
        "Semanal" => Piscina.RecorrenciaIntervalo == 1 ? "semana" : "semanas",
        "Mensal" => Piscina.RecorrenciaIntervalo == 1 ? "mês" : "meses",
        _ => ""
    };

    private void OnFrequenciaChanged(string frequencia)
    {
        Piscina.RecorrenciaFrequencia = frequencia;
        if (frequencia != "Nenhuma" && Piscina.RecorrenciaDataInicio == null)
        {
            Piscina.RecorrenciaDataInicio = DateTime.Today;
        }
    }

    private void ToggleDiaSemana(string dia)
    {
        var dias = DiasSemanaSelecionados;
        if (!dias.Remove(dia))
        {
            dias.Add(dia);
        }

        Piscina.RecorrenciaDiasSemana = string.Join(",", diasSemana.Where(d => dias.Contains(d)));
    }
}