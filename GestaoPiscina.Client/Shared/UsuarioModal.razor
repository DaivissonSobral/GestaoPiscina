@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ApiService ApiService
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-50 flex sm:items-start justify-center z-50 sm:pt-8 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 w-full h-full sm:h-auto sm:rounded-xl sm:max-w-md sm:mx-4 sm:max-h-[90vh] flex flex-col">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-slate-100">
                @(ModoPerfil ? "Perfil" : (Usuario.IDUsuario > 0 ? "Editar Usuário" : "Novo Usuário"))
            </h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <EditForm Model="Usuario" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <div class="flex justify-center">
                    <div class="relative w-24 h-24">
                        @if (!string.IsNullOrEmpty(Usuario.FotoUrl))
                        {
                            <img src="@Usuario.FotoUrl" alt="Foto de perfil" class="w-24 h-24 rounded-full object-cover border border-slate-600" />
                        }
                        else
                        {
                            <div class="w-24 h-24 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center text-slate-400">
                                <i class="fas fa-user text-3xl"></i>
                            </div>
                        }
                        <label class="absolute bottom-0 right-0 w-8 h-8 rounded-full bg-cyan-600 hover:bg-cyan-500 text-white flex items-center justify-center cursor-pointer transition-colors" title="Trocar foto">
                            @if (enviandoFoto)
                            {
                                <i class="fas fa-spinner fa-spin text-sm"></i>
                            }
                            else
                            {
                                <i class="fas fa-camera text-sm"></i>
                            }
                            <InputFile OnChange="OnArquivoSelecionado" accept="image/*" class="hidden" disabled="@enviandoFoto" />
                        </label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(erroFoto))
                {
                    <p class="text-red-400 text-xs text-center">@erroFoto</p>
                }

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Nome *</label>
                    <InputText @bind-Value="Usuario.Nome" disabled="@CamposSensiveisBloqueados" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 disabled:opacity-60 disabled:cursor-not-allowed" placeholder="Nome completo" />
                    <ValidationMessage For="@(() => Usuario.Nome)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">E-mail *</label>
                    <InputText @bind-Value="Usuario.Email" disabled="@CamposSensiveisBloqueados" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 disabled:opacity-60 disabled:cursor-not-allowed" placeholder="email@exemplo.com" />
                    <ValidationMessage For="@(() => Usuario.Email)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Login *</label>
                    <InputText @bind-Value="Usuario.Login" disabled="@CamposSensiveisBloqueados" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 disabled:opacity-60 disabled:cursor-not-allowed" placeholder="Usado para entrar no sistema" />
                    <ValidationMessage For="@(() => Usuario.Login)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Perfil *</label>
                    <InputSelect @bind-Value="Usuario.IDPerfil" disabled="@CamposSensiveisBloqueados" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100 disabled:opacity-60 disabled:cursor-not-allowed">
                        <option value="0">Selecione...</option>
                        @if (Perfis != null)
                        {
                            @foreach (var perfil in Perfis)
                            {
                                <option value="@perfil.IDPerfil">@perfil.Nome</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Usuario.IDPerfil)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Endereço@(EnderecoObrigatorio ? " *" : "")</label>
                    <InputText @bind-Value="Usuario.Endereco" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Endereço completo" />
                    @if (!string.IsNullOrEmpty(erroEndereco))
                    {
                        <p class="text-red-500 text-sm">@erroEndereco</p>
                    }
                </div>

                @if (!ModoPerfil)
                {
                    @if (Usuario.IDUsuario == 0)
                    {
                        <div>
                            <label class="block text-sm font-medium text-slate-300 mb-2">Senha Inicial *</label>
                            <InputText type="password" @bind-Value="Usuario.SenhaInicial" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Mínimo 6 caracteres" />
                            @if (!string.IsNullOrEmpty(erroSenha))
                            {
                                <p class="text-red-500 text-sm">@erroSenha</p>
                            }
                            <p class="text-xs text-slate-400 mt-1">O usuário pode trocar depois em "Alterar Senha".</p>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center">
                            <InputCheckbox @bind-Value="Usuario.Ativo" class="mr-2" id="usuario-ativo" />
                            <label for="usuario-ativo" class="text-sm font-medium text-slate-300">Usuário ativo</label>
                        </div>
                    }
                }
            </div>

            @if (!string.IsNullOrEmpty(erroPerfil))
            {
                <p class="text-red-500 text-sm mt-4">@erroPerfil</p>
            }

            <div class="flex space-x-3 mt-6">
                <button type="submit" disabled="@salvandoPerfil" class="flex-1 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas @(salvandoPerfil ? "fa-spinner fa-spin" : "fa-save") mr-2"></i>Salvar
                </button>
                <button type="button" @onclick="Close" class="flex-1 bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded-lg text-white transition-colors">
                    Cancelar
                </button>
            </div>
        </EditForm>
    </div>
</div>

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-70 flex items-center justify-center z-[60] @(cropModalVisible ? "" : "hidden")">
    <div class="bg-slate-800 rounded-xl p-6 w-full max-w-sm mx-4">
        <h4 class="text-slate-100 font-semibold mb-1">Ajustar foto</h4>
        <p class="text-slate-400 text-xs mb-3">Arraste a imagem para posicionar o rosto e use o controle para aproximar.</p>
        <div class="flex justify-center mb-3">
            <canvas id="@CropCanvasId" width="280" height="280" class="rounded-lg bg-slate-900 touch-none cursor-move"></canvas>
        </div>
        <input type="range" min="0" max="100" value="0" @oninput="OnZoomChange" class="w-full mb-4" />
        @if (!string.IsNullOrEmpty(erroFoto))
        {
            <p class="text-red-400 text-xs text-center mb-2">@erroFoto</p>
        }
        <div class="flex space-x-3">
            <button type="button" @onclick="ConfirmarCropAsync" disabled="@enviandoFoto" class="flex-1 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 px-4 py-2 rounded-lg text-white transition-colors">
                <i class="fas @(enviandoFoto ? "fa-spinner fa-spin" : "fa-check") mr-2"></i>Aplicar
            </button>
            <button type="button" @onclick="CancelarCrop" disabled="@enviandoFoto" class="flex-1 bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded-lg text-white transition-colors">
                Cancelar
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public UsuarioAdmin Usuario { get; set; } = new UsuarioAdmin();
    [Parameter] public List<Perfil>? Perfis { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<UsuarioAdmin> OnSave { get; set; }

    // Modo "Perfil": o próprio usuário logado editando a si mesmo (aberto pelo TopBar),
    // em vez do cadastro administrativo normal. Nome/E-mail/Login/Perfil só ficam
    // editáveis quando PodeEditarCamposSensiveis é true (usuário com permissão de
    // gerenciar usuários, ex.: Gestor) — Ativo e Senha Inicial nunca aparecem aqui,
    // já que autodesativação não faz sentido e a senha tem fluxo próprio ("Trocar minha senha").
    [Parameter] public bool ModoPerfil { get; set; }
    [Parameter] public bool PodeEditarCamposSensiveis { get; set; }
    // Chamado (com o UsuarioInfo já atualizado pelo servidor) só quando o salvamento do
    // Perfil dá certo — quem escuta (TopBar) usa isso pra atualizar o cache/avatar.
    [Parameter] public EventCallback<Models.UsuarioInfo> OnPerfilSalvo { get; set; }

    private bool CamposSensiveisBloqueados => ModoPerfil && !PodeEditarCamposSensiveis;

    // Só Técnico e Supervisor precisam de endereço (vão até o cliente) — mesma regra
    // aplicada no servidor (ver UsuariosController.PerfisComEnderecoObrigatorio).
    private static readonly HashSet<string> PerfisComEnderecoObrigatorio = new() { "Técnico", "Supervisor" };

    private bool EnderecoObrigatorio =>
        Perfis?.FirstOrDefault(p => p.IDPerfil == Usuario.IDPerfil) is { } perfil
        && PerfisComEnderecoObrigatorio.Contains(perfil.Nome);

    private string? erroSenha;
    private bool enviandoFoto;
    private string? erroFoto;
    private bool salvandoPerfil;
    private string? erroPerfil;
    private string? erroEndereco;

    private bool cropModalVisible;
    // Precisa ser único por instância: a TopBar (modal "Perfil") e a tela de Gestão de
    // Usuários (cadastro/edição) montam cada uma o seu próprio UsuarioModal ao mesmo tempo
    // — com um id fixo, document.getElementById sempre acharia o canvas da primeira
    // instância montada, deixando o recorte da outra tela sempre em branco.
    private readonly string CropCanvasId = $"cropper-canvas-usuario-{Guid.NewGuid():N}";
    private const long TamanhoMaximoFoto = 15 * 1024 * 1024;

    // Em vez de subir o arquivo direto, primeiro carrega a imagem escolhida no canvas de
    // recorte (ver imageCropper.js) — o usuário posiciona/amplia até enquadrar o rosto
    // antes de gerar o arquivo final que vai pro servidor. O conteúdo do arquivo é passado
    // pro JS via DotNetStreamReference (forma oficial de streaming .NET -> JS), em vez de
    // depender de ler o <input type=file> diretamente do lado do JS — mais confiável entre
    // navegadores/dispositivos do que expor o elemento por referência.
    private async Task OnArquivoSelecionado(InputFileChangeEventArgs e)
    {
        erroFoto = null;
        try
        {
            using var stream = e.File.OpenReadStream(TamanhoMaximoFoto);
            using var streamRef = new DotNetStreamReference(stream, leaveOpen: false);
            var ok = await JSRuntime.InvokeAsync<bool>("gestaoPiscinaCropper.iniciarComStream", CropCanvasId, streamRef);
            if (!ok)
            {
                erroFoto = "Não foi possível carregar a imagem selecionada. Tente outro arquivo.";
                return;
            }

            cropModalVisible = true;
        }
        catch (Exception ex)
        {
            erroFoto = $"Erro ao carregar a imagem: {ex.Message}";
        }
    }

    private async Task OnZoomChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var valor))
        {
            await JSRuntime.InvokeVoidAsync("gestaoPiscinaCropper.zoom", CropCanvasId, valor);
        }
    }

    private async Task ConfirmarCropAsync()
    {
        erroFoto = null;
        enviandoFoto = true;
        try
        {
            var base64 = await JSRuntime.InvokeAsync<string?>("gestaoPiscinaCropper.exportar", CropCanvasId, 400);
            if (string.IsNullOrEmpty(base64))
            {
                throw new Exception("Não foi possível processar a imagem.");
            }

            var bytes = Convert.FromBase64String(base64);
            Usuario.FotoUrl = await ApiService.UploadFotoAsync(bytes, "foto.jpg", "image/jpeg", "usuarios");
            await JSRuntime.InvokeVoidAsync("gestaoPiscinaCropper.descartar", CropCanvasId);
            cropModalVisible = false;
        }
        catch (Exception ex)
        {
            erroFoto = ex.Message;
        }
        finally
        {
            enviandoFoto = false;
        }
    }

    private async Task CancelarCrop()
    {
        await JSRuntime.InvokeVoidAsync("gestaoPiscinaCropper.descartar", CropCanvasId);
        cropModalVisible = false;
        erroFoto = null;
    }

    private async Task Close()
    {
        erroSenha = null;
        erroFoto = null;
        erroPerfil = null;
        erroEndereco = null;
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        erroEndereco = null;
        if (EnderecoObrigatorio && string.IsNullOrWhiteSpace(Usuario.Endereco))
        {
            erroEndereco = "Endereço é obrigatório para este perfil.";
            return;
        }

        await GeocodificarEnderecoAsync();

        if (ModoPerfil)
        {
            salvandoPerfil = true;
            erroPerfil = null;
            try
            {
                var atualizado = await ApiService.AtualizarMeuPerfilAsync(Usuario);
                if (atualizado != null)
                {
                    await OnPerfilSalvo.InvokeAsync(atualizado);
                }

                await Close();
            }
            catch (Exception ex)
            {
                erroPerfil = ex.Message;
            }
            finally
            {
                salvandoPerfil = false;
            }

            return;
        }

        if (Usuario.IDUsuario == 0 && Usuario.SenhaInicial.Length < 6)
        {
            erroSenha = "A senha deve ter no mínimo 6 caracteres.";
            return;
        }

        erroSenha = null;
        await OnSave.InvokeAsync(Usuario);
        await Close();
    }

    // Geocodifica o endereço no navegador e grava Latitude/Longitude no próprio Usuario
    // antes de salvar, pro mapa de Gestão de Rota não precisar geocodificar de novo. Nunca
    // lança — é um extra, não pode impedir o usuário de ser salvo.
    private async Task GeocodificarEnderecoAsync()
    {
        if (string.IsNullOrWhiteSpace(Usuario.Endereco))
        {
            return;
        }

        try
        {
            var apiKey = Configuration["GoogleMapsApiKey"];
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                return;
            }

            var resultado = await JSRuntime.InvokeAsync<GeoResultado?>("gestaoPiscinaMaps.geocode", apiKey, Usuario.Endereco);
            if (resultado != null)
            {
                Usuario.Latitude = resultado.Lat;
                Usuario.Longitude = resultado.Lng;
            }
        }
        catch
        {
        }
    }
}
