@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Shared
@implements IDisposable
@inject ApiService ApiService
@inject ClienteStateService StateService
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-50 flex sm:items-start justify-center z-50 sm:pt-8 @(IsVisible ? "" : "hidden")" @onclick="HandleBackdropClick">
    <div class="bg-slate-800 w-full h-full sm:h-auto sm:rounded-xl sm:max-w-6xl sm:mx-4 sm:max-h-[90vh] flex flex-col" @onclick:stopPropagation="true">
        <div class="flex items-center justify-between p-6 pb-4 shrink-0">
            <h4 class="text-lg font-semibold text-slate-100 flex items-center">
                <i class="fas fa-user-plus text-cyan-400 mr-2"></i>
                @(StateService.CurrentCliente.IDCliente > 0 ? "Editar Cliente" : "Cadastrar Novo Cliente")
            </h4>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200 text-xl">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="border-t border-slate-700"></div>

        <!-- Sistema de Abas - Implementação Direta (no celular, a navegação vira uma barra
             fixa no rodapé — ver "Abas no celular" logo antes dos botões) -->
        <div class="hidden sm:block px-6 shrink-0">
            <nav class="flex flex-wrap">
                @if (StateService.ActiveTab == "dados")
                {
                    <button @onclick="SetDadosTab" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 rounded-tl-lg">
                        <i class="fas fa-user mr-2"></i><span class="hidden md:inline">Dados</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetDadosTab" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent rounded-tl-lg">
                        <i class="fas fa-user mr-2"></i><span class="hidden md:inline">Dados</span>
                    </button>
                }
                
                @if (StateService.ActiveTab == "piscinas")
                {
                    <button @onclick="SetPiscinasTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-swimming-pool mr-2"></i><span class="hidden md:inline">Piscinas</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetPiscinasTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-swimming-pool mr-2"></i><span class="hidden md:inline">Piscinas</span>
                    </button>
                }

                @if (StateService.ActiveTab == "equipamentos")
                {
                    <button @onclick="SetEquipamentosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-robot mr-2"></i><span class="hidden md:inline">Equipamentos</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetEquipamentosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-robot mr-2"></i><span class="hidden md:inline">Equipamentos</span>
                    </button>
                }

                @if (StateService.ActiveTab == "produtos")
                {
                    <button @onclick="SetProdutosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 rounded-tr-lg disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-box mr-2"></i><span class="hidden md:inline">Produtos</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetProdutosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent rounded-tr-lg disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-box mr-2"></i><span class="hidden md:inline">Produtos</span>
                    </button>
                }
            </nav>
            <hr class="border-t-2 border-white mt-0" />
        </div>
        @if (!ClienteSalvo)
        {
            <p class="text-sm text-amber-400 px-6 py-2 shrink-0">
                <i class="fas fa-info-circle mr-1"></i>Salve os dados do cliente para habilitar piscinas, equipamentos e produtos.
            </p>
        }

        <EditForm Model="StateService.CurrentCliente" OnValidSubmit="@(async () => await HandleSaveCliente(StateService.CurrentCliente))" Context="clienteContext" class="flex flex-col flex-1 min-h-0">
            <DataAnnotationsValidator />

            <!-- Conteúdo das Abas: preenche toda a área entre o título/abas (tom claro) e a
                 barra de abas/botões no rodapé (que mantêm a cor de fundo do card) -->
            <div class="flex-1 overflow-y-auto bg-slate-900 px-6 py-6">
                @if (StateService.ActiveTab == "dados")
                {
                    <ClienteForm Cliente="StateService.CurrentCliente" Gestores="gestores" SelectedGestorId="selectedGestorId" OnGestorSelected="OnGestorSelected" OnNovoGestor="AbrirModalNovoGestor" />
                }
                else if (StateService.ActiveTab == "piscinas")
                {
                    <div class="space-y-6">
                        <div class="flex items-center justify-between mb-4">
                            <h5 class="text-lg font-semibold text-slate-200 flex items-center">
                                <i class="fas fa-swimming-pool text-cyan-400 mr-2"></i>Piscinas
                            </h5>
                            <button type="button" @onclick="ShowCreatePiscina" class="hidden sm:inline-block bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white text-sm transition-colors">
                                <i class="fas fa-plus mr-1"></i>Nova Piscina
                            </button>
                        </div>

                        @if (StateService.Piscinas != null && StateService.Piscinas.Any())
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                @foreach (var piscina in StateService.Piscinas)
                                {
                                    <div class="bg-slate-800 rounded-xl p-4 space-y-3">
                                        <div class="flex justify-between items-start">
                                            <div class="flex-1">
                                                <h4 class="text-sm font-medium text-slate-100">@NomeTipoPiscina(piscina.Tipo)</h4>
                                                <span class="text-sm text-slate-400">Volume: @piscina.VolumeM3 m³</span>
                                            </div>
                                            <div class="flex space-x-3 ml-4">
                                                <button type="button" @onclick="() => ShowEditPiscina(piscina)" class="text-cyan-400 hover:text-cyan-300 p-2 rounded transition-colors" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" @onclick="() => DeletePiscina(piscina)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Excluir">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(piscina.Localizacao))
                                        {
                                            <div class="text-sm text-slate-400">
                                                <i class="fas fa-map-marker-alt text-slate-500 mr-2"></i>@piscina.Localizacao
                                            </div>
                                        }
                                        @if (DescricaoRecorrenciaPiscina(piscina) is { } descricaoRecorrencia)
                                        {
                                            <div class="text-xs text-slate-500 border-t border-slate-700 pt-2 mt-2">
                                                <i class="fas fa-redo mr-2"></i>@descricaoRecorrencia
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-slate-400">
                                <i class="fas fa-swimming-pool text-4xl mb-4"></i>
                                <p class="text-lg">Nenhuma piscina cadastrada</p>
                                <p class="text-sm mt-2">Clique em "Nova Piscina" para adicionar</p>
                            </div>
                        }
                    </div>
                }
                else if (StateService.ActiveTab == "equipamentos")
                {
                    <div class="space-y-6">
                        <div class="flex items-center justify-between mb-4">
                            <h5 class="text-lg font-semibold text-slate-200 flex items-center">
                                <i class="fas fa-robot text-cyan-400 mr-2"></i>Equipamentos
                            </h5>
                            <button type="button" @onclick="ShowCreateEquipamento" class="hidden sm:inline-block bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white text-sm transition-colors">
                                <i class="fas fa-plus mr-1"></i>Novo Equipamento
                            </button>
                        </div>

                        @if (StateService.Equipamentos != null && StateService.Equipamentos.Any())
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                @foreach (var equipamento in StateService.Equipamentos)
                                {
                                    <div class="bg-slate-800 rounded-xl p-4 space-y-3">
                                        <div class="flex justify-between items-start">
                                            <div class="flex-1">
                                                <h4 class="text-sm font-medium text-slate-100">@equipamento.Descricao</h4>
                                                <span class="text-sm text-slate-400">Série: @equipamento.NumeroSerie</span>
                                            </div>
                                            <div class="flex space-x-3 ml-4">
                                                <button type="button" @onclick="() => ShowEditEquipamento(equipamento)" class="text-cyan-400 hover:text-cyan-300 p-2 rounded transition-colors" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" @onclick="() => DeleteEquipamento(equipamento)" class="text-red-400 hover:text-red-300 p-2 rounded transition-colors" title="Excluir">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>

                                        @if (equipamento.UltimaCalibragem.HasValue)
                                        {
                                            <div class="text-sm text-slate-400">
                                                <i class="fas fa-calendar-alt text-slate-500 mr-2"></i>
                                                Última Calibragem: @equipamento.UltimaCalibragem.Value.ToShortDateString()
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-slate-400">
                                <i class="fas fa-robot text-4xl mb-4"></i>
                                <p class="text-lg">Nenhum equipamento cadastrado</p>
                                <p class="text-sm mt-2">Clique em "Novo Equipamento" para adicionar</p>
                            </div>
                        }
                    </div>
                }
                else if (StateService.ActiveTab == "produtos")
                {
                    <div class="space-y-6">
                        <div class="flex items-center justify-between mb-4">
                            <h5 class="text-lg font-semibold text-slate-200 flex items-center">
                                <i class="fas fa-box text-cyan-400 mr-2"></i>Estoque
                            </h5>
                            <button type="button" @onclick="() => AbrirNovaMovimentacao(null)" class="hidden sm:inline-block bg-cyan-600 hover:bg-cyan-500 px-3 py-2 rounded-lg text-white text-sm transition-colors">
                                <i class="fas fa-plus mr-1"></i>Nova Movimentação
                            </button>
                        </div>

                        @if (StateService.Estoques != null && StateService.Estoques.Any())
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                @foreach (var item in StateService.Estoques)
                                {
                                    <div class="bg-slate-800 rounded-xl p-4 space-y-3">
                                        <div class="flex justify-between items-start">
                                            <div class="flex-1">
                                                <h4 class="text-sm font-medium text-slate-100">@item.Produto?.Nome</h4>
                                                <span class="text-sm text-slate-400">Saldo: @item.QuantidadeAtual.ToString("0.##") @item.Produto?.Unidade</span>
                                                @if (item.QuantidadeMinima.HasValue)
                                                {
                                                    <div class="text-xs @(EstoqueBaixo(item) ? "text-red-400" : "text-slate-500")">
                                                        Mínimo: @item.QuantidadeMinima.Value.ToString("0.##")
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex space-x-2 ml-2">
                                                <button type="button" @onclick="() => AbrirNovaMovimentacao(item.IDProduto)" class="text-cyan-400 hover:text-cyan-300 p-1" title="Nova Movimentação">
                                                    <i class="fas fa-exchange-alt"></i>
                                                </button>
                                                <button type="button" @onclick="() => AbrirHistoricoEstoque(item)" class="text-blue-400 hover:text-blue-300 p-1" title="Histórico">
                                                    <i class="fas fa-history"></i>
                                                </button>
                                                <button type="button" @onclick="() => AbrirLimiteEstoque(item)" class="text-amber-400 hover:text-amber-300 p-1" title="Quantidade Mínima">
                                                    <i class="fas fa-sliders-h"></i>
                                                </button>
                                                <button type="button" @onclick="() => DeleteEstoque(item)" class="text-red-400 hover:text-red-300 p-1" title="Remover">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-slate-400">
                                <i class="fas fa-box text-4xl mb-4"></i>
                                <p class="text-lg">Nenhum produto no estoque</p>
                                <p class="text-sm mt-2">Clique em "Nova Movimentação" e registre uma Entrada para começar</p>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (BotaoAdicionarAtivo() != null)
            {
                <!-- Botão único de adicionar no celular: substitui os botões "Nova Piscina" /
                     "Novo Equipamento" / "Nova Movimentação" de cada aba. Flutua por cima do
                     conteúdo (fixed, não ocupa espaço no layout), ancorado no canto inferior
                     direito, logo acima da barra de abas. -->
                <button type="button" @onclick="AdicionarItemDaAbaAtiva" class="sm:hidden fixed bottom-[136px] right-4 z-10 w-11 h-11 flex items-center justify-center rounded-full bg-cyan-600 hover:bg-cyan-500 text-white shadow-lg transition-colors" title="@BotaoAdicionarAtivo()">
                    <i class="fas fa-plus"></i>
                </button>
            }

            <!-- Abas no celular: barra fixa no rodapé, acima dos botões, com cada aba
                 ocupando a mesma fração da largura da tela -->
            <nav class="sm:hidden grid grid-cols-4 border-t border-slate-700 shrink-0">
                <button type="button" @onclick="SetDadosTab" class="flex flex-col items-center justify-center gap-1 py-2 text-xs font-medium transition-colors @(StateService.ActiveTab == "dados" ? "text-cyan-400" : "text-slate-400 hover:text-slate-200")">
                    <i class="fas fa-user text-lg"></i>
                    <span>Dados</span>
                </button>
                <button type="button" @onclick="SetPiscinasTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex flex-col items-center justify-center gap-1 py-2 text-xs font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed @(StateService.ActiveTab == "piscinas" ? "text-cyan-400" : "text-slate-400 hover:text-slate-200")">
                    <i class="fas fa-swimming-pool text-lg"></i>
                    <span>Piscinas</span>
                </button>
                <button type="button" @onclick="SetEquipamentosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex flex-col items-center justify-center gap-1 py-2 text-xs font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed @(StateService.ActiveTab == "equipamentos" ? "text-cyan-400" : "text-slate-400 hover:text-slate-200")">
                    <i class="fas fa-robot text-lg"></i>
                    <span>Equipam.</span>
                </button>
                <button type="button" @onclick="SetProdutosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex flex-col items-center justify-center gap-1 py-2 text-xs font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed @(StateService.ActiveTab == "produtos" ? "text-cyan-400" : "text-slate-400 hover:text-slate-200")">
                    <i class="fas fa-box text-lg"></i>
                    <span>Produtos</span>
                </button>
            </nav>

            <div class="flex flex-nowrap items-center gap-1.5 sm:gap-3 px-3 sm:px-6 py-3 sm:py-4 border-t border-slate-700 shrink-0">
                <button type="submit" class="flex-1 min-w-0 whitespace-nowrap overflow-hidden bg-cyan-600 hover:bg-cyan-500 px-2 sm:px-4 py-2 sm:py-3 rounded-lg text-white transition-colors">
                    <i class="fas fa-save mr-1 sm:mr-2"></i>@(StateService.CurrentCliente.IDCliente > 0 ? "Atualizar" : "Salvar")
                </button>
                <button type="button" @onclick="ClearForm" class="flex-1 min-w-0 whitespace-nowrap overflow-hidden bg-slate-600 hover:bg-slate-500 px-2 sm:px-4 py-2 sm:py-3 rounded-lg text-white transition-colors">
                    <i class="fas fa-eraser mr-1 sm:mr-2"></i>Limpar
                </button>
                @if (ClienteSalvo)
                {
                    <button type="button" @onclick="Close" class="flex-1 min-w-0 whitespace-nowrap overflow-hidden bg-gray-600 hover:bg-gray-500 px-2 sm:px-4 py-2 sm:py-3 rounded-lg text-white transition-colors">
                        <i class="fas fa-check mr-1 sm:mr-2"></i>Concluir
                    </button>
                }
            </div>
        </EditForm>
    </div>
</div>

<PiscinaModal @bind-IsVisible="piscinaModalVisible"
              Piscina="StateService.CurrentPiscina"
              ClienteId="StateService.CurrentCliente.IDCliente"
              OnSave="HandleSavePiscina" />

<EquipamentoModal @bind-IsVisible="equipamentoModalVisible"
                  Equipamento="StateService.CurrentEquipamento"
                  ClienteId="StateService.CurrentCliente.IDCliente"
                  OnSave="HandleSaveEquipamento" />

<EstoqueMovimentacaoModal @bind-IsVisible="movimentacaoModalVisible"
                          ClienteId="StateService.CurrentCliente.IDCliente"
                          Produtos="StateService.Produtos"
                          EstoqueDoCliente="StateService.Estoques"
                          ProdutoIdFixo="produtoIdFixoParaMovimentacao"
                          OnSave="RegistrarMovimentacaoEstoque" />

<EstoqueLimiteModal @bind-IsVisible="limiteModalVisible"
                     Estoque="estoqueParaLimite"
                     OnSave="SalvarLimiteEstoque" />

<EstoqueHistoricoModal @bind-IsVisible="historicoModalVisible"
                        ClienteId="StateService.CurrentCliente.IDCliente"
                        Produto="produtoParaHistorico"
                        OnChanged="LoadRelatedData" />

<ConfirmDialog @bind-IsVisible="showConfirmDialog"
               Title="Confirmar Exclusão"
               Message="Tem certeza que deseja excluir este item?"
               ConfirmText="Excluir"
               OnConfirm="ConfirmDeleteAsync" />

<GestorModal @bind-IsVisible="gestorModalVisible"
             Gestor="novoGestor"
             OnSave="SalvarNovoGestor" />

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [CascadingParameter] public MainLayout? MainLayout { get; set; }

    private bool isLoading = false;
    private bool showConfirmDialog = false;
    private bool piscinaModalVisible = false;
    private bool equipamentoModalVisible = false;
    private bool movimentacaoModalVisible = false;
    private int? produtoIdFixoParaMovimentacao;
    private bool limiteModalVisible = false;
    private EstoqueCliente estoqueParaLimite = new EstoqueCliente();
    private bool historicoModalVisible = false;
    private Produto? produtoParaHistorico;
    private object? itemToDelete = null;
    private bool ClienteSalvo => StateService.CurrentCliente.IDCliente > 0;
    private List<Gestor>? gestores;
    private int selectedGestorId;
    private int gestorVinculadoOriginalId;
    private bool gestorModalVisible = false;
    private Gestor novoGestor = new Gestor();
    private bool wasVisible = false;

    protected override Task OnInitializedAsync()
    {
        StateService.StateChanged += StateHasChanged;
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !wasVisible)
        {
            await LoadGestores();
        }
        wasVisible = IsVisible;
    }

    private async Task LoadGestores()
    {
        try
        {
            gestores = await ApiService.GetGestoresAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar gestores: {ex.Message}");
            gestores = new List<Gestor>();
        }

        var gestorVinculado = gestores.FirstOrDefault(g => g.GestorClientes.Any(gc => gc.IDCliente == StateService.CurrentCliente.IDCliente));
        selectedGestorId = gestorVinculado?.IDGestor ?? 0;
        gestorVinculadoOriginalId = selectedGestorId;
    }

    private void OnGestorSelected(int gestorId)
    {
        selectedGestorId = gestorId;
    }

    private void AbrirModalNovoGestor()
    {
        novoGestor = new Gestor { Nome = "Novo" };
        gestorModalVisible = true;
    }

    private async Task SalvarNovoGestor(Gestor gestor)
    {
        try
        {
            var criado = await ApiService.CreateGestorAsync(gestor);
            await LoadGestores();
            selectedGestorId = criado.IDGestor;
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao criar gestor: {ex.Message}", "error");
        }
    }

    private async Task ReconcileGestorAsync(int clienteId)
    {
        if (selectedGestorId == gestorVinculadoOriginalId)
        {
            return;
        }

        try
        {
            if (gestorVinculadoOriginalId > 0)
            {
                await ApiService.DesvincularGestorClienteAsync(gestorVinculadoOriginalId, clienteId);
            }

            if (selectedGestorId > 0)
            {
                await ApiService.VincularGestorClienteAsync(selectedGestorId, clienteId);
            }

            gestorVinculadoOriginalId = selectedGestorId;
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao vincular gestor: {ex.Message}", "error");
        }
    }

    public void Dispose()
    {
        StateService.StateChanged -= StateHasChanged;
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        // Se o cliente já foi salvo (tem ID real), não há nada para "descartar" - só
        // atualizar a lista com o que já está persistido. Caso contrário, é um cadastro
        // abandonado antes do primeiro salvamento, então só limpa o estado.
        if (ClienteSalvo)
        {
            await OnSave.InvokeAsync();
        }
        else
        {
            await OnClose.InvokeAsync();
        }
    }

