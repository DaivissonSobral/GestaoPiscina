@using GestaoPiscina.Client.Services
@using GestaoPiscina.Client.Models
@using GestaoPiscina.Client.Models.DTOs
@using GestaoPiscina.Client.Shared
@implements IDisposable
@inject ApiService ApiService
@inject ClienteStateService StateService
@inject IJSRuntime JSRuntime

<div class="fixed inset-0 bg-black bg-opacity-50 flex items-start justify-center z-50 pt-8 @(IsVisible ? "" : "hidden")" @onclick="HandleBackdropClick">
    <div class="bg-slate-800 rounded-xl p-6 w-full max-w-6xl mx-4 max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">
        <div class="flex items-center justify-between mb-6">
            <h4 class="text-lg font-semibold text-slate-100 flex items-center">
                <i class="fas fa-user-plus text-cyan-400 mr-2"></i>
                @(StateService.CurrentCliente.IDCliente > 0 ? "Editar Cliente" : "Cadastrar Novo Cliente")
            </h4>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200 text-xl">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Sistema de Abas - Implementação Direta -->
        <div>
            <nav class="flex flex-wrap">
                @if (StateService.ActiveTab == "dados")
                {
                    <button @onclick="SetDadosTab" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 rounded-tl-lg">
                        <i class="fas fa-user mr-2"></i><span class="hidden md:inline">Dados</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetDadosTab" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent rounded-tl-lg">
                        <i class="fas fa-user mr-2"></i><span class="hidden md:inline">Dados</span>
                    </button>
                }
                
                @if (StateService.ActiveTab == "piscinas")
                {
                    <button @onclick="SetPiscinasTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-swimming-pool mr-2"></i><span class="hidden md:inline">Piscinas</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetPiscinasTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-swimming-pool mr-2"></i><span class="hidden md:inline">Piscinas</span>
                    </button>
                }

                @if (StateService.ActiveTab == "equipamentos")
                {
                    <button @onclick="SetEquipamentosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-robot mr-2"></i><span class="hidden md:inline">Equipamentos</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetEquipamentosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-robot mr-2"></i><span class="hidden md:inline">Equipamentos</span>
                    </button>
                }

                @if (StateService.ActiveTab == "produtos")
                {
                    <button @onclick="SetProdutosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-600 text-white shadow border-b-2 border-cyan-600 rounded-tr-lg disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-box mr-2"></i><span class="hidden md:inline">Produtos</span>
                    </button>
                }
                else
                {
                    <button @onclick="SetProdutosTab" disabled="@(!ClienteSalvo)" title="@(ClienteSalvo ? "" : "Salve os dados do cliente primeiro")" class="flex items-center px-4 py-2 font-medium text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-slate-700 text-slate-300 hover:bg-slate-600 border-b-2 border-transparent rounded-tr-lg disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fas fa-box mr-2"></i><span class="hidden md:inline">Produtos</span>
                    </button>
                }
            </nav>
            <hr class="border-t-2 border-white mt-0" />
            @if (!ClienteSalvo)
            {
                <p class="text-sm text-amber-400 mt-2">
                    <i class="fas fa-info-circle mr-1"></i>Salve os dados do cliente para habilitar piscinas, equipamentos e produtos.
                </p>
            }
        </div>

        <EditForm Model="StateService.CurrentCliente" OnValidSubmit="@(async () => await HandleSaveCliente(StateService.CurrentCliente))" Context="clienteContext">
            <DataAnnotationsValidator />

            <!-- Conteúdo das Abas -->
            <div class="bg-slate-900 rounded-lg rounded-tl-none shadow p-6">
                @if (StateService.ActiveTab == "dados")
                {
                    <ClienteForm Cliente="StateService.CurrentCliente" />
                }
                else if (StateService.ActiveTab == "piscinas")
                {
                    <PiscinaForm
                        ClienteId="StateService.CurrentCliente.IDCliente"
                        Piscinas="StateService.Piscinas"
                        Piscina="StateService.CurrentPiscina"
                        ShowForm="StateService.ShowPiscinaForm"
                        OnCreate="ShowCreatePiscina"
                        OnClose="ClosePiscinaForm"
                        OnSave="HandleSavePiscina"
                        OnEdit="ShowEditPiscina"
                        OnDelete="DeletePiscina" />
                }
                else if (StateService.ActiveTab == "equipamentos")
                {
                    <EquipamentoForm
                        ClienteId="StateService.CurrentCliente.IDCliente"
                        Equipamentos="StateService.Equipamentos"
                        Equipamento="StateService.CurrentEquipamento"
                        ShowForm="StateService.ShowEquipamentoForm"
                        OnCreate="ShowCreateEquipamento"
                        OnClose="CloseEquipamentoForm"
                        OnSave="HandleSaveEquipamento"
                        OnEdit="ShowEditEquipamento"
                        OnDelete="DeleteEquipamento" />
                }
                else if (StateService.ActiveTab == "produtos")
                {
                    <EstoqueForm
                        ClienteId="StateService.CurrentCliente.IDCliente"
                        Estoques="StateService.Estoques"
                        Produtos="StateService.Produtos"
                        Estoque="StateService.CurrentEstoque"
                        SelectedProdutoId="StateService.SelectedProdutoId"
                        ShowForm="StateService.ShowEstoqueForm"
                        OnCreate="ShowCreateEstoque"
                        OnClose="CloseEstoqueForm"
                        OnSave="HandleSaveEstoque"
                        OnEdit="ShowEditEstoque"
                        OnDelete="DeleteEstoque"
                        OnProdutoSelected="OnProdutoSelected" />
                }
            </div>
            
            <div class="flex space-x-3 mt-8">
                <button type="submit" class="bg-cyan-600 hover:bg-cyan-500 px-6 py-3 rounded-lg text-white transition-colors">
                    <i class="fas fa-save mr-2"></i>@(StateService.CurrentCliente.IDCliente > 0 ? "Atualizar" : "Salvar") 
                </button>
                <button type="button" @onclick="ClearForm" class="bg-slate-600 hover:bg-slate-500 px-6 py-3 rounded-lg text-white transition-colors">
                    <i class="fas fa-eraser mr-2"></i>Limpar
                </button>
                @if (ClienteSalvo)
                {
                    <button type="button" @onclick="Close" class="bg-gray-600 hover:bg-gray-500 px-6 py-3 rounded-lg text-white transition-colors">
                        <i class="fas fa-check mr-2"></i>Concluir
                    </button>
                }
            </div>
        </EditForm>
    </div>
</div>

<ConfirmDialog @bind-IsVisible="showConfirmDialog"
               Title="Confirmar Exclusão"
               Message="Tem certeza que deseja excluir este item?"
               ConfirmText="Excluir"
               OnConfirm="ConfirmDeleteAsync" />

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [CascadingParameter] public MainLayout? MainLayout { get; set; }

    private bool isLoading = false;
    private bool showConfirmDialog = false;
    private object? itemToDelete = null;
    private bool ClienteSalvo => StateService.CurrentCliente.IDCliente > 0;

    protected override Task OnInitializedAsync()
    {
        StateService.StateChanged += StateHasChanged;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        StateService.StateChanged -= StateHasChanged;
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);

        // Se o cliente já foi salvo (tem ID real), não há nada para "descartar" - só
        // atualizar a lista com o que já está persistido. Caso contrário, é um cadastro
        // abandonado antes do primeiro salvamento, então só limpa o estado.
        if (ClienteSalvo)
        {
            await OnSave.InvokeAsync();
        }
        else
        {
            await OnClose.InvokeAsync();
        }
    }

    private void HandleBackdropClick()
    {
        _ = Close();
    }

    private void ClearForm()
    {
        StateService.ClearState();
    }

    // Métodos específicos para controle das abas
    private Task SetDadosTab()
    {
        return OnTabChanged("dados");
    }

    private Task SetPiscinasTab()
    {
        return OnTabChanged("piscinas");
    }

    private Task SetEquipamentosTab()
    {
        return OnTabChanged("equipamentos");
    }

    private Task SetProdutosTab()
    {
        return OnTabChanged("produtos");
    }

    // Métodos de controle das abas
    private async Task OnTabChanged(string tab)
    {
        StateService.ActiveTab = tab;
        
        if (tab == "piscinas" && StateService.CurrentCliente.IDCliente > 0)
        {
            await LoadRelatedData();
        }
        else if (tab == "equipamentos" && StateService.CurrentCliente.IDCliente > 0 && (StateService.Equipamentos == null || !StateService.Equipamentos.Any()))
        {
            await LoadRelatedData();
        }
        else if (tab == "produtos")
        {
            if (StateService.Produtos == null || !StateService.Produtos.Any())
            {
                await LoadProdutos();
            }
            
            if (StateService.CurrentCliente.IDCliente > 0 && (StateService.Estoques == null || !StateService.Estoques.Any()))
            {
                await LoadRelatedData();
            }
        }
        
        StateHasChanged();
    }

    private async Task LoadRelatedData()
    {
        if (StateService.CurrentCliente.IDCliente > 0)
        {
            try
            {
                var piscinasTask = ApiService.GetPiscinasByClienteAsync(StateService.CurrentCliente.IDCliente);
                var equipamentosTask = ApiService.GetEquipamentosByClienteAsync(StateService.CurrentCliente.IDCliente);
                var estoquesTask = ApiService.GetEstoqueByClienteAsync(StateService.CurrentCliente.IDCliente);

                await Task.WhenAll(piscinasTask, equipamentosTask, estoquesTask);

                StateService.Piscinas = await piscinasTask;
                StateService.Equipamentos = await equipamentosTask;
                StateService.Estoques = await estoquesTask;
                
                StateService.NotifyStateChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao carregar dados relacionados: {ex.Message}");
                StateService.Piscinas = new List<Piscina>();
                StateService.Equipamentos = new List<Equipamento>();
                StateService.Estoques = new List<EstoqueCliente>();
            }
        }
    }

    private async Task LoadProdutos()
    {
        try
        {
            StateService.Produtos = await ApiService.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar produtos: {ex.Message}");
            StateService.Produtos = new List<Produto>();
        }
    }

    // Métodos para Piscinas
    private void ShowCreatePiscina()
    {
        StateService.CurrentPiscina = new Piscina { IDCliente = StateService.CurrentCliente.IDCliente, IDPiscina = 0 };
        StateService.ShowPiscinaForm = true;
    }

    private void ShowEditPiscina(Piscina piscina)
    {
        StateService.CurrentPiscina = new Piscina
        {
            IDPiscina = piscina.IDPiscina,
            IDCliente = piscina.IDCliente,
            Tipo = piscina.Tipo,
            VolumeLitros = piscina.VolumeLitros,
            Localizacao = piscina.Localizacao,
            Coberta = piscina.Coberta,
            Aquecida = piscina.Aquecida
        };
        StateService.ShowPiscinaForm = true;
    }

    private void ClosePiscinaForm()
    {
        StateService.ShowPiscinaForm = false;
        StateService.CurrentPiscina = new Piscina();
    }

    private async Task HandleSavePiscina()
    {
        isLoading = true;
        try
        {
            StateService.CurrentPiscina.IDCliente = StateService.CurrentCliente.IDCliente;

            if (string.IsNullOrWhiteSpace(StateService.CurrentPiscina.Tipo))
            {
                ShowToast("Erro", "Tipo de piscina é obrigatório", "error");
                return;
            }

            if (StateService.CurrentPiscina.VolumeLitros <= 0)
            {
                ShowToast("Erro", "Volume deve ser maior que zero", "error");
                return;
            }

            if (StateService.CurrentPiscina.IDPiscina > 0)
            {
                await ApiService.UpdatePiscinaAsync(StateService.CurrentPiscina);
                ShowToast("Sucesso", "Piscina atualizada com sucesso!", "success");
            }
            else
            {
                await ApiService.CreatePiscinaAsync(StateService.CurrentPiscina);
                ShowToast("Sucesso", "Piscina criada com sucesso!", "success");
            }

            await LoadRelatedData();
            ClosePiscinaForm();
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao salvar piscina: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void DeletePiscina(Piscina piscina)
    {
        itemToDelete = piscina;
        showConfirmDialog = true;
    }

    // Métodos para Equipamentos
    private void ShowCreateEquipamento()
    {
        StateService.CurrentEquipamento = new Equipamento { IDCliente = StateService.CurrentCliente.IDCliente };
        StateService.ShowEquipamentoForm = true;
    }

    private void ShowEditEquipamento(Equipamento equipamento)
    {
        StateService.CurrentEquipamento = new Equipamento
        {
            IDEquipamento = equipamento.IDEquipamento,
            IDCliente = equipamento.IDCliente,
            Descricao = equipamento.Descricao,
            NumeroSerie = equipamento.NumeroSerie,
            UltimaCalibragem = equipamento.UltimaCalibragem,
            Observacao = equipamento.Observacao
        };
        StateService.ShowEquipamentoForm = true;
    }

    private void CloseEquipamentoForm()
    {
        StateService.ShowEquipamentoForm = false;
        StateService.CurrentEquipamento = new Equipamento();
    }

    private async Task HandleSaveEquipamento()
    {
        isLoading = true;
        try
        {
            StateService.CurrentEquipamento.IDCliente = StateService.CurrentCliente.IDCliente;

            if (StateService.CurrentEquipamento.IDEquipamento > 0)
            {
                await ApiService.UpdateEquipamentoAsync(StateService.CurrentEquipamento);
                ShowToast("Sucesso", "Equipamento atualizado com sucesso!", "success");
            }
            else
            {
                await ApiService.CreateEquipamentoAsync(StateService.CurrentEquipamento);
                ShowToast("Sucesso", "Equipamento criado com sucesso!", "success");
            }

            await LoadRelatedData();
            CloseEquipamentoForm();
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao salvar equipamento: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void DeleteEquipamento(Equipamento equipamento)
    {
        itemToDelete = equipamento;
        showConfirmDialog = true;
    }

    // Métodos para Estoque
    private void ShowCreateEstoque()
    {
        StateService.CurrentEstoque = new EstoqueCliente 
        { 
            IDCliente = StateService.CurrentCliente.IDCliente,
            Produto = new Produto(),
            QuantidadeAtual = 0,
            QuantidadeMinima = null
        };
        StateService.SelectedProdutoId = 0;
        StateService.ShowEstoqueForm = true;
    }

    private void ShowEditEstoque(EstoqueCliente estoque)
    {
        StateService.CurrentEstoque = new EstoqueCliente
        {
            IDEstoque = estoque.IDEstoque,
            IDCliente = estoque.IDCliente,
            IDProduto = estoque.IDProduto,
            QuantidadeAtual = estoque.QuantidadeAtual,
            QuantidadeMinima = estoque.QuantidadeMinima,
            Produto = new Produto
            {
                IDProduto = estoque.Produto.IDProduto,
                Nome = estoque.Produto.Nome,
                Concentracao = estoque.Produto.Concentracao,
                Unidade = estoque.Produto.Unidade
            }
        };
        StateService.SelectedProdutoId = estoque.IDProduto;
        StateService.ShowEstoqueForm = true;
    }

    private void CloseEstoqueForm()
    {
        StateService.ShowEstoqueForm = false;
        StateService.CurrentEstoque = new EstoqueCliente();
        StateService.SelectedProdutoId = 0;
    }

    private async Task HandleSaveEstoque()
    {
        isLoading = true;
        try
        {
            StateService.CurrentEstoque.IDCliente = StateService.CurrentCliente.IDCliente;

            if (StateService.SelectedProdutoId <= 0)
            {
                ShowToast("Erro", "Selecione um produto", "error");
                return;
            }

            if (StateService.CurrentEstoque.QuantidadeAtual < 0)
            {
                ShowToast("Erro", "Quantidade atual deve ser maior ou igual a zero", "error");
                return;
            }

            var produtoSelecionado = StateService.Produtos?.FirstOrDefault(p => p.IDProduto == StateService.SelectedProdutoId);
            if (produtoSelecionado == null)
            {
                ShowToast("Erro", "Produto selecionado não encontrado", "error");
                return;
            }

            StateService.CurrentEstoque.IDProduto = produtoSelecionado.IDProduto;

            if (StateService.CurrentEstoque.IDEstoque > 0)
            {
                await ApiService.UpdateEstoqueAsync(StateService.CurrentEstoque);
                ShowToast("Sucesso", "Item do estoque atualizado com sucesso!", "success");
            }
            else
            {
                await ApiService.CreateEstoqueAsync(StateService.CurrentEstoque);
                ShowToast("Sucesso", "Item do estoque criado com sucesso!", "success");
            }

            await LoadRelatedData();
            CloseEstoqueForm();
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao salvar item do estoque: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void DeleteEstoque(EstoqueCliente estoque)
    {
        itemToDelete = estoque;
        showConfirmDialog = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (itemToDelete == null)
        {
            return;
        }

        isLoading = true;
        try
        {
            switch (itemToDelete)
            {
                case Piscina piscina:
                    await ApiService.DeletePiscinaAsync(piscina.IDPiscina);
                    await LoadRelatedData();
                    ShowToast("Sucesso", "Piscina excluída com sucesso!", "success");
                    break;
                case Equipamento equipamento:
                    await ApiService.DeleteEquipamentoAsync(equipamento.IDEquipamento);
                    await LoadRelatedData();
                    ShowToast("Sucesso", "Equipamento excluído com sucesso!", "success");
                    break;
                case EstoqueCliente estoque:
                    await ApiService.DeleteEstoqueAsync(estoque.IDEstoque);
                    await LoadRelatedData();
                    ShowToast("Sucesso", "Item do estoque excluído com sucesso!", "success");
                    break;
            }
        }
        catch (Exception ex)
        {
            ShowToast("Erro", $"Erro ao excluir item: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            itemToDelete = null;
        }
    }

    // Métodos gerais
    private async Task HandleSaveCliente(Cliente cliente)
    {
        isLoading = true;
        try
        {
            if (cliente.IDCliente > 0)
            {
                await ApiService.UpdateClienteAsync(cliente);
                ShowToast("Sucesso", "Cliente atualizado com sucesso!", "success");
            }
            else
            {
                var novoCliente = await ApiService.CreateClienteAsync(cliente);
                StateService.CurrentCliente.IDCliente = novoCliente.IDCliente;
                ShowToast("Sucesso", "Cliente criado com sucesso!", "success");
                
                await LoadRelatedData();
                return;
            }
            await OnSave.InvokeAsync();
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Já existe um cliente com este nome"))
            {
                ShowToast("Atenção", ex.Message, "warning");
            }
            else
            {
                ShowToast("Erro", $"Ocorreu um erro ao salvar o cliente. Por favor, tente novamente ou contate o suporte. Detalhes: {ex.Message}", "error");
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnProdutoSelected(int produtoId)
    {
        StateService.SelectedProdutoId = produtoId;
        var produtoSelecionado = produtoId > 0 ? StateService.Produtos?.FirstOrDefault(p => p.IDProduto == produtoId) : null;

        if (produtoSelecionado != null)
        {
            StateService.CurrentEstoque.Produto = new Produto
            {
                IDProduto = produtoSelecionado.IDProduto,
                Nome = produtoSelecionado.Nome,
                Concentracao = produtoSelecionado.Concentracao,
                Unidade = produtoSelecionado.Unidade
            };
            StateService.CurrentEstoque.IDProduto = produtoSelecionado.IDProduto;
        }
        else
        {
            StateService.CurrentEstoque.Produto = new Produto();
            StateService.CurrentEstoque.IDProduto = 0;
        }

        StateService.NotifyStateChanged();
    }

    private void ShowToast(string title, string message, string type)
    {
        if (MainLayout != null)
        {
            MainLayout.ShowToast(title, message, type);
        }
    }
} 