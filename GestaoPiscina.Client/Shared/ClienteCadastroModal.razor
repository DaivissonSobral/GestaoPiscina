    private string? DescricaoRecorrenciaPiscina(Piscina piscina)
    {
        if (piscina.RecorrenciaFrequencia == "Nenhuma")
        {
            return null;
        }

        var intervalo = piscina.RecorrenciaIntervalo;
        string baseTexto;

        switch (piscina.RecorrenciaFrequencia)
        {
            case "Diaria":
                baseTexto = intervalo <= 1 ? "Repete diariamente" : $"Repete a cada {intervalo} dias";
                break;
            case "Semanal":
                var dias = string.IsNullOrWhiteSpace(piscina.RecorrenciaDiasSemana) ? "" : $" às {piscina.RecorrenciaDiasSemana.Replace(",", ", ")}";
                baseTexto = (intervalo <= 1 ? "Repete semanalmente" : $"Repete a cada {intervalo} semanas") + dias;
                break;
            case "Mensal":
                var dia = piscina.RecorrenciaDataInicio?.Day;
                var noDia = dia.HasValue ? $" no dia {dia}" : "";
                baseTexto = (intervalo <= 1 ? "Repete mensalmente" : $"Repete a cada {intervalo} meses") + noDia;
                break;
            default:
                return null;
        }

        var termino = piscina.RecorrenciaTermino switch
        {
            "Data" when piscina.RecorrenciaDataFim.HasValue => $", até {piscina.RecorrenciaDataFim.Value:dd/MM/yyyy}",
            "Ocorrencias" when piscina.RecorrenciaOcorrencias.HasValue => $", por {piscina.RecorrenciaOcorrencias} vez(es)",
            _ => ""
        };

        return baseTexto + termino;
    }

