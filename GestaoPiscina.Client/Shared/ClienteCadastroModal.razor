    // Geocodifica o endereço no navegador (Google) e grava Latitude/Longitude no próprio
    // objeto antes de salvar, pro mapa de Gestão de Rota não precisar geocodificar de novo
    // a cada abertura. Nunca lança — é um extra, não pode impedir o cliente de ser salvo.
    private async Task GeocodificarEnderecoAsync(Cliente cliente)
    {
        if (string.IsNullOrWhiteSpace(cliente.Endereco))
        {
            return;
        }

        try
        {
            var apiKey = Configuration["GoogleMapsApiKey"];
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                return;
            }

            var resultado = await JSRuntime.InvokeAsync<GeoResultado?>("gestaoPiscinaMaps.geocode", apiKey, cliente.Endereco);
            if (resultado != null)
            {
                cliente.Latitude = resultado.Lat;
                cliente.Longitude = resultado.Lng;
            }
        }
        catch
        {
        }
    }
