@using GestaoPiscina.Client.Models

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-50 flex items-center justify-center z-50 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 rounded-xl p-6 w-full max-w-md mx-4">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-slate-100">
                @(Item.IDChecklistItem > 0 ? "Editar Item de Checklist" : "Novo Item de Checklist")
            </h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <EditForm Model="Item" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Texto *</label>
                    <InputTextArea @bind-Value="Item.Texto" rows="3" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Ex: Realizamos a limpeza do cesto pré-filtro." />
                    <ValidationMessage For="@(() => Item.Texto)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Ordem de exibição</label>
                    <InputNumber @bind-Value="Item.Ordem" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" />
                </div>

                <div class="flex items-center gap-2">
                    <InputCheckbox @bind-Value="Item.Ativo" id="checklist-item-ativo" />
                    <label for="checklist-item-ativo" class="text-sm text-slate-300">Ativo</label>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Obrigatório para os tipos de cliente</label>
                    <div class="flex flex-wrap gap-x-4 gap-y-2">
                        @foreach (var tipo in TiposCliente)
                        {
                            <label class="flex items-center gap-2 text-sm text-slate-300">
                                <input type="checkbox" checked="@Item.TiposClienteList.Contains(tipo)" @onchange="@(e => AlternarTipoCliente(tipo, e))" />
                                @tipo
                            </label>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Obrigatório para os tipos de piscina</label>
                    <div class="flex flex-wrap gap-x-4 gap-y-2">
                        @foreach (var (valor, rotulo) in TiposPiscina)
                        {
                            <label class="flex items-center gap-2 text-sm text-slate-300">
                                <input type="checkbox" checked="@Item.TiposPiscinaList.Contains(valor)" @onchange="@(e => AlternarTipoPiscina(valor, e))" />
                                @rotulo
                            </label>
                        }
                    </div>
                </div>

                <p class="text-xs text-slate-400">
                    <i class="fas fa-info-circle mr-1"></i>O item fica obrigatório numa OS quando o tipo do cliente OU o tipo da piscina daquela OS estiver marcado acima. Sem nenhuma marcação, o item nunca é exigido.
                </p>
            </div>

            <div class="flex space-x-3 mt-6">
                <button type="submit" class="flex-1 bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas fa-save mr-2"></i>Salvar
                </button>
                <button type="button" @onclick="Close" class="flex-1 bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded-lg text-white transition-colors">
                    Cancelar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public ChecklistItemDefinicao Item { get; set; } = new ChecklistItemDefinicao();
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<ChecklistItemDefinicao> OnSave { get; set; }

    private static readonly string[] TiposCliente = { "Uso Coletivo", "Residencial Privativa" };
    private static readonly (string Valor, string Rotulo)[] TiposPiscina =
    {
        ("adulto", "Adulto"),
        ("infantil", "Infantil"),
        ("espelho", "Espelho d'água")
    };

    private void AlternarTipoCliente(string tipo, ChangeEventArgs e)
    {
        var lista = Item.TiposClienteList;
        if (e.Value is true)
        {
            if (!lista.Contains(tipo)) lista.Add(tipo);
        }
        else
        {
            lista.Remove(tipo);
        }
        Item.TiposClienteList = lista;
    }

    private void AlternarTipoPiscina(string valor, ChangeEventArgs e)
    {
        var lista = Item.TiposPiscinaList;
        if (e.Value is true)
        {
            if (!lista.Contains(valor)) lista.Add(valor);
        }
        else
        {
            lista.Remove(valor);
        }
        Item.TiposPiscinaList = lista;
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Item);
        await Close();
    }
}
