@using System.Globalization

<div>
    <div class="flex items-center justify-between mb-2">
        <label class="text-sm font-medium text-slate-300">@Label</label>
        @if (!string.IsNullOrEmpty(Info))
        {
            <span class="text-xs text-slate-400">@Info</span>
        }
    </div>

    <div class="bg-slate-700 border border-slate-600 rounded-lg px-4 py-3">
        <div class="flex items-center gap-3">
            <input type="number"
                   inputmode="decimal"
                   step="@Step.ToString(CultureInfo.InvariantCulture)"
                   min="@Min.ToString(CultureInfo.InvariantCulture)"
                   max="@Max.ToString(CultureInfo.InvariantCulture)"
                   value="@Value.ToString(CultureInfo.InvariantCulture)"
                   @onchange="OnAlterado"
                   class="campo-numerico-input w-20 shrink-0 appearance-none text-center text-base font-semibold bg-slate-800 border border-slate-600 rounded-md py-1.5 text-slate-100 focus:outline-none focus:border-cyan-500" />
            @if (!string.IsNullOrEmpty(Unidade))
            {
                <span class="text-sm text-slate-400 shrink-0">@Unidade</span>
            }
            <input type="range"
                   min="@Min.ToString(CultureInfo.InvariantCulture)"
                   max="@Max.ToString(CultureInfo.InvariantCulture)"
                   step="@Step.ToString(CultureInfo.InvariantCulture)"
                   value="@Value.ToString(CultureInfo.InvariantCulture)"
                   @oninput="OnAlterado"
                   class="campo-numerico-slider flex-1" />
        </div>
        <div class="flex justify-between text-[11px] text-slate-500 mt-1">
            <span>@Min.ToString("0.##", CultureInfo.InvariantCulture)</span>
            <span>@Max.ToString("0.##", CultureInfo.InvariantCulture)</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public decimal Value { get; set; }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public decimal Step { get; set; } = 0.1m;
    [Parameter] public decimal Min { get; set; } = 0m;
    [Parameter] public decimal Max { get; set; } = 100m;
    [Parameter] public string? Unidade { get; set; }
    [Parameter] public string? Info { get; set; }

    private Task OnAlterado(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var novoValor))
        {
            return Task.CompletedTask;
        }

        if (novoValor < Min)
        {
            novoValor = Min;
        }
        else if (novoValor > Max)
        {
            novoValor = Max;
        }

        Value = Math.Round(novoValor, 2);
        return ValueChanged.InvokeAsync(Value);
    }
}
