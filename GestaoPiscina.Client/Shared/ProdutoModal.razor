@using GestaoPiscina.Client.Models

<div class="fixed inset-0 !mt-0 bg-black bg-opacity-50 flex sm:items-start justify-center z-50 sm:pt-8 @(IsVisible ? "" : "hidden")">
    <div class="bg-slate-800 w-full h-full sm:h-auto sm:rounded-xl sm:max-w-md sm:mx-4 sm:max-h-[90vh] flex flex-col">
        <div class="flex justify-between items-center p-6 pb-4 shrink-0">
            <h3 class="text-lg font-semibold text-slate-100">
                @(Produto.IDProduto > 0 ? "Editar Produto" : "Novo Produto")
            </h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="border-t border-slate-700"></div>

        <EditForm Model="Produto" OnValidSubmit="HandleSubmit" class="flex flex-col flex-1 min-h-0">
            <DataAnnotationsValidator />

            <div class="flex-1 overflow-y-auto px-6 pb-4 space-y-4 scroll-tema">
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Nome *</label>
                    <InputText @bind-Value="Produto.Nome" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Ex: Hipoclorito de Sódio 10-12%" />
                    <ValidationMessage For="@(() => Produto.Nome)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Unidade *</label>
                    <InputText @bind-Value="Produto.Unidade" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Ex: kg, L" />
                    <ValidationMessage For="@(() => Produto.Unidade)" class="text-red-500 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2">Concentração / Teor (%)</label>
                    <InputNumber @bind-Value="Produto.Concentracao" class="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-slate-100" placeholder="Opcional" />
                    <ValidationMessage For="@(() => Produto.Concentracao)" class="text-red-500 text-sm" />
                </div>
            </div>

            <div class="flex space-x-3 p-6 pt-4 border-t border-slate-700 shrink-0">
                <button type="submit" class="flex-1 bg-cyan-600 hover:bg-cyan-500 px-4 py-2 rounded-lg text-white transition-colors">
                    <i class="fas fa-save mr-2"></i>Salvar
                </button>
                <button type="button" @onclick="Close" class="flex-1 bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded-lg text-white transition-colors">
                    Cancelar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Produto Produto { get; set; } = new Produto();
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback<Produto> OnSave { get; set; }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(Produto);
        await Close();
    }
}
