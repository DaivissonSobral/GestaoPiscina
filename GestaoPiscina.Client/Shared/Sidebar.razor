@implements IDisposable
@inject NavigationManager NavigationManager

@if (MainLayout?.MobileMenuOpen == true)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 z-30 md:hidden" @onclick="() => MainLayout.CloseMobileMenu()"></div>
}

<aside class="w-64 shrink-0 bg-slate-900 p-6 flex-col min-h-screen border-r border-slate-800 fixed md:static inset-y-0 left-0 z-40 overflow-y-auto md:flex @(MainLayout?.MobileMenuOpen == true ? "flex" : "hidden") @(Collapsed ? "md:w-20 md:p-3" : "")">
    <div class="flex items-center justify-center mb-10 @(Collapsed ? "md:hidden" : "")">
        <img src="images/logo-fort-piscina.png" alt="Fort Piscina" class="max-w-full h-auto" />
    </div>
    <nav class="flex flex-col gap-1">
        @foreach (var item in menuItems.Where(i => !i.Hidden))
        {
            <div @onclick="() => MainLayout?.CloseMobileMenu()">
                @if (item.RequiredPermission == null)
                {
                    @RenderLink(item)
                }
                else
                {
                    <AuthorizeView Permission="@item.RequiredPermission" NotAuthorized="">
                        @RenderLink(item)
                    </AuthorizeView>
                }
            </div>
        }

        <div>
            <button type="button" @onclick="ToggleConfiguracoes" title="@grupoConfiguracoes.Label" class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-700 hover:text-white transition-colors duration-150 font-medium text-base @(Collapsed ? "md:justify-center" : "")">
                <span class="flex items-center">
                    <i class="fas @grupoConfiguracoes.Icon text-lg @(Collapsed ? "md:mr-0" : "mr-2")"></i><span class="@(Collapsed ? "md:hidden" : "")">@grupoConfiguracoes.Label</span>
                </span>
                <i class="fas @(configuracoesExpandido ? "fa-chevron-up" : "fa-chevron-down") text-sm text-slate-500 @(Collapsed ? "md:hidden" : "")"></i>
            </button>

            @if (configuracoesExpandido)
            {
                <div class="flex flex-col gap-1 mt-1 ml-4 pl-3 border-l border-slate-700 @(Collapsed ? "md:ml-0 md:pl-0 md:border-l-0" : "")">
                    @foreach (var item in grupoConfiguracoes.Itens)
                    {
                        <div @onclick="() => MainLayout?.CloseMobileMenu()">
                            @if (item.RequiredPermission == null)
                            {
                                @RenderLink(item)
                            }
                            else
                            {
                                <AuthorizeView Permission="@item.RequiredPermission" NotAuthorized="">
                                    @RenderLink(item)
                                </AuthorizeView>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </nav>
</aside>

@code {
    [CascadingParameter] public MainLayout? MainLayout { get; set; }

    private record MenuItem(string Href, string Icon, string Label, string? RequiredPermission = null, bool Hidden = false);
    private record GrupoMenu(string Icon, string Label, List<MenuItem> Itens);

    private List<MenuItem> menuItems = new()
    {
        new("/","fa-tachometer-alt","Início"),
        new("ordens-servico","fa-tasks","Ordens de Serviço"),
        new("rotas","fa-route","Gestão de Rota"),
        new("clientes","fa-user-friends","Clientes"),
        new("piscinas","fa-swimming-pool","Piscinas"),
        new("equipamentos","fa-robot","Equipamentos"),
        new("produtos","fa-box","Produtos"),
        new("estoque","fa-warehouse","Estoque"),
        new("relatorios","fa-chart-line","Relatórios"),
        new("reagendamentos","fa-calendar-alt","Reagendamentos", Hidden: true),
        new("supervisao","fa-star","Supervisão", Hidden: true),
    };

    // Checklist, Gestores e Usuários vivem dentro do grupo Configurações, como um treeview —
    // em vez de itens soltos no nível principal do menu.
    private readonly GrupoMenu grupoConfiguracoes = new("fa-cogs", "Configurações", new List<MenuItem>
    {
        new("configuracoes","fa-sliders-h","Geral"),
        new("checklist-itens","fa-clipboard-check","Checklist"),
        new("gestores","fa-user-tie","Gestores"),
        new("usuarios","fa-users-cog","Usuários","PodeGerenciarUsuarios"),
    });

    private bool configuracoesExpandido;

    // No computador, o botão da barra superior alterna esse estado (ver MainLayout.ToggleSidebar)
    // pra encolher a barra e mostrar só os ícones, em vez do rótulo escrito ao lado — no
    // celular esse mesmo clique faz outra coisa (abre/fecha a faixa cheia), então tudo aqui
    // usa classes com prefixo "md:" pra só valer no computador.
    private bool Collapsed => MainLayout?.DesktopSidebarCollapsed == true;

    protected override void OnInitialized()
    {
        AtualizarExpansaoConfiguracoes();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        AtualizarExpansaoConfiguracoes();
        InvokeAsync(StateHasChanged);
    }

    // Abre o grupo automaticamente quando a navegação (ex.: um link direto, ou "Voltar"
    // do navegador) cai numa das páginas filhas — sem isso o usuário podia ficar numa
    // tela de Configurações com o próprio item do menu escondido dentro do grupo fechado.
    private void AtualizarExpansaoConfiguracoes()
    {
        var caminhoAtual = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/');
        if (grupoConfiguracoes.Itens.Any(i => caminhoAtual.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase)))
        {
            configuracoesExpandido = true;
        }
    }

    private void ToggleConfiguracoes() => configuracoesExpandido = !configuracoesExpandido;

    private RenderFragment RenderLink(MenuItem item) => @<NavLink href="@item.Href" title="@item.Label" class="@($"flex items-center px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-700 hover:text-white transition-colors duration-150 font-medium text-base{(Collapsed ? " md:justify-center" : "")}")"
                ActiveClass="bg-cyan-600 text-white font-semibold shadow-lg"
                Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
        <i class="fas @item.Icon text-lg @(Collapsed ? "md:mr-0" : "mr-2")"></i><span class="@(Collapsed ? "md:hidden" : "")">@item.Label</span>
    </NavLink>;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
