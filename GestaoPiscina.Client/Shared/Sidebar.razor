@if (MainLayout?.MobileMenuOpen == true)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 z-30 md:hidden" @onclick="() => MainLayout.CloseMobileMenu()"></div>
}

<aside class="w-64 bg-slate-900 p-6 flex-col min-h-screen border-r border-slate-800 fixed md:static inset-y-0 left-0 z-40 overflow-y-auto md:flex @(MainLayout?.MobileMenuOpen == true ? "flex" : "hidden")">
    <div class="flex items-center justify-center mb-10">
        <img src="images/logo-fort-piscina.png" alt="Fort Piscina" class="max-w-full h-auto" />
    </div>
    <nav class="flex flex-col gap-1" @onclick="() => MainLayout?.CloseMobileMenu()">
        @foreach (var item in menuItems.Where(i => !i.Hidden))
        {
            @if (item.RequiredPermission == null)
            {
                @RenderLink(item)
            }
            else
            {
                <AuthorizeView Permission="@item.RequiredPermission" NotAuthorized="">
                    @RenderLink(item)
                </AuthorizeView>
            }
        }
    </nav>
</aside>

@code {
    [CascadingParameter] public MainLayout? MainLayout { get; set; }

    private record MenuItem(string Href, string Icon, string Label, string? RequiredPermission = null, bool Hidden = false);

    private List<MenuItem> menuItems = new()
    {
        new("/","fa-tachometer-alt","Dashboard"),
        new("clientes","fa-user-friends","Clientes"),
        new("piscinas","fa-swimming-pool","Piscinas"),
        new("produtos","fa-box","Produtos"),
        new("equipamentos","fa-robot","Equipamentos"),
        new("gestores","fa-user-tie","Gestores"),
        new("ordens-servico","fa-tasks","Ordens de Serviço"),
        new("rotas","fa-route","Gestão de Rota"),
        new("reagendamentos","fa-calendar-alt","Reagendamentos", Hidden: true),
        new("relatorios","fa-chart-line","Relatórios"),
        new("supervisao","fa-star","Supervisão", Hidden: true),
        new("estoque","fa-warehouse","Estoque"),
        new("usuarios","fa-users-cog","Usuários","PodeGerenciarUsuarios"),
        new("configuracoes","fa-cogs","Configurações"),
    };

    private RenderFragment RenderLink(MenuItem item) => @<NavLink href="@item.Href" class="flex items-center px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-700 hover:text-white transition-colors duration-150 font-medium text-base"
                ActiveClass="bg-cyan-600 text-white font-semibold shadow-lg"
                Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
        <i class="fas @item.Icon text-lg mr-2"></i><span>@item.Label</span>
    </NavLink>;
}
